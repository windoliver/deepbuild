{
  "format": 1,
  "profile": "scene",
  "title": "Quarterly totals, export",
  "description": "The export budget class's perf-lane fixture: four quarterly bars, Q3 at 44, with Q1 easing forward so every frame draws.",
  "size": [
    1280,
    720
  ],
  "camera": "cam",
  "requires": {
    "modules": {
      "scene3d": "^1"
    }
  },
  "budget": {
    "class": "export"
  },
  "transport": {
    "span": "60s"
  },
  "items": {
    "cam": {
      "id": "cam",
      "kind": "camera@1",
      "name": "Camera",
      "order": "a0",
      "params": {
        "projection": "perspective",
        "target": [
          0,
          2.5,
          0
        ],
        "orbit": {
          "azimuth": 20,
          "elevation": 15,
          "distance": 14
        },
        "fov": 40
      }
    },
    "q1": {
      "id": "q1",
      "kind": "mark.box@1",
      "name": "Q1 bar",
      "order": "b0",
      "params": {
        "size": [
          1,
          3.2,
          1
        ],
        "paint": {
          "fill": {
            "role": "accent"
          }
        }
      },
      "at": {
        "pos": [
          -2.25,
          1.6,
          0
        ]
      }
    },
    "q2": {
      "id": "q2",
      "kind": "mark.box@1",
      "name": "Q2 bar",
      "order": "b1",
      "params": {
        "size": [
          1,
          4,
          1
        ],
        "paint": {
          "fill": {
            "role": "accent"
          }
        }
      },
      "at": {
        "pos": [
          -0.75,
          2,
          0
        ]
      }
    },
    "q3": {
      "id": "q3",
      "kind": "mark.box@1",
      "name": "Q3 bar",
      "order": "b2",
      "params": {
        "size": [
          1,
          4.4,
          1
        ],
        "paint": {
          "fill": {
            "role": "accent"
          }
        }
      },
      "at": {
        "pos": [
          0.75,
          2.2,
          0
        ]
      }
    },
    "q4": {
      "id": "q4",
      "kind": "mark.box@1",
      "name": "Q4 bar",
      "order": "b3",
      "params": {
        "size": [
          1,
          5.1,
          1
        ],
        "paint": {
          "fill": {
            "role": "accent"
          }
        }
      },
      "at": {
        "pos": [
          2.25,
          2.55,
          0
        ]
      }
    }
  },
  "channels": {
    "ease": {
      "target": "items/q1/at/pos/2",
      "type": "f32",
      "keys": {
        "k0": {
          "t": "0s",
          "value": 0,
          "interp": "linear"
        },
        "k1": {
          "t": "60s",
          "value": 2,
          "interp": "linear"
        }
      }
    }
  }
}
