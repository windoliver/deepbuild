#!/bin/sh
# Issue #883: builds deep-app and wraps it in target/DeepBuild.app, since macOS shows an app's notifications only from
# a bundle with an identifier. It signs with the identity DEEP_APP_SIGN names, else ad hoc; an ad-hoc signature
# changes with each build, so macOS asks again whether the app may notify. Prints the bundle's path.
# Issue #1349: `scripts/app-bundle <runtime folder>` also ships that folder (node scripts/app-runtime.mjs) as
# Contents/Resources/runtime, each program in it signed before the app, so the app carries everything a workspace needs.
set -eu
root=$(cd "$(dirname "$0")/.." && pwd)
runtime=${1:-}
cargo build --quiet --manifest-path "$root/Cargo.toml" -p deep-app --bin deep-app
app="$root/target/DeepBuild.app"
rm -rf "$app"
mkdir -p "$app/Contents/MacOS"
cp "$root/target/debug/deep-app" "$app/Contents/MacOS/deep-app"
cat >"$app/Contents/Info.plist" <<'PLIST'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleIdentifier</key><string>dev.deepbuild.DeepBuild</string>
  <key>CFBundleName</key><string>DeepBuild</string>
  <key>CFBundleExecutable</key><string>deep-app</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>0.0.0</string>
  <key>NSHighResolutionCapable</key><true/>
  <key>CFBundleURLTypes</key><array><dict>
    <key>CFBundleURLName</key><string>dev.deepbuild.DeepBuild</string>
    <key>CFBundleURLSchemes</key><array><string>deepbuild</string></array>
  </dict></array>
</dict>
</plist>
PLIST
if [ -n "$runtime" ]; then
  [ -x "$runtime/bin/deep" ] || { echo "app-bundle: $runtime is no runtime folder: it has no bin/deep; run node scripts/app-runtime.mjs" >&2; exit 1; }
  mkdir -p "$app/Contents/Resources"
  cp -R "$runtime" "$app/Contents/Resources/runtime"
  # Inside out: each program in the runtime, then the app; a link is signed through what it names.
  find "$app/Contents/Resources/runtime" -type f -perm +111 -print | while read -r file; do
    if [ "$(head -c 4 "$file" | od -An -tx1 | tr -d ' \n')" = "cffaedfe" ]; then
      codesign --force --timestamp=none --sign "${DEEP_APP_SIGN:--}" "$file" >/dev/null
    fi
  done
  find "$app/Contents/Resources/runtime" -type f -name '*.node' -exec codesign --force --timestamp=none --sign "${DEEP_APP_SIGN:--}" {} \; >/dev/null
fi
codesign --force --timestamp=none --sign "${DEEP_APP_SIGN:--}" "$app"
echo "$app"
