#!/bin/sh
# Issue #883: builds deep-app and wraps it in target/DeepBuild.app, since macOS shows an app's notifications only from
# a bundle with an identifier. It signs with the identity DEEP_APP_SIGN names, else ad hoc; an ad-hoc signature
# changes with each build, so macOS asks again whether the app may notify. Prints the bundle's path.
set -eu
root=$(cd "$(dirname "$0")/.." && pwd)
cargo build --quiet --manifest-path "$root/Cargo.toml" -p deep-app --bin deep-app
app="$root/target/DeepBuild.app"
rm -rf "$app"
mkdir -p "$app/Contents/MacOS"
cp "$root/target/debug/deep-app" "$app/Contents/MacOS/deep-app"
cat >"$app/Contents/Info.plist" <<'PLIST'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleIdentifier</key><string>dev.deepbuild.DeepBuild</string>
  <key>CFBundleName</key><string>DeepBuild</string>
  <key>CFBundleExecutable</key><string>deep-app</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>0.0.0</string>
  <key>NSHighResolutionCapable</key><true/>
</dict>
</plist>
PLIST
codesign --force --timestamp=none --sign "${DEEP_APP_SIGN:--}" "$app"
echo "$app"
