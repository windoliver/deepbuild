(module
  (memory (export "memory") 1 1)
  (global (export "reads_at") i32 (i32.const 0))
  (global (export "writes_at") i32 (i32.const 1024))
  (func $put (param $cell i32) (param $value i32)
    (i32.store (i32.add (i32.const 1024) (i32.shl (local.get $cell) (i32.const 2))) (local.get $value)))
  (func (export "init") (param i64)
    (call $put (i32.const 5) (i32.const 2))
    (call $put (i32.const 6) (i32.const 1))
    (call $put (i32.const 7) (i32.const 1))
    (call $put (i32.const 8) (i32.const 1))
    (call $put (i32.const 9) (i32.const 4))
    (call $put (i32.const 11) (i32.const 1))
    (call $put (i32.const 12) (i32.const 1))
    (call $put (i32.const 13) (i32.const 1))
    (call $put (i32.const 16) (i32.const 1))
    (call $put (i32.const 17) (i32.const 1))
    (call $put (i32.const 18) (i32.const 1))
    (call $put (i32.const 22) (i32.const 5)))
  (func (export "step") (param i64)))
