<?xml version="1.0"?>
<!-- Issue #3035, criterion 4: a gripper with a mimic joint, a transmission and a sensor, beside a revolute, a continuous and a fixed joint that are kept. -->
<robot name="gripper">
  <link name="palm">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1"/>
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.002"/>
    </inertial>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.1 0.1 0.04"/>
      </geometry>
    </collision>
  </link>
  <link name="finger_a">
    <inertial>
      <origin xyz="0.05 0 0" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/>
    </inertial>
    <collision>
      <origin xyz="0.05 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.1 0.02 0.02"/>
      </geometry>
    </collision>
  </link>
  <link name="finger_b">
    <inertial>
      <origin xyz="0.05 0 0" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/>
    </inertial>
    <collision>
      <origin xyz="0.05 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.1 0.02 0.02"/>
      </geometry>
    </collision>
  </link>
  <link name="knob">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00002"/>
    </inertial>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.02"/>
      </geometry>
    </collision>
  </link>
  <link name="pad">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.01"/>
      </geometry>
    </collision>
  </link>
  <joint name="pinch" type="revolute">
    <parent link="palm"/>
    <child link="finger_a"/>
    <origin xyz="0.05 0.03 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.5" upper="0.5" effort="5" velocity="1"/>
  </joint>
  <joint name="mirror" type="revolute">
    <parent link="palm"/>
    <child link="finger_b"/>
    <origin xyz="0.05 -0.03 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.5" upper="0.5" effort="5" velocity="1"/>
    <mimic joint="pinch" multiplier="-1" offset="0"/>
  </joint>
  <joint name="spin" type="continuous">
    <parent link="palm"/>
    <child link="knob"/>
    <origin xyz="-0.08 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>
  <joint name="glue" type="fixed">
    <parent link="finger_a"/>
    <child link="pad"/>
    <origin xyz="0.11 0 0" rpy="0 0 0"/>
  </joint>
  <transmission name="squeeze">
    <type>simple</type>
    <joint name="pinch"/>
    <actuator name="squeeze_motor">
      <mechanicalReduction>50</mechanicalReduction>
    </actuator>
  </transmission>
  <sensor name="eye" update_rate="30">
    <parent link="palm"/>
    <origin xyz="0 0 0.03" rpy="0 0 0"/>
    <camera>
      <image width="640" height="480" hfov="1.2" format="RGB8" near="0.01" far="10"/>
    </camera>
  </sensor>
</robot>
