{
  "title": "doc.patched@1",
  "description": "A document was patched, by its writer.",
  "x-feeds": [
    "documents",
    "returns"
  ],
  "type": "object",
  "properties": {
    "v": {
      "const": 1,
      "description": "The kind's schema version."
    },
    "id": {
      "type": "string",
      "format": "ulid",
      "description": "The event's ULID, its identity."
    },
    "kind": {
      "const": "doc.patched"
    },
    "subject": {
      "type": "string",
      "pattern": "^(task|ask|claim|verdict|run|req|decision|plan|lease|reading|notice|doc|ev|session):[0-9A-Za-z]+(#[A-Za-z0-9][A-Za-z0-9._-]*)?$",
      "description": "The record object this event is about."
    },
    "writer": {
      "type": "string",
      "pattern": "^(hook|app|cli|core|mcp:[^\\s]+|ext:[^\\s]+)$",
      "description": "Who wrote it, from the connection, never the payload."
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "description": "The person behind it, from the credential."
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "description": "Who may see it."
    },
    "ts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Milliseconds since the Unix epoch."
    },
    "seq": {
      "type": "string",
      "format": "seq",
      "description": "Order within the session: ns since the epoch when the hook started."
    },
    "log_pos": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Its position in the event log, assigned by the hub at append."
    },
    "data": {
      "type": "object",
      "properties": {
        "doc": {
          "type": "string",
          "pattern": "^doc:[0-9A-Za-z]+$",
          "description": "A doc: handle.",
          "maxLength": 8192
        },
        "rev": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "patch": {
          "type": "string",
          "format": "ulid"
        },
        "writer": {
          "type": "string",
          "pattern": "^(hook|app|cli|core|mcp:[^\\s]+|ext:[^\\s]+)$",
          "description": "Who wrote it, from the connection, as the envelope writes a writer.",
          "maxLength": 8192
        },
        "achieved": {
          "type": "object",
          "properties": {
            "created": {
              "type": "object",
              "propertyNames": {
                "pattern": "^[a-z0-9_-]+(\\.[a-z0-9_-]+)*@[1-9][0-9]*$"
              },
              "additionalProperties": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "updated": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "deleted": {
              "type": "object",
              "propertyNames": {
                "pattern": "^[a-z0-9_-]+(\\.[a-z0-9_-]+)*@[1-9][0-9]*$"
              },
              "additionalProperties": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "unchanged": {
              "type": "boolean"
            }
          },
          "required": [
            "created",
            "updated",
            "deleted",
            "unchanged"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "doc",
        "rev",
        "patch",
        "writer",
        "achieved"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$",
        "description": "A SHA-256, in lower-case hex."
      }
    }
  },
  "required": [
    "v",
    "id",
    "kind",
    "writer",
    "actor",
    "scope",
    "ts",
    "data"
  ],
  "additionalProperties": false
}
