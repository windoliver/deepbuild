{
  "title": "check.held@1",
  "description": "A slow check took its held place at a looping session's stop (#45).",
  "x-since": "R1",
  "x-stability": "stable",
  "x-feeds": [],
  "type": "object",
  "properties": {
    "v": {
      "const": 1,
      "description": "The kind's schema version."
    },
    "id": {
      "type": "string",
      "format": "ulid",
      "description": "The event's ULID, its identity."
    },
    "kind": {
      "const": "check.held"
    },
    "subject": {
      "type": "string",
      "pattern": "^(task|ask|claim|verdict|run|req|decision|plan|lease|reading|notice|doc|ev|session):[0-9A-Za-z]+(#[A-Za-z0-9][A-Za-z0-9._-]*)?$",
      "description": "The record object this event is about."
    },
    "writer": {
      "const": "core",
      "description": "Only the core appends this kind."
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "description": "The person behind it, from the credential."
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "description": "Who may see it."
    },
    "ts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Milliseconds since the Unix epoch."
    },
    "seq": {
      "type": "string",
      "format": "seq",
      "description": "Order within the session: ns since the epoch when the hook started."
    },
    "log_pos": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Its position in the event log, assigned by the hub at append."
    },
    "data": {
      "type": "object",
      "properties": {
        "session": {
          "type": "string",
          "pattern": "^session:[0-9A-Za-z]+$",
          "maxLength": 8192,
          "description": "The session it belongs to."
        },
        "check": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "description": "The check, by name."
        },
        "claim": {
          "type": "string",
          "pattern": "^claim:[0-9A-Za-z]+$",
          "maxLength": 8192,
          "description": "The claim whose snapshot holds the place."
        },
        "replaced": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^claim:[0-9A-Za-z]+$",
          "maxLength": 8192,
          "description": "The claim whose place it took, or null for the first."
        }
      },
      "required": [
        "session",
        "check",
        "claim",
        "replaced"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$",
        "description": "A SHA-256, in lower-case hex."
      }
    }
  },
  "required": [
    "v",
    "id",
    "kind",
    "writer",
    "actor",
    "scope",
    "ts",
    "data"
  ],
  "additionalProperties": false
}
