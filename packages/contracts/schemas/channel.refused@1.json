{
  "title": "channel.refused@1",
  "description": "The hub refused an answer a channel returned: its proof failed, or what it answers needs the trusted path. It names the field that failed, or null, and why, naming the device or the account at fault; the answer counts for nothing. Only the core appends it (#65).",
  "x-since": "R2",
  "x-stability": "preview",
  "x-tracking": "#65",
  "x-preview_since": "R2",
  "x-decide_by": "R5",
  "x-feeds": [],
  "type": "object",
  "properties": {
    "v": {
      "const": 1,
      "description": "The kind's schema version."
    },
    "id": {
      "type": "string",
      "format": "ulid",
      "description": "The event's ULID, its identity."
    },
    "kind": {
      "const": "channel.refused"
    },
    "subject": {
      "type": "string",
      "pattern": "^ask:[0-9A-Za-z]+$",
      "description": "The ask whose thread the answer came on, when its thread key names one."
    },
    "writer": {
      "const": "core",
      "description": "Only the core appends this kind."
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "description": "The person behind it, from the credential."
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "description": "Who may see it."
    },
    "ts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Milliseconds since the Unix epoch."
    },
    "seq": {
      "type": "string",
      "format": "seq",
      "description": "Order within the session: ns since the epoch when the hook started."
    },
    "log_pos": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Its position in the event log, assigned by the hub at append."
    },
    "data": {
      "type": "object",
      "properties": {
        "channel": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$",
          "description": "The channel's name, as its plug-in registered it.",
          "maxLength": 8192
        },
        "thread_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "description": "The thread key: the item's handle, one thread per item on every channel."
        },
        "answer": {
          "type": "string",
          "minLength": 0,
          "maxLength": 8192,
          "description": "The answer the channel returned."
        },
        "field": {
          "type": "string",
          "enum": [
            "device",
            "ask",
            "revision",
            "card_hash",
            "plan_hash",
            "hub",
            "at",
            "signature",
            "answer",
            "account_link_id",
            "method",
            "once",
            "params"
          ],
          "description": "The field of the proof that failed; left out when the answer carried no proof, or needs the trusted path.",
          "x-closure": {
            "closed": "each value is a state the record defines and every reader acts on, so a value outside the list has no meaning",
            "reopens": "a new major of this schema",
            "mark": "exhaustive"
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "description": "Why it was refused."
        }
      },
      "required": [
        "channel",
        "thread_key",
        "answer",
        "reason"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$",
        "description": "A SHA-256, in lower-case hex."
      }
    }
  },
  "required": [
    "v",
    "id",
    "kind",
    "writer",
    "actor",
    "scope",
    "ts",
    "data"
  ],
  "additionalProperties": false
}
