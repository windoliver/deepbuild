{
  "title": "commit.made@1",
  "description": "A commit made in a session, read from its worktree at the session's hooks; DeepBuild adds nothing to it.",
  "x-since": "R1",
  "x-stability": "stable",
  "x-feeds": [
    "commits"
  ],
  "type": "object",
  "properties": {
    "v": {
      "const": 1,
      "description": "The kind's schema version."
    },
    "id": {
      "type": "string",
      "format": "ulid",
      "description": "The event's ULID, its identity."
    },
    "kind": {
      "const": "commit.made"
    },
    "subject": {
      "type": "string",
      "pattern": "^session:[0-9A-Za-z]+$",
      "description": "The session that made it."
    },
    "writer": {
      "const": "core",
      "description": "Only the core appends this kind."
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "description": "The person behind it, from the credential."
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "description": "Who may see it."
    },
    "ts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Milliseconds since the Unix epoch."
    },
    "seq": {
      "type": "string",
      "format": "seq",
      "description": "Order within the session: ns since the epoch when the hook started."
    },
    "log_pos": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Its position in the event log, assigned by the hub at append."
    },
    "data": {
      "type": "object",
      "properties": {
        "sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$",
          "description": "The commit's full SHA.",
          "maxLength": 8192
        },
        "worktree": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "description": "The worktree it was made in."
        },
        "branch": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 8192,
          "description": "The branch it was made on; null on a detached head."
        }
      },
      "required": [
        "sha",
        "worktree",
        "branch"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$",
        "description": "A SHA-256, in lower-case hex."
      }
    }
  },
  "required": [
    "v",
    "id",
    "kind",
    "subject",
    "writer",
    "actor",
    "scope",
    "ts",
    "data"
  ],
  "additionalProperties": false
}
