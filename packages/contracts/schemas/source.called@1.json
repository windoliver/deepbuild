{
  "title": "source.called@1",
  "description": "The hub called a polled source's host (#364): the call's cost, its time and the bytes of its answer, and how it ended. Never the call's URL, headers or values, so no secret reaches the record.",
  "x-since": "R1",
  "x-stability": "stable",
  "x-feeds": [],
  "type": "object",
  "properties": {
    "v": {
      "const": 1,
      "description": "The kind's schema version."
    },
    "id": {
      "type": "string",
      "format": "ulid",
      "description": "The event's ULID, its identity."
    },
    "kind": {
      "const": "source.called"
    },
    "subject": {
      "type": "string",
      "pattern": "^(task|ask|claim|verdict|run|req|decision|plan|lease|reading|notice|doc|ev|session):[0-9A-Za-z]+(#[A-Za-z0-9][A-Za-z0-9._-]*)?$",
      "description": "The record object this event is about."
    },
    "writer": {
      "const": "core",
      "description": "Only the core appends this kind: the hub makes every source call."
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "description": "The person behind it, from the credential."
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "description": "Who may see it."
    },
    "ts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Milliseconds since the Unix epoch."
    },
    "seq": {
      "type": "string",
      "format": "seq",
      "description": "Order within the session: ns since the epoch when the hook started."
    },
    "log_pos": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Its position in the event log, assigned by the hub at append."
    },
    "data": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "pattern": "^ext\\.[a-z0-9][a-z0-9_-]*\\.[a-z][a-z0-9_]*$",
          "maxLength": 8192,
          "description": "The source called, ext.<plugin>.<name>."
        },
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "description": "The host called: the source's own, which its grant names."
        },
        "outcome": {
          "type": "string",
          "enum": [
            "answered",
            "timeout",
            "unreachable"
          ],
          "description": "How the call ended.",
          "x-closure": {
            "closed": "a call is answered, runs past its timeout, or reaches no host",
            "reopens": "a new major of this kind",
            "mark": "exhaustive"
          }
        },
        "status": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599,
          "description": "The answer's HTTP status, when it was answered."
        },
        "ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "How long the call took, in ms."
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "The answer's body, in bytes; 0 when none came."
        }
      },
      "required": [
        "source",
        "host",
        "outcome",
        "ms",
        "bytes"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$",
        "description": "A SHA-256, in lower-case hex."
      }
    }
  },
  "required": [
    "v",
    "id",
    "kind",
    "writer",
    "actor",
    "scope",
    "ts",
    "data"
  ],
  "additionalProperties": false
}
