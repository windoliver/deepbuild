{
  "title": "spend.charged@1",
  "description": "A paid run's cost reading landed: the run is charged against every budget it reserved against, and its reservation released. Only the core appends it.",
  "x-feeds": [],
  "type": "object",
  "properties": {
    "v": {
      "const": 1,
      "description": "The kind's schema version."
    },
    "id": {
      "type": "string",
      "format": "ulid",
      "description": "The event's ULID, its identity."
    },
    "kind": {
      "const": "spend.charged"
    },
    "subject": {
      "type": "string",
      "pattern": "^run:[0-9A-Za-z]+$",
      "description": "The paid run this event is about.",
      "maxLength": 8192
    },
    "writer": {
      "const": "core",
      "description": "Only the core appends this kind."
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "description": "The person behind it, from the credential."
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "description": "Who may see it."
    },
    "ts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Milliseconds since the Unix epoch."
    },
    "seq": {
      "type": "string",
      "format": "seq",
      "description": "Order within the session: ns since the epoch when the hook started."
    },
    "log_pos": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Its position in the event log, assigned by the hub at append."
    },
    "data": {
      "type": "object",
      "properties": {
        "run": {
          "type": "string",
          "pattern": "^run:[0-9A-Za-z]+$",
          "description": "The paid run.",
          "maxLength": 8192
        },
        "usd": {
          "type": "number",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "What the run cost, in US dollars."
        }
      },
      "required": [
        "run",
        "usd"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$",
        "description": "A SHA-256, in lower-case hex."
      }
    }
  },
  "required": [
    "v",
    "id",
    "kind",
    "subject",
    "writer",
    "actor",
    "scope",
    "ts",
    "data"
  ],
  "additionalProperties": false
}
