{
  "title": "doc.patched@2",
  "description": "A document was patched, by its writer. @2 adds the revision's hash and the writer layer it went into (#806).",
  "x-since": "R1",
  "x-stability": "stable",
  "x-feeds": [
    "documents",
    "returns"
  ],
  "type": "object",
  "properties": {
    "v": {
      "const": 2,
      "description": "The kind's schema version."
    },
    "id": {
      "type": "string",
      "format": "ulid",
      "description": "The event's ULID, its identity."
    },
    "kind": {
      "const": "doc.patched"
    },
    "subject": {
      "type": "string",
      "pattern": "^(task|ask|claim|verdict|run|req|decision|plan|lease|reading|notice|doc|ev|session):[0-9A-Za-z]+(#[A-Za-z0-9][A-Za-z0-9._-]*)?$",
      "description": "The record object this event is about."
    },
    "writer": {
      "type": "string",
      "pattern": "^(hook|app|cli|core|mcp:[^\\s]+|ext:[^\\s]+)$",
      "description": "Who wrote it, from the connection, never the payload."
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "description": "The person behind it, from the credential."
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "description": "Who may see it."
    },
    "ts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Milliseconds since the Unix epoch."
    },
    "seq": {
      "type": "string",
      "format": "seq",
      "description": "Order within the session: ns since the epoch when the hook started."
    },
    "log_pos": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Its position in the event log, assigned by the hub at append."
    },
    "data": {
      "type": "object",
      "properties": {
        "doc": {
          "type": "string",
          "pattern": "^doc:[0-9A-Za-z]+$",
          "description": "A doc: handle.",
          "maxLength": 8192
        },
        "rev": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "patch": {
          "type": [
            "string",
            "null"
          ],
          "format": "ulid",
          "description": "The patch, or null for a whole revision deep_show sent.",
          "maxLength": 8192
        },
        "writer": {
          "type": "string",
          "enum": [
            "you",
            "shell",
            "record",
            "agent",
            "plugin"
          ],
          "description": "The canvas writer's kind: you, shell, record, agent or plugin.",
          "x-closure": {
            "closed": "each value is a state the record defines and every reader acts on, so a value outside the list has no meaning",
            "reopens": "a new major of this schema",
            "mark": "exhaustive"
          }
        },
        "achieved": {
          "type": "object",
          "properties": {
            "created": {
              "type": "object",
              "propertyNames": {
                "pattern": "^[a-z0-9_-]+(\\.[a-z0-9_-]+)*@[1-9][0-9]*$"
              },
              "additionalProperties": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "updated": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "deleted": {
              "type": "object",
              "propertyNames": {
                "pattern": "^[a-z0-9_-]+(\\.[a-z0-9_-]+)*@[1-9][0-9]*$"
              },
              "additionalProperties": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "unchanged": {
              "type": "boolean"
            }
          },
          "required": [
            "created",
            "updated",
            "deleted",
            "unchanged"
          ],
          "additionalProperties": false
        },
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "The SHA-256 of the revision's canonical document, kept in the evidence store under it.",
          "maxLength": 8192
        },
        "layer": {
          "type": "string",
          "pattern": "^[a-z]+-[0-9a-f]{12}$",
          "description": "The writer layer it went into, from the connection.",
          "maxLength": 8192
        },
        "thread": {
          "type": [
            "string",
            "null"
          ],
          "description": "An agent writer's thread, from the binding; null for you.",
          "maxLength": 8192
        }
      },
      "required": [
        "doc",
        "rev",
        "patch",
        "writer",
        "achieved",
        "hash",
        "layer",
        "thread"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$",
        "description": "A SHA-256, in lower-case hex."
      }
    }
  },
  "required": [
    "v",
    "id",
    "kind",
    "writer",
    "actor",
    "scope",
    "ts",
    "data"
  ],
  "additionalProperties": false
}
