{
  "title": "definition.stood_in@1",
  "description": "A requirement's check was proven on a stand-in, a program that does nothing standing in for a base with nothing to start: the surface it entered through and the stand-in's hash, kept as the requirement's stand_in. The definition's hash leaves it out. Only the core appends it.",
  "x-since": "R1",
  "x-stability": "stable",
  "x-feeds": [
    "definitions"
  ],
  "type": "object",
  "properties": {
    "v": {
      "const": 1,
      "description": "The kind's schema version."
    },
    "id": {
      "type": "string",
      "format": "ulid",
      "description": "The event's ULID, its identity."
    },
    "kind": {
      "const": "definition.stood_in"
    },
    "subject": {
      "type": "string",
      "pattern": "^(task|ask|claim|verdict|run|req|decision|plan|lease|reading|notice|doc|ev|session):[0-9A-Za-z]+(#[A-Za-z0-9][A-Za-z0-9._-]*)?$",
      "description": "The record object this event is about."
    },
    "writer": {
      "const": "core",
      "description": "Only the core appends this kind."
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "description": "The person behind it, from the credential."
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "description": "Who may see it."
    },
    "ts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Milliseconds since the Unix epoch."
    },
    "seq": {
      "type": "string",
      "format": "seq",
      "description": "Order within the session: ns since the epoch when the hook started."
    },
    "log_pos": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Its position in the event log, assigned by the hub at append."
    },
    "data": {
      "type": "object",
      "properties": {
        "definition": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "A SHA-256, in lower-case hex.",
          "maxLength": 8192
        },
        "task_ref": {
          "type": "string",
          "pattern": "^(task:[0-9A-Za-z]+|session:[0-9A-Za-z]+#[A-Za-z0-9][A-Za-z0-9._-]*)$",
          "description": "The task: a task handle, or the message that asked for it (session:<id>#<message>).",
          "maxLength": 8192
        },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^R[1-9][0-9]*$",
                "maxLength": 8192
              },
              "stand_in": {
                "type": "object",
                "description": "The stand-in its check was proven on.",
                "properties": {
                  "surface": {
                    "type": "object",
                    "description": "The surface the check entered through, as its requirement declares it.",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 8192,
                        "description": "service, page, command or module have a fixed form; any other kind goes to the early question."
                      },
                      "routes": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 8192
                        }
                      },
                      "format": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 8192
                      },
                      "name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 8192
                      },
                      "path": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 8192
                      },
                      "exports": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 8192
                        }
                      }
                    },
                    "required": [
                      "kind"
                    ],
                    "additionalProperties": false
                  },
                  "hash": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$",
                    "description": "The SHA-256 of the stand-in's fixed form, as the base-commit service built it.",
                    "maxLength": 8192
                  }
                },
                "required": [
                  "surface",
                  "hash"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "stand_in"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "definition",
        "task_ref",
        "requirements"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$",
        "description": "A SHA-256, in lower-case hex."
      }
    }
  },
  "required": [
    "v",
    "id",
    "kind",
    "writer",
    "actor",
    "scope",
    "ts",
    "data"
  ],
  "additionalProperties": false
}
