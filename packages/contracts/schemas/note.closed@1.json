{
  "title": "note.closed@1",
  "description": "A note was closed, by you or by a check; never by an agent or a plug-in.",
  "x-feeds": [
    "notes"
  ],
  "type": "object",
  "properties": {
    "v": {
      "const": 1,
      "description": "The kind's schema version."
    },
    "id": {
      "type": "string",
      "format": "ulid",
      "description": "The event's ULID, its identity."
    },
    "kind": {
      "const": "note.closed"
    },
    "subject": {
      "type": "string",
      "pattern": "^(task|ask|claim|verdict|run|req|decision|plan|lease|reading|notice|doc|ev|session):[0-9A-Za-z]+(#[A-Za-z0-9][A-Za-z0-9._-]*)?$",
      "description": "The record object this event is about."
    },
    "writer": {
      "type": "string",
      "enum": [
        "core",
        "app"
      ],
      "description": "Who wrote it, from the connection; only these writers append this kind."
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "description": "The person behind it, from the credential."
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "description": "Who may see it."
    },
    "ts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Milliseconds since the Unix epoch."
    },
    "seq": {
      "type": "string",
      "format": "seq",
      "description": "Order within the session: ns since the epoch when the hook started."
    },
    "log_pos": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Its position in the event log, assigned by the hub at append."
    },
    "data": {
      "type": "object",
      "properties": {
        "note": {
          "type": "string",
          "format": "ulid"
        },
        "by": {
          "type": "string",
          "enum": [
            "you",
            "check"
          ]
        },
        "rev": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "run": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^run:[0-9A-Za-z]+$",
          "description": "A run: handle."
        }
      },
      "required": [
        "note",
        "by",
        "rev",
        "run"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$",
        "description": "A SHA-256, in lower-case hex."
      }
    }
  },
  "required": [
    "v",
    "id",
    "kind",
    "writer",
    "actor",
    "scope",
    "ts",
    "data"
  ],
  "additionalProperties": false
}
