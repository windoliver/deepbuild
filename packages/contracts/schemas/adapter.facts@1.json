{
  "title": "adapter.facts@1",
  "description": "An agent's facts as data: the versions it covers, and per section what the core reads, each naming the core rule that reads it and its conformance case. No core rule branches on the agent's name; a new agent fills a file.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "adapter.facts@1"
    },
    "versions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/version"
      },
      "minItems": 1,
      "description": "The agent versions the facts cover; a session on another version is recorded unverified."
    },
    "agent": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "The adapter's registry name."
    },
    "hookTimeouts": {
      "type": "object",
      "properties": {
        "readBy": {
          "$ref": "#/$defs/text"
        },
        "conformance": {
          "$ref": "#/$defs/text"
        },
        "defaultMs": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 9007199254740991,
          "description": "How long the agent lets a hook run by default; null when its facts don't say."
        },
        "perHook": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z][A-Za-z]*$"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "description": "Hooks the agent times differently from the default, each with its own limit in ms."
        }
      },
      "required": [
        "readBy",
        "conformance"
      ],
      "additionalProperties": false
    },
    "continuation": {
      "type": "object",
      "properties": {
        "readBy": {
          "$ref": "#/$defs/text"
        },
        "conformance": {
          "$ref": "#/$defs/text"
        },
        "cap": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "description": "How many times a stop hold may continue one turn."
        },
        "field": {
          "$ref": "#/$defs/text",
          "description": "The payload field that says a stop hook already continued this turn."
        }
      },
      "required": [
        "readBy",
        "conformance"
      ],
      "additionalProperties": false
    },
    "launch": {
      "type": "object",
      "properties": {
        "readBy": {
          "$ref": "#/$defs/text"
        },
        "conformance": {
          "$ref": "#/$defs/text"
        },
        "session": {
          "type": "object",
          "properties": {
            "readBy": {
              "$ref": "#/$defs/text"
            },
            "args": {
              "$ref": "#/$defs/texts"
            }
          },
          "required": [
            "args"
          ],
          "additionalProperties": false
        },
        "readOnlyJob": {
          "type": "object",
          "properties": {
            "readBy": {
              "$ref": "#/$defs/text"
            },
            "args": {
              "$ref": "#/$defs/texts"
            },
            "prompt": {
              "$ref": "#/$defs/text"
            }
          },
          "required": [
            "args",
            "prompt"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "readBy",
        "conformance"
      ],
      "additionalProperties": false
    },
    "modelFamily": {
      "type": "object",
      "properties": {
        "readBy": {
          "$ref": "#/$defs/text"
        },
        "conformance": {
          "$ref": "#/$defs/text"
        },
        "families": {
          "$ref": "#/$defs/textMap",
          "description": "Model name to the family whose rate card and context window it takes."
        }
      },
      "required": [
        "readBy",
        "conformance",
        "families"
      ],
      "additionalProperties": false
    },
    "billing": {
      "type": "object",
      "properties": {
        "readBy": {
          "$ref": "#/$defs/text"
        },
        "conformance": {
          "$ref": "#/$defs/text"
        },
        "apiKeyVariables": {
          "$ref": "#/$defs/texts",
          "description": "The environment variables that make a session bill an API account instead of a plan."
        }
      },
      "required": [
        "readBy",
        "conformance",
        "apiKeyVariables"
      ],
      "additionalProperties": false
    },
    "usage": {
      "type": "object",
      "properties": {
        "readBy": {
          "$ref": "#/$defs/text"
        },
        "conformance": {
          "$ref": "#/$defs/text"
        },
        "cost": {
          "type": "string",
          "enum": [
            "reported",
            "estimated",
            "unpriced"
          ],
          "description": "The basis a cost reading can have at best."
        },
        "costFrom": {
          "$ref": "#/$defs/text"
        },
        "tokens": {
          "$ref": "#/$defs/text"
        }
      },
      "required": [
        "readBy",
        "conformance",
        "cost",
        "costFrom",
        "tokens"
      ],
      "additionalProperties": false
    },
    "questionTools": {
      "type": "object",
      "properties": {
        "readBy": {
          "$ref": "#/$defs/text"
        },
        "conformance": {
          "$ref": "#/$defs/text"
        },
        "tools": {
          "$ref": "#/$defs/texts",
          "description": "The tool calls that are questions to the person."
        }
      },
      "required": [
        "readBy",
        "conformance",
        "tools"
      ],
      "additionalProperties": false
    },
    "transcripts": {
      "type": "object",
      "properties": {
        "readBy": {
          "$ref": "#/$defs/text"
        },
        "conformance": {
          "$ref": "#/$defs/text"
        },
        "home": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          },
          "minItems": 1,
          "description": "The variable that moves the agent's home, then its default."
        },
        "path": {
          "$ref": "#/$defs/text"
        }
      },
      "required": [
        "readBy",
        "conformance",
        "home",
        "path"
      ],
      "additionalProperties": false
    },
    "appLinks": {
      "type": "object",
      "properties": {
        "readBy": {
          "$ref": "#/$defs/text"
        },
        "conformance": {
          "$ref": "#/$defs/text"
        },
        "open": {
          "$ref": "#/$defs/text",
          "description": "The link that opens a session in the agent's own app, with {session} in it."
        }
      },
      "required": [
        "readBy",
        "conformance",
        "open"
      ],
      "additionalProperties": false
    },
    "errorTexts": {
      "type": "object",
      "properties": {
        "readBy": {
          "$ref": "#/$defs/text"
        },
        "conformance": {
          "$ref": "#/$defs/text"
        },
        "causes": {
          "$ref": "#/$defs/causeMap",
          "description": "The agent's error texts, each to the stop cause it names."
        }
      },
      "required": [
        "readBy",
        "conformance",
        "causes"
      ],
      "additionalProperties": false
    },
    "events": {
      "type": "object",
      "properties": {
        "readBy": {
          "$ref": "#/$defs/text"
        },
        "conformance": {
          "$ref": "#/$defs/text"
        },
        "versions": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[0-9A-Za-z][0-9A-Za-z.+-]*$"
          },
          "additionalProperties": {
            "type": "object",
            "propertyNames": {
              "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
            },
            "additionalProperties": {
              "$ref": "#/$defs/payload"
            }
          },
          "description": "Per covered version, each hook's strict payload schema."
        }
      },
      "required": [
        "readBy",
        "conformance",
        "versions"
      ],
      "additionalProperties": false
    },
    "mapping": {
      "type": "object",
      "properties": {
        "readBy": {
          "$ref": "#/$defs/text"
        },
        "conformance": {
          "$ref": "#/$defs/text"
        },
        "common": {
          "$ref": "#/$defs/dataTemplate",
          "description": "The data every event carries: a value names a payload field, or =text a constant."
        },
        "SessionStart": {
          "$ref": "#/$defs/hookRule"
        },
        "UserPromptSubmit": {
          "$ref": "#/$defs/hookRule"
        },
        "PreToolUse": {
          "$ref": "#/$defs/hookRule"
        },
        "PermissionRequest": {
          "$ref": "#/$defs/hookRule"
        },
        "PostToolUse": {
          "$ref": "#/$defs/hookRule"
        },
        "PostToolUseFailure": {
          "$ref": "#/$defs/hookRule"
        },
        "Stop": {
          "$ref": "#/$defs/hookRule"
        },
        "StopFailure": {
          "$ref": "#/$defs/hookRule"
        },
        "SessionEnd": {
          "$ref": "#/$defs/hookRule"
        },
        "SubagentStart": {
          "$ref": "#/$defs/hookRule"
        },
        "SubagentStop": {
          "$ref": "#/$defs/hookRule"
        },
        "TaskCreated": {
          "$ref": "#/$defs/hookRule"
        },
        "TaskCompleted": {
          "$ref": "#/$defs/hookRule"
        },
        "TeammateIdle": {
          "$ref": "#/$defs/hookRule"
        },
        "WorktreeCreate": {
          "$ref": "#/$defs/hookRule"
        },
        "WorktreeRemove": {
          "$ref": "#/$defs/hookRule"
        },
        "PreCompact": {
          "$ref": "#/$defs/hookRule"
        },
        "PostCompact": {
          "$ref": "#/$defs/hookRule"
        },
        "Interrupt": {
          "$ref": "#/$defs/hookRule"
        },
        "sessionStart": {
          "$ref": "#/$defs/hookRule"
        },
        "sessionEnd": {
          "$ref": "#/$defs/hookRule"
        },
        "preToolUse": {
          "$ref": "#/$defs/hookRule"
        },
        "postToolUse": {
          "$ref": "#/$defs/hookRule"
        },
        "stop": {
          "$ref": "#/$defs/hookRule"
        }
      },
      "required": [
        "readBy",
        "conformance",
        "common"
      ],
      "additionalProperties": false,
      "description": "Each hook the design's agent table names, to the event it maps to; a hook the table gains is a member added in a minor."
    },
    "toolKinds": {
      "type": "object",
      "properties": {
        "readBy": {
          "$ref": "#/$defs/text"
        },
        "conformance": {
          "$ref": "#/$defs/text"
        },
        "tools": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/toolKind"
          }
        },
        "prefixes": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/toolKind"
          }
        },
        "otherwise": {
          "$ref": "#/$defs/toolKind"
        }
      },
      "required": [
        "readBy",
        "conformance",
        "tools",
        "otherwise"
      ],
      "additionalProperties": false
    },
    "toolDetail": {
      "type": "object",
      "properties": {
        "readBy": {
          "$ref": "#/$defs/text"
        },
        "conformance": {
          "$ref": "#/$defs/text"
        },
        "command": {
          "$ref": "#/$defs/textMap",
          "description": "Per kind, the payload field that holds the command."
        },
        "paths": {
          "$ref": "#/$defs/textMap",
          "description": "Per tool, the payload field that holds the path, resolved against the payload's cwd."
        },
        "mcp": {
          "type": "object",
          "properties": {
            "tool": {
              "$ref": "#/$defs/text",
              "description": "The data field that records an MCP tool's own name; name when absent."
            }
          },
          "required": [
            "tool"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "readBy",
        "conformance"
      ],
      "additionalProperties": false
    },
    "patch": {
      "type": "object",
      "properties": {
        "readBy": {
          "$ref": "#/$defs/text"
        },
        "conformance": {
          "$ref": "#/$defs/text"
        },
        "tools": {
          "$ref": "#/$defs/texts"
        },
        "command": {
          "$ref": "#/$defs/text"
        },
        "shell": {
          "$ref": "#/$defs/text"
        }
      },
      "required": [
        "readBy",
        "conformance",
        "tools",
        "command",
        "shell"
      ],
      "additionalProperties": false
    },
    "turnWithoutPrompt": {
      "type": "object",
      "properties": {
        "readBy": {
          "$ref": "#/$defs/text"
        },
        "conformance": {
          "$ref": "#/$defs/text"
        },
        "payloadField": {
          "$ref": "#/$defs/text"
        },
        "startedBy": {
          "$ref": "#/$defs/texts"
        },
        "turnEntry": {
          "$ref": "#/$defs/text"
        },
        "turnField": {
          "$ref": "#/$defs/text"
        },
        "messageRole": {
          "type": "object",
          "properties": {
            "path": {
              "$ref": "#/$defs/text"
            },
            "value": {
              "$ref": "#/$defs/text"
            }
          },
          "required": [
            "path",
            "value"
          ],
          "additionalProperties": false
        },
        "messageText": {
          "$ref": "#/$defs/text"
        },
        "values": {
          "$ref": "#/$defs/markerMap"
        },
        "otherwise": {
          "$ref": "#/$defs/text"
        }
      },
      "required": [
        "readBy",
        "conformance",
        "payloadField",
        "startedBy",
        "turnEntry",
        "turnField",
        "messageRole",
        "messageText",
        "values",
        "otherwise"
      ],
      "additionalProperties": false
    },
    "signIn": {
      "type": "object",
      "properties": {
        "readBy": {
          "$ref": "#/$defs/text"
        },
        "conformance": {
          "$ref": "#/$defs/text"
        },
        "args": {
          "$ref": "#/$defs/texts"
        },
        "signedIn": {
          "$ref": "#/$defs/text"
        }
      },
      "required": [
        "readBy",
        "conformance",
        "args",
        "signedIn"
      ],
      "additionalProperties": false
    },
    "readUsage": {
      "$ref": "#/$defs/operation"
    },
    "classifyStop": {
      "$ref": "#/$defs/operation"
    },
    "skills": {
      "$ref": "#/$defs/operation"
    }
  },
  "required": [
    "schema",
    "versions",
    "agent",
    "hookTimeouts",
    "continuation",
    "launch",
    "modelFamily",
    "billing",
    "usage",
    "questionTools",
    "transcripts",
    "appLinks",
    "errorTexts",
    "events",
    "mapping",
    "toolKinds"
  ],
  "additionalProperties": false,
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1
    },
    "texts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9A-Za-z][0-9A-Za-z.+-]*$"
    },
    "textMap": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z_<][^\\s]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/text"
      }
    },
    "dataTemplate": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/text"
      }
    },
    "fieldTypes": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_.]*$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^(string|number|boolean|object|array|null|any)(\\|(string|number|boolean|object|array|null|any))*$"
      },
      "description": "Payload field to its type, or types joined by |; any takes every type."
    },
    "payload": {
      "type": "object",
      "properties": {
        "required": {
          "$ref": "#/$defs/fieldTypes"
        },
        "optional": {
          "$ref": "#/$defs/fieldTypes"
        },
        "tools": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/fieldTypes"
          },
          "description": "Per tool, the fields a call of that tool must carry."
        }
      },
      "required": [
        "required",
        "optional"
      ],
      "additionalProperties": false
    },
    "toolKind": {
      "type": "string",
      "enum": [
        "shell",
        "read",
        "edit",
        "write",
        "search",
        "fetch",
        "mcp",
        "unknown"
      ]
    },
    "stopCause": {
      "type": "string",
      "enum": [
        "sign_in_required",
        "token_refresh_failed",
        "plan_window_spent",
        "rate_limited",
        "refusal",
        "max_turns",
        "context_overflow",
        "tool_schema_rejected",
        "agent_crashed",
        "timed_out",
        "unknown"
      ]
    },
    "causeMap": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[^\\n]+$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/stopCause"
      }
    },
    "originRule": {
      "type": "object",
      "properties": {
        "prompt": {
          "$ref": "#/$defs/text",
          "description": "The prompt text the agent's own app writes opens with this."
        },
        "match": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_.]*$"
          },
          "additionalProperties": {
            "x-opaque": "the value the joined transcript entry carries at that path"
          },
          "description": "Fields the joined transcript entry must carry with these values."
        },
        "from": {
          "$ref": "#/$defs/text"
        }
      },
      "required": [
        "from"
      ],
      "additionalProperties": false
    },
    "hookRule": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "pattern": "^[a-z][a-z_]*\\.[a-z][a-z_]*$",
          "description": "The event kind the hook maps to."
        },
        "data": {
          "$ref": "#/$defs/dataTemplate"
        },
        "origin": {
          "type": "object",
          "properties": {
            "join": {
              "type": "object",
              "properties": {
                "payload": {
                  "$ref": "#/$defs/text"
                },
                "transcript": {
                  "$ref": "#/$defs/text"
                }
              },
              "required": [
                "payload",
                "transcript"
              ],
              "additionalProperties": false
            },
            "rules": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/originRule"
              }
            },
            "otherwise": {
              "$ref": "#/$defs/text"
            }
          },
          "required": [
            "rules",
            "otherwise"
          ],
          "additionalProperties": false
        },
        "call": {
          "type": "string",
          "enum": [
            "kind",
            "detail"
          ],
          "description": "The event carries the tool call's kind and detail, or its detail alone."
        },
        "cause": {
          "type": "object",
          "properties": {
            "field": {
              "$ref": "#/$defs/text"
            },
            "values": {
              "$ref": "#/$defs/causeMap"
            },
            "otherwise": {
              "$ref": "#/$defs/stopCause"
            }
          },
          "required": [
            "field",
            "values",
            "otherwise"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    },
    "operation": {
      "type": "object",
      "properties": {
        "readBy": {
          "$ref": "#/$defs/text"
        },
        "conformance": {
          "$ref": "#/$defs/text"
        }
      },
      "required": [
        "readBy",
        "conformance"
      ],
      "additionalProperties": false,
      "description": "An optional operation ships only with its conformance case."
    },
    "markerMap": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[^\\n]+$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/text"
      },
      "description": "A marker text, as the transcript carries it, to what it names."
    }
  }
}
