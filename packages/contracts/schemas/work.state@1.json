{
  "title": "work.state@1",
  "description": "An issue's state in a work run changed (#1332): its word, the same on every surface, what it waits for and why, built from the record and the forge's readings. `deep work show` prints these. Only the core appends it.",
  "x-since": "R1",
  "x-stability": "stable",
  "x-feeds": [],
  "type": "object",
  "properties": {
    "v": {
      "const": 1,
      "description": "The kind's schema version."
    },
    "id": {
      "type": "string",
      "format": "ulid",
      "description": "The event's ULID, its identity."
    },
    "kind": {
      "const": "work.state"
    },
    "subject": {
      "type": "string",
      "pattern": "^(task|ask|claim|verdict|run|req|decision|plan|lease|reading|notice|doc|ev|session):[0-9A-Za-z]+(#[A-Za-z0-9][A-Za-z0-9._-]*)?$",
      "description": "The record object this event is about."
    },
    "writer": {
      "const": "core",
      "description": "Only the core appends this kind."
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "description": "The person behind it, from the credential."
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "description": "Who may see it."
    },
    "ts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Milliseconds since the Unix epoch."
    },
    "seq": {
      "type": "string",
      "format": "seq",
      "description": "Order within the session: ns since the epoch when the hook started."
    },
    "log_pos": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Its position in the event log, assigned by the hub at append."
    },
    "data": {
      "type": "object",
      "properties": {
        "ask": {
          "type": "string",
          "pattern": "^ask:[0-9A-Za-z]+$",
          "maxLength": 8192,
          "description": "The run's approval: the start.approve ask it was raised as."
        },
        "issue": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "description": "The issue."
        },
        "word": {
          "type": "string",
          "enum": [
            "queued",
            "working",
            "says done",
            "PASS",
            "sent back",
            "BLOCKED",
            "INVALID",
            "INCONCLUSIVE",
            "needs you",
            "stale",
            "finished",
            "closed",
            "closed before the gate"
          ],
          "description": "The state word: the states table's, closed for an issue closed with no landing, or closed before the gate for one on the baseline.",
          "x-closure": {
            "closed": "the states table's words a run's issue can read, and the two for issues closed outside the gate",
            "reopens": "a new major of this schema",
            "mark": "exhaustive"
          }
        },
        "waits_on": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 8192,
          "description": "What it waits for: an issue, a link, a pull request, a free slot, a host, you; null when it waits on nothing."
        },
        "why": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "description": "Why it reads so."
        }
      },
      "required": [
        "ask",
        "issue",
        "word",
        "waits_on",
        "why"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$",
        "description": "A SHA-256, in lower-case hex."
      }
    }
  },
  "required": [
    "v",
    "id",
    "kind",
    "writer",
    "actor",
    "scope",
    "ts",
    "data"
  ],
  "additionalProperties": false
}
