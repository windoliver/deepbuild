{
  "title": "ask.later@1",
  "description": "An ask was put off until a time before its deadline, by you; never by an agent.",
  "x-feeds": [
    "asks"
  ],
  "type": "object",
  "properties": {
    "v": {
      "const": 1,
      "description": "The kind's schema version."
    },
    "id": {
      "type": "string",
      "format": "ulid",
      "description": "The event's ULID, its identity."
    },
    "kind": {
      "const": "ask.later"
    },
    "subject": {
      "type": "string",
      "pattern": "^ask:[0-9A-Za-z]+$",
      "description": "The ask this event is about."
    },
    "writer": {
      "type": "string",
      "enum": [
        "app",
        "cli",
        "core"
      ],
      "description": "Who wrote it, from the connection; only these writers append this kind.",
      "x-closure": {
        "closed": "each value is a state the record defines and every reader acts on, so a value outside the list has no meaning",
        "reopens": "a new major of this schema",
        "mark": "exhaustive"
      }
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "description": "The person behind it, from the credential."
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "description": "Who may see it."
    },
    "ts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Milliseconds since the Unix epoch."
    },
    "seq": {
      "type": "string",
      "format": "seq",
      "description": "Order within the session: ns since the epoch when the hook started."
    },
    "log_pos": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Its position in the event log, assigned by the hub at append."
    },
    "data": {
      "type": "object",
      "properties": {
        "until": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Milliseconds since the Unix epoch."
        }
      },
      "required": [
        "until"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$",
        "description": "A SHA-256, in lower-case hex."
      }
    }
  },
  "required": [
    "v",
    "id",
    "kind",
    "subject",
    "writer",
    "actor",
    "scope",
    "ts",
    "data"
  ],
  "additionalProperties": false
}
