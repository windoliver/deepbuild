{
  "title": "run.started@2",
  "description": "A check run started, with where it ran and what it needed (#29), so a later placement can pick any host from the same record.",
  "x-feeds": [
    "runs"
  ],
  "type": "object",
  "properties": {
    "v": {
      "const": 2,
      "description": "The kind's schema version."
    },
    "id": {
      "type": "string",
      "format": "ulid",
      "description": "The event's ULID, its identity."
    },
    "kind": {
      "const": "run.started"
    },
    "subject": {
      "type": "string",
      "pattern": "^(task|ask|claim|verdict|run|req|decision|plan|lease|reading|notice|doc|ev|session):[0-9A-Za-z]+(#[A-Za-z0-9][A-Za-z0-9._-]*)?$",
      "description": "The record object this event is about."
    },
    "writer": {
      "type": "string",
      "pattern": "^(hook|app|cli|core|mcp:[^\\s]+|ext:[^\\s]+)$",
      "description": "Who wrote it, from the connection, never the payload."
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "description": "The person behind it, from the credential."
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "description": "Who may see it."
    },
    "ts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Milliseconds since the Unix epoch."
    },
    "seq": {
      "type": "string",
      "format": "seq",
      "description": "Order within the session: ns since the epoch when the hook started."
    },
    "log_pos": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Its position in the event log, assigned by the hub at append."
    },
    "data": {
      "type": "object",
      "properties": {
        "run": {
          "type": "string",
          "pattern": "^run:[0-9A-Za-z]+$",
          "description": "A run: handle.",
          "maxLength": 8192
        },
        "check": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "claim": {
          "type": "string",
          "pattern": "^claim:[0-9A-Za-z]+$",
          "description": "A claim: handle.",
          "maxLength": 8192
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$",
          "maxLength": 8192
        },
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "description": "Where it ran: local in R1."
        },
        "needs": {
          "type": "object",
          "description": "What it needed: its cores, memory, stack slot, GPUs and expected time.",
          "properties": {
            "cores": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "CPU cores."
            },
            "memory_mb": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "Memory, in MB."
            },
            "stack_slot": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "Stack slots."
            },
            "gpus": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "GPUs."
            },
            "expected_ms": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "Its expected time, in ms, a stack's start included; null before it has a clean run."
            }
          },
          "required": [
            "cores",
            "memory_mb",
            "stack_slot",
            "gpus",
            "expected_ms"
          ],
          "additionalProperties": false
        },
        "lane": {
          "type": "string",
          "enum": [
            "fast",
            "slow"
          ],
          "description": "The lane it ran in: inside its stop's hold, or in the background.",
          "x-closure": {
            "closed": "each value is a state the record defines and every reader acts on, so a value outside the list has no meaning",
            "reopens": "a new major of this schema",
            "mark": "exhaustive"
          }
        }
      },
      "required": [
        "run",
        "check",
        "claim",
        "commit",
        "host",
        "needs",
        "lane"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$",
        "description": "A SHA-256, in lower-case hex."
      }
    }
  },
  "required": [
    "v",
    "id",
    "kind",
    "writer",
    "actor",
    "scope",
    "ts",
    "data"
  ],
  "additionalProperties": false
}
