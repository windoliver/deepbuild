{
  "title": "start.started@1",
  "description": "A session DeepBuild started under your approval (#1330): its run, the approval, the issue, the agent and version, its account home and permission mode, its own worktree and branch from the default branch's head, and what its agent's sandbox holds.",
  "x-since": "R1",
  "x-stability": "stable",
  "x-feeds": [],
  "type": "object",
  "properties": {
    "v": {
      "const": 1,
      "description": "The kind's schema version."
    },
    "id": {
      "type": "string",
      "format": "ulid",
      "description": "The event's ULID, its identity."
    },
    "kind": {
      "const": "start.started"
    },
    "subject": {
      "type": "string",
      "pattern": "^(task|ask|claim|verdict|run|req|decision|plan|lease|reading|notice|doc|ev|session):[0-9A-Za-z]+(#[A-Za-z0-9][A-Za-z0-9._-]*)?$",
      "description": "The record object this event is about."
    },
    "writer": {
      "const": "core",
      "description": "Only the core appends this kind."
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "description": "The person behind it, from the credential."
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "description": "Who may see it."
    },
    "ts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Milliseconds since the Unix epoch."
    },
    "seq": {
      "type": "string",
      "format": "seq",
      "description": "Order within the session: ns since the epoch when the hook started."
    },
    "log_pos": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Its position in the event log, assigned by the hub at append."
    },
    "data": {
      "type": "object",
      "properties": {
        "run": {
          "type": "string",
          "pattern": "^run:[0-9A-Za-z]+$",
          "description": "A run: handle.",
          "maxLength": 8192
        },
        "ask": {
          "type": "string",
          "pattern": "^ask:[0-9A-Za-z]+$",
          "description": "An ask: handle.",
          "maxLength": 8192
        },
        "repo": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "issue": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "agent": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "home": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "mode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "worktree": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "branch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "base": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$",
          "maxLength": 8192
        },
        "sandbox": {
          "type": "object",
          "properties": {
            "sandboxed": {
              "type": "boolean",
              "description": "Whether it runs inside its agent's own sandbox; false for a version whose facts name none."
            },
            "walls": {
              "type": "object",
              "properties": {
                "writes": {
                  "type": "boolean"
                },
                "credentials": {
                  "type": "boolean"
                },
                "network": {
                  "type": "boolean"
                }
              },
              "required": [
                "writes",
                "credentials",
                "network"
              ],
              "additionalProperties": false,
              "description": "Each wall the agent's own sandbox holds, as its facts name them: writes held to the worktree and temp folders, credential folders unreadable, the network held to the hosts the approval names. One its facts don't name is false."
            }
          },
          "required": [
            "sandboxed",
            "walls"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "run",
        "ask",
        "repo",
        "issue",
        "agent",
        "version",
        "home",
        "mode",
        "worktree",
        "branch",
        "base",
        "sandbox"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$",
        "description": "A SHA-256, in lower-case hex."
      }
    }
  },
  "required": [
    "v",
    "id",
    "kind",
    "writer",
    "actor",
    "scope",
    "ts",
    "data"
  ],
  "additionalProperties": false
}
