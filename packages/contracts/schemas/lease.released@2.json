{
  "title": "lease.released@2",
  "description": "A lease ended. Its proof cites the events that show it: the holder's end (its session.end, or the core's session.gone) and each process.ended of the run that held it, never its expiry.",
  "x-feeds": [
    "leases"
  ],
  "type": "object",
  "properties": {
    "v": {
      "const": 2,
      "description": "The kind's schema version."
    },
    "id": {
      "type": "string",
      "format": "ulid",
      "description": "The event's ULID, its identity."
    },
    "kind": {
      "const": "lease.released"
    },
    "subject": {
      "type": "string",
      "pattern": "^(task|ask|claim|verdict|run|req|decision|plan|lease|reading|notice|doc|ev|session):[0-9A-Za-z]+(#[A-Za-z0-9][A-Za-z0-9._-]*)?$",
      "description": "The record object this event is about."
    },
    "writer": {
      "type": "string",
      "pattern": "^(hook|app|cli|core|mcp:[^\\s]+|ext:[^\\s]+)$",
      "description": "Who wrote it, from the connection, never the payload."
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "description": "The person behind it, from the credential."
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "description": "Who may see it."
    },
    "ts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Milliseconds since the Unix epoch."
    },
    "seq": {
      "type": "string",
      "format": "seq",
      "description": "Order within the session: ns since the epoch when the hook started."
    },
    "log_pos": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Its position in the event log, assigned by the hub at append."
    },
    "data": {
      "type": "object",
      "properties": {
        "resource": {
          "type": "object",
          "properties": {
            "host": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            "kind": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            "key": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            }
          },
          "required": [
            "host",
            "kind",
            "key"
          ],
          "additionalProperties": false
        },
        "holder": {
          "type": "string",
          "pattern": "^(session:[0-9A-Za-z]+|hook|app|cli|core|mcp:[^\\s]+|ext:[^\\s]+)$",
          "description": "A session, or a writer as the envelope writes one, such as a document prefix's.",
          "maxLength": 8192
        },
        "mode": {
          "type": "string",
          "enum": [
            "exclusive",
            "shared"
          ],
          "x-closure": {
            "closed": "each value is a state the record defines and every reader acts on, so a value outside the list has no meaning",
            "reopens": "a new major of this schema",
            "mark": "exhaustive"
          }
        },
        "expires": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Milliseconds since the Unix epoch."
        },
        "proof": {
          "type": "array",
          "description": "The IDs of the events that prove the lease ended.",
          "items": {
            "type": "string",
            "format": "ulid",
            "description": "An event's ULID."
          }
        }
      },
      "required": [
        "resource",
        "holder",
        "mode",
        "expires",
        "proof"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$",
        "description": "A SHA-256, in lower-case hex."
      }
    }
  },
  "required": [
    "v",
    "id",
    "kind",
    "writer",
    "actor",
    "scope",
    "ts",
    "data"
  ],
  "additionalProperties": false
}
