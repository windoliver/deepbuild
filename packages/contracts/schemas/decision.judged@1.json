{
  "title": "decision.judged@1",
  "description": "A standing rule was judged by what later broke in the work it decided, against the same kind of work you decided yourself, and its state changed: active (it can widen), frozen (it keeps deciding at its scope but can't widen) or revoked (it answers nothing). Only the core appends it.",
  "x-feeds": [
    "decisions"
  ],
  "type": "object",
  "properties": {
    "v": {
      "const": 1,
      "description": "The kind's schema version."
    },
    "id": {
      "type": "string",
      "format": "ulid",
      "description": "The event's ULID, its identity."
    },
    "kind": {
      "const": "decision.judged"
    },
    "subject": {
      "type": "string",
      "pattern": "^(task|ask|claim|verdict|run|req|decision|plan|lease|reading|notice|doc|ev|session):[0-9A-Za-z]+(#[A-Za-z0-9][A-Za-z0-9._-]*)?$",
      "description": "The record object this event is about."
    },
    "writer": {
      "const": "core",
      "description": "Only the core appends this kind."
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "description": "The person behind it, from the credential."
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "description": "Who may see it."
    },
    "ts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Milliseconds since the Unix epoch."
    },
    "seq": {
      "type": "string",
      "format": "seq",
      "description": "Order within the session: ns since the epoch when the hook started."
    },
    "log_pos": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Its position in the event log, assigned by the hub at append."
    },
    "data": {
      "type": "object",
      "properties": {
        "decision": {
          "type": "string",
          "pattern": "^decision:[0-9A-Za-z]+$",
          "maxLength": 8192,
          "description": "The standing rule: a decision: handle."
        },
        "state": {
          "type": "string",
          "enum": [
            "active",
            "frozen",
            "revoked"
          ],
          "x-closure": {
            "closed": "each value is a state the record defines and every reader acts on, so a value outside the list has no meaning",
            "reopens": "a new major of this schema",
            "mark": "exhaustive"
          },
          "description": "Its state from now on."
        },
        "verdict": {
          "type": "string",
          "enum": [
            "widen",
            "undecided",
            "FAIL"
          ],
          "x-closure": {
            "closed": "each value is a state the record defines and every reader acts on, so a value outside the list has no meaning",
            "reopens": "a new major of this schema",
            "mark": "exhaustive"
          },
          "description": "The judgment: it can widen, the evidence can't decide, or it FAILs."
        },
        "rule": {
          "type": "object",
          "description": "The work it decided: cases, how many later broke, and the one-sided 95% Clopper-Pearson bounds on that rate.",
          "properties": {
            "cases": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "Cases it decided."
            },
            "broke": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "How many of them later broke."
            },
            "lower": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "The lower bound on its breakage rate."
            },
            "upper": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "The upper bound on its breakage rate."
            }
          },
          "required": [
            "cases",
            "broke",
            "lower",
            "upper"
          ],
          "additionalProperties": false
        },
        "yours": {
          "type": "object",
          "description": "The same kind of work you decided yourself: cases, how many later broke, and the upper bound on that rate.",
          "properties": {
            "cases": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "Cases you decided."
            },
            "broke": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "How many of them later broke."
            },
            "upper": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "The upper bound on your breakage rate, never 0."
            }
          },
          "required": [
            "cases",
            "broke",
            "upper"
          ],
          "additionalProperties": false
        },
        "margin": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000,
          "description": "The margin in your settings."
        },
        "limit": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000,
          "description": "Your upper bound times the margin."
        },
        "more": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 9007199254740991,
          "description": "When the evidence can't decide, the fewest more cases with no breakage that would let it widen; null otherwise."
        }
      },
      "required": [
        "decision",
        "state",
        "verdict",
        "rule",
        "yours",
        "margin",
        "limit",
        "more"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$",
        "description": "A SHA-256, in lower-case hex."
      }
    }
  },
  "required": [
    "v",
    "id",
    "kind",
    "writer",
    "actor",
    "scope",
    "ts",
    "data"
  ],
  "additionalProperties": false
}
