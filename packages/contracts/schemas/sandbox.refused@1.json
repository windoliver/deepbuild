{
  "title": "sandbox.refused@1",
  "description": "The agent's own sandbox refused a command in a session DeepBuild started (#1330), as the command's output says: what it tried, and the call it was part of.",
  "x-since": "R1",
  "x-stability": "stable",
  "x-feeds": [],
  "type": "object",
  "properties": {
    "v": {
      "const": 1,
      "description": "The kind's schema version."
    },
    "id": {
      "type": "string",
      "format": "ulid",
      "description": "The event's ULID, its identity."
    },
    "kind": {
      "const": "sandbox.refused"
    },
    "subject": {
      "type": "string",
      "pattern": "^(task|ask|claim|verdict|run|req|decision|plan|lease|reading|notice|doc|ev|session):[0-9A-Za-z]+(#[A-Za-z0-9][A-Za-z0-9._-]*)?$",
      "description": "The record object this event is about."
    },
    "writer": {
      "const": "core",
      "description": "Only the core appends this kind."
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "description": "The person behind it, from the credential."
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "description": "Who may see it."
    },
    "ts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Milliseconds since the Unix epoch."
    },
    "seq": {
      "type": "string",
      "format": "seq",
      "description": "Order within the session: ns since the epoch when the hook started."
    },
    "log_pos": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Its position in the event log, assigned by the hub at append."
    },
    "data": {
      "type": "object",
      "properties": {
        "run": {
          "type": "string",
          "pattern": "^run:[0-9A-Za-z]+$",
          "description": "A run: handle.",
          "maxLength": 8192
        },
        "session": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "operation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "description": "read, write, connect, or the sandbox's own word for it."
        },
        "target": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "description": "The path or host:port refused."
        },
        "call": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 8192,
          "description": "The tool call's ID."
        }
      },
      "required": [
        "run",
        "session",
        "operation",
        "target",
        "call"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$",
        "description": "A SHA-256, in lower-case hex."
      }
    }
  },
  "required": [
    "v",
    "id",
    "kind",
    "writer",
    "actor",
    "scope",
    "ts",
    "data"
  ],
  "additionalProperties": false
}
