{
  "title": "run.finished@3",
  "description": "A check run finished. Since @2, a keyed run names the key it carries on (#1018); since @3, a run whose program's exit is its result, such as a root plan's (#1945), keeps that exit status.",
  "x-since": "R3",
  "x-stability": "preview",
  "x-tracking": "#1945",
  "x-feeds": [
    "runs"
  ],
  "type": "object",
  "properties": {
    "v": {
      "const": 3,
      "description": "The kind's schema version."
    },
    "id": {
      "type": "string",
      "format": "ulid",
      "description": "The event's ULID, its identity."
    },
    "kind": {
      "const": "run.finished"
    },
    "subject": {
      "type": "string",
      "pattern": "^(task|ask|claim|verdict|run|req|decision|plan|lease|reading|notice|doc|ev|session):[0-9A-Za-z]+(#[A-Za-z0-9][A-Za-z0-9._-]*)?$",
      "description": "The record object this event is about."
    },
    "writer": {
      "type": "string",
      "pattern": "^(hook|app|cli|core|ext:[^\\s]+)$",
      "description": "Who wrote it, from the connection; never an agent through MCP, since no deep_* tool produces this kind."
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "description": "The person behind it, from the credential."
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "description": "Who may see it."
    },
    "ts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Milliseconds since the Unix epoch."
    },
    "seq": {
      "type": "string",
      "format": "seq",
      "description": "Order within the session: ns since the epoch when the hook started."
    },
    "log_pos": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Its position in the event log, assigned by the hub at append."
    },
    "data": {
      "type": "object",
      "properties": {
        "run": {
          "type": "string",
          "pattern": "^run:[0-9A-Za-z]+$",
          "description": "A run: handle.",
          "maxLength": 8192
        },
        "outcome": {
          "type": "string",
          "enum": [
            "passed",
            "failed",
            "ran_nothing",
            "missing",
            "overran",
            "stopped",
            "uncounted"
          ],
          "x-closure": {
            "closed": "each value is a state the record defines and every reader acts on, so a value outside the list has no meaning",
            "reopens": "a new major of this schema",
            "mark": "exhaustive"
          }
        },
        "tests_run": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "passed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "runs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "A SHA-256, in lower-case hex.",
            "maxLength": 8192
          }
        },
        "check": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "assertion": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 8192
        },
        "expected": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 8192
        },
        "actual": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 8192
        },
        "step": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 8192
        },
        "points_to": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 8192
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          }
        },
        "environment": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "key": {
          "type": "object",
          "description": "The run's key (#1018): what its result depends on, by which any claim in the repo on this host with an equal key reads it as carried.",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "description": "A SHA-256, in lower-case hex.",
              "maxLength": 8192
            },
            "stem": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "description": "A SHA-256, in lower-case hex.",
              "maxLength": 8192
            },
            "paths": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
              },
              "description": "The files whose contents the key holds: the check's declared inputs and the files its runs read, or its own files on a base run."
            },
            "claim": {
              "type": "string",
              "pattern": "^claim:[0-9A-Za-z]+$",
              "description": "A claim: handle.",
              "maxLength": 8192
            },
            "session": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            "base": {
              "type": "boolean"
            },
            "withheld": {
              "type": "boolean",
              "description": "A held-out variant's run: its verdict carries, never its output."
            },
            "plain": {
              "type": "boolean",
              "description": "Its record is whole here (no retried test, no stand-in seeded, every failure on an assertion, no contract), so a restarted hub may read it again."
            }
          },
          "required": [
            "id",
            "stem",
            "paths",
            "claim",
            "session",
            "base",
            "withheld",
            "plain"
          ],
          "additionalProperties": false
        },
        "exit": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": -2147483648,
          "maximum": 2147483647,
          "description": "The program's exit status (#1945); null when it ended without one."
        }
      },
      "required": [
        "run",
        "outcome",
        "tests_run",
        "passed",
        "runs",
        "evidence",
        "check",
        "assertion",
        "expected",
        "actual",
        "step",
        "points_to",
        "findings",
        "environment"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$",
        "description": "A SHA-256, in lower-case hex."
      }
    }
  },
  "required": [
    "v",
    "id",
    "kind",
    "writer",
    "actor",
    "scope",
    "ts",
    "data"
  ],
  "additionalProperties": false
}
