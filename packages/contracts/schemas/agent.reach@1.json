{
  "title": "agent.reach@1",
  "description": "Whether an agent's sessions reach DeepBuild, as the Agents page lists it (#2019): waiting for a first session, unreachable with why and its fix (hooks not installed, disabled or not trusted, or a version outside its facts), or reached. Appended when an agent's reading changes; it names no session.",
  "x-since": "R1",
  "x-stability": "stable",
  "x-feeds": [],
  "type": "object",
  "properties": {
    "v": {
      "const": 1,
      "description": "The kind's schema version."
    },
    "id": {
      "type": "string",
      "format": "ulid",
      "description": "The event's ULID, its identity."
    },
    "kind": {
      "const": "agent.reach"
    },
    "subject": {
      "type": "string",
      "pattern": "^(task|ask|claim|verdict|run|req|decision|plan|lease|reading|notice|doc|ev|session):[0-9A-Za-z]+(#[A-Za-z0-9][A-Za-z0-9._-]*)?$",
      "description": "The record object this event is about."
    },
    "writer": {
      "const": "core",
      "description": "Only the core appends this kind."
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "description": "The person behind it, from the credential."
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "description": "Who may see it."
    },
    "ts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Milliseconds since the Unix epoch."
    },
    "seq": {
      "type": "string",
      "format": "seq",
      "description": "Order within the session: ns since the epoch when the hook started."
    },
    "log_pos": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Its position in the event log, assigned by the hub at append."
    },
    "data": {
      "type": "object",
      "properties": {
        "agent": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "maxLength": 8192,
          "description": "The agent, by its facts file."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "description": "The name a person knows it by."
        },
        "state": {
          "type": "string",
          "enum": [
            "waiting",
            "unreachable",
            "reached"
          ],
          "description": "Waiting for its first session, unable to reach DeepBuild, or reached.",
          "x-closure": {
            "closed": "the readings the Agents page gives an agent",
            "reopens": "a minor that adds a reading",
            "mark": "exhaustive"
          }
        },
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "maxLength": 8192,
          "description": "For unreachable: the doctor item's code that says why."
        },
        "why": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "description": "For unreachable: why, in plain words."
        },
        "fix": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "description": "For unreachable: the one fix."
        }
      },
      "required": [
        "agent",
        "name",
        "state"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$",
        "description": "A SHA-256, in lower-case hex."
      }
    }
  },
  "required": [
    "v",
    "id",
    "kind",
    "writer",
    "actor",
    "scope",
    "ts",
    "data"
  ],
  "additionalProperties": false
}
