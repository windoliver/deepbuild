{
  "title": "reading.dropped@1",
  "description": "A reading job refused one citation (#63): its quote was not at its handle, the handle names a whole session or nothing, or it was not delivered to that job. The finding it held was written nowhere.",
  "x-feeds": [],
  "type": "object",
  "properties": {
    "v": {
      "const": 1,
      "description": "The kind's schema version."
    },
    "id": {
      "type": "string",
      "format": "ulid",
      "description": "The event's ULID, its identity."
    },
    "kind": {
      "const": "reading.dropped"
    },
    "subject": {
      "type": "string",
      "pattern": "^(task|ask|claim|verdict|run|req|decision|plan|lease|reading|notice|doc|ev|session):[0-9A-Za-z]+(#[A-Za-z0-9][A-Za-z0-9._-]*)?$",
      "description": "The record object this event is about."
    },
    "writer": {
      "type": "string",
      "pattern": "^(hook|app|cli|core|ext:[^\\s]+)$",
      "description": "Who wrote it, from the connection; never an agent through MCP, since no deep_* tool produces this kind."
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "description": "The person behind it, from the credential."
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "description": "Who may see it."
    },
    "ts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Milliseconds since the Unix epoch."
    },
    "seq": {
      "type": "string",
      "format": "seq",
      "description": "Order within the session: ns since the epoch when the hook started."
    },
    "log_pos": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Its position in the event log, assigned by the hub at append."
    },
    "data": {
      "type": "object",
      "properties": {
        "reading": {
          "type": "string",
          "pattern": "^reading:[0-9A-HJKMNP-TV-Z]{26}$",
          "maxLength": 8192,
          "description": "The reading job, `reading:<ULID>`."
        },
        "at": {
          "type": "string",
          "description": "A record handle: session:<id>, session:<id>#<message>, ev:<sha256>, wiki:<page>#<claim> or another the record names.",
          "maxLength": 8192,
          "minLength": 1
        },
        "quote": {
          "type": "string",
          "description": "The quote as the agent gave it.",
          "maxLength": 8192
        },
        "reason": {
          "type": "string",
          "description": "Why it was refused, naming the handle.",
          "maxLength": 8192,
          "minLength": 1
        }
      },
      "required": [
        "reading",
        "at",
        "quote",
        "reason"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$",
        "description": "A SHA-256, in lower-case hex."
      }
    }
  },
  "required": [
    "v",
    "id",
    "kind",
    "writer",
    "actor",
    "scope",
    "ts",
    "data"
  ],
  "additionalProperties": false
}
