{
  "title": "hook.joined@1",
  "description": "Handlers' contributions joined: first-party extensions, then every other package, each group by extension ID. Every deny is kept whole; context fills the bound in that order, cut from the end.",
  "type": "object",
  "properties": {
    "order": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Extension IDs in join order."
    },
    "bound": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "The total context bound, in characters, set from the hook time budget."
    },
    "denies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "extension": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "extension",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "context": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "extension": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "extension",
          "text"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "order",
    "bound",
    "denies",
    "context"
  ],
  "additionalProperties": false
}
