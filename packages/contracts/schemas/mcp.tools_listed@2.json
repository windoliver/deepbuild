{
  "title": "mcp.tools_listed@2",
  "description": "The tool list an MCP server a session loads gave at the session's start, synced by DeepBuild or added by you: each tool with its input schema's digest and the hints the server gives, which are its own claims. A new or changed tool that can change or destroy, against the server's first list and what you approved, is held at PreToolUse by the one authority ask this event names. @2 is @1 with the reply limit that applied to DeepBuild's own server (`limit`, #2896).",
  "x-since": "R1",
  "x-stability": "stable",
  "x-feeds": [
    "sessions"
  ],
  "type": "object",
  "properties": {
    "v": {
      "const": 2,
      "description": "The kind's schema version."
    },
    "id": {
      "type": "string",
      "format": "ulid",
      "description": "The event's ULID, its identity."
    },
    "kind": {
      "const": "mcp.tools_listed"
    },
    "subject": {
      "type": "string",
      "pattern": "^(task|ask|claim|verdict|run|req|decision|plan|lease|reading|notice|doc|ev|session):[0-9A-Za-z]+(#[A-Za-z0-9][A-Za-z0-9._-]*)?$",
      "description": "The record object this event is about."
    },
    "writer": {
      "const": "core",
      "description": "Only the core appends this kind."
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "description": "The person behind it, from the credential."
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "description": "Who may see it."
    },
    "ts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Milliseconds since the Unix epoch."
    },
    "seq": {
      "type": "string",
      "format": "seq",
      "description": "Order within the session: ns since the epoch when the hook started."
    },
    "log_pos": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Its position in the event log, assigned by the hub at append."
    },
    "data": {
      "type": "object",
      "properties": {
        "server": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "description": "The server, by the name the agent loads it under."
        },
        "scope": {
          "type": "string",
          "enum": [
            "user",
            "local",
            "project"
          ],
          "description": "The config the agent loads it from.",
          "x-closure": {
            "closed": "the three configs Claude Code loads a server from",
            "reopens": "a new major of this schema",
            "mark": "exhaustive"
          }
        },
        "version": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 8192,
          "description": "The version the server's initialize names, or null."
        },
        "tools": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192,
                "description": "The tool's name."
              },
              "digest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$",
                "description": "The SHA-256 of the tool's input schema, canonical JSON (RFC 8785).",
                "maxLength": 8192
              },
              "hints": {
                "x-opaque": "the server's annotations, its own claims, shown as such and never lowering a class",
                "description": "The tool's annotations, as the server gives them."
              }
            },
            "required": [
              "name",
              "digest",
              "hints"
            ],
            "additionalProperties": false
          }
        },
        "held": {
          "type": "object",
          "description": "The new or changed tools this list holds until you answer, and the one ask for this update.",
          "properties": {
            "ask": {
              "type": "string",
              "pattern": "^ask:[0-9A-Za-z]+$",
              "maxLength": 8192,
              "description": "An ask: handle."
            },
            "tools": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192,
                "description": "A held tool, by name."
              }
            }
          },
          "required": [
            "ask",
            "tools"
          ],
          "additionalProperties": false
        },
        "limit": {
          "type": "object",
          "description": "The reply limit DeepBuild's own server held this client to (#2896): the client as its initialize names it, the facts that gave its limits, and the caps it held replies and refusals to.",
          "properties": {
            "client": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 8192,
              "description": "The client's name, as its initialize gives it, or null."
            },
            "client_version": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 8192,
              "description": "The client's version, as its initialize gives it, or null."
            },
            "from": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192,
              "description": "Where the limits came from: an agent version in its facts, or the smallest any facts file holds."
            },
            "result": {
              "type": "object",
              "description": "What the client keeps of a tool result, by its facts.",
              "properties": {
                "chars": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991,
                  "description": "Characters."
                },
                "tokens": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991,
                  "description": "Tokens, in the pinned count."
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991,
                  "description": "Bytes."
                }
              },
              "additionalProperties": false
            },
            "error": {
              "type": "object",
              "description": "What the client keeps of an error result, by its facts.",
              "properties": {
                "chars": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991,
                  "description": "Characters."
                },
                "tokens": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991,
                  "description": "Tokens, in the pinned count."
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991,
                  "description": "Bytes."
                }
              },
              "additionalProperties": false
            },
            "cap": {
              "type": "object",
              "description": "The reply cap applied: a fifth under the result limits.",
              "properties": {
                "chars": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991,
                  "description": "Characters."
                },
                "tokens": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991,
                  "description": "Tokens, in the pinned count."
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991,
                  "description": "Bytes."
                }
              },
              "additionalProperties": false
            },
            "error_cap": {
              "type": "object",
              "description": "The refusal cap applied: a fifth under the error limits' characters and tokens, and at their bytes, counted as Codex receives an error.",
              "properties": {
                "chars": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991,
                  "description": "Characters."
                },
                "tokens": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991,
                  "description": "Tokens, in the pinned count."
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991,
                  "description": "Bytes."
                }
              },
              "additionalProperties": false
            }
          },
          "required": [
            "client",
            "client_version",
            "from",
            "result",
            "error",
            "cap",
            "error_cap"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "server",
        "scope",
        "version",
        "tools"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$",
        "description": "A SHA-256, in lower-case hex."
      }
    }
  },
  "required": [
    "v",
    "id",
    "kind",
    "writer",
    "actor",
    "scope",
    "ts",
    "data"
  ],
  "additionalProperties": false
}
