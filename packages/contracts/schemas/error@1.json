{
  "title": "error@1",
  "description": "The one shape every refusal shares.",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "enum": [
        "unknown_schema",
        "not_json",
        "type",
        "required",
        "unlisted_field",
        "enum",
        "const",
        "pattern",
        "format",
        "length",
        "range",
        "union",
        "uncatalogued_kind",
        "handle_syntax",
        "handle_scheme",
        "digest_algorithm"
      ]
    },
    "retryable": {
      "type": "boolean",
      "description": "Whether a retry can help."
    },
    "remediation": {
      "type": "string",
      "minLength": 1,
      "description": "One remediation action."
    },
    "path": {
      "type": "string",
      "description": "The JSON Pointer of the refused value."
    },
    "actual": {
      "type": "string",
      "maxLength": 8192,
      "description": "The value refused there, cut at the read cap on a code point. Scrubbing secrets from it is not done yet."
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(task|ask|claim|verdict|run|req|decision|plan|lease|reading|notice|doc|ev|session):[0-9A-Za-z]+(#[A-Za-z0-9][A-Za-z0-9._-]*)?$",
        "description": "A record handle."
      },
      "description": "Handles to any partial evidence."
    }
  },
  "required": [
    "code",
    "retryable",
    "remediation",
    "path",
    "actual",
    "evidence"
  ],
  "additionalProperties": false
}
