        },
        "guard": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "description": "The guard that failed, when a row exists and its guard doesn't hold."
        }
      },
      "required": [
        "object",
        "table",
        "state",
        "event",
        "event_id"
      ],
