        "table": {
          "type": "string",
          "pattern": "^[a-z_]+\\.machine@[0-9]+$",
          "maxLength": 8192,
          "description": "The lifecycle table that has no row for the move."
        },
        "state": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "description": "The state the object was in."
        },
        "event": {
