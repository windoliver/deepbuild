{
  "title": "composition.tested@1",
  "description": "A contract test between a user and a provider's new version (#103): the user's own tests replayed against the provider's outputs recorded at that version, each output checked against its schema. One that failed refused the install, and the version in use stayed.",
  "x-since": "R2",
  "x-stability": "stable",
  "x-feeds": [],
  "type": "object",
  "properties": {
    "v": {
      "const": 1,
      "description": "The kind's schema version."
    },
    "id": {
      "type": "string",
      "format": "ulid",
      "description": "The event's ULID, its identity."
    },
    "kind": {
      "const": "composition.tested"
    },
    "subject": {
      "type": "string",
      "pattern": "^(task|ask|claim|verdict|run|req|decision|plan|lease|reading|notice|doc|ev|session):[0-9A-Za-z]+(#[A-Za-z0-9][A-Za-z0-9._-]*)?$",
      "description": "The record object this event is about."
    },
    "writer": {
      "const": "core",
      "description": "Only the core appends this kind."
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "description": "The person behind it, from the credential."
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "description": "Who may see it."
    },
    "ts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Milliseconds since the Unix epoch."
    },
    "seq": {
      "type": "string",
      "format": "seq",
      "description": "Order within the session: ns since the epoch when the hook started."
    },
    "log_pos": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Its position in the event log, assigned by the hub at append."
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$",
        "description": "A SHA-256, in lower-case hex."
      }
    },
    "data": {
      "type": "object",
      "properties": {
        "user": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*(/[a-z0-9][a-z0-9_-]*)?$",
          "maxLength": 8192,
          "description": "The piece whose use was tested."
        },
        "interface": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*@[1-9][0-9]*$",
          "maxLength": 8192,
          "description": "The interface it uses, name@major."
        },
        "provider": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*(/[a-z0-9][a-z0-9_-]*)?$",
          "maxLength": 8192,
          "description": "The provider whose new version was tested."
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+([-+][0-9A-Za-z.+-]+)?$",
          "maxLength": 8192,
          "description": "The provider's version under test."
        },
        "passed": {
          "type": "boolean",
          "description": "Every output held to its schema and every test of the user's passed."
        }
      },
      "required": [
        "user",
        "interface",
        "provider",
        "version",
        "passed"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "v",
    "id",
    "kind",
    "writer",
    "actor",
    "scope",
    "ts",
    "data"
  ],
  "additionalProperties": false
}
