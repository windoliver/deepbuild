    },
    "texts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9A-Za-z][0-9A-Za-z.+-]*$"
    },
    "textMap": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z_<][^\\s]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/text"
      }
    },
    "dataTemplate": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/text"
      }
    },
    "fieldTypes": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_.]*$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^(string|number|boolean|object|array|null|any)(\\|(string|number|boolean|object|array|null|any))*$"
      },
      "description": "Payload field to its type, or types joined by |; any takes every type."
    },
    "payload": {
      "type": "object",
      "properties": {
        "required": {
          "$ref": "#/$defs/fieldTypes"
        },
        "optional": {
          "$ref": "#/$defs/fieldTypes"
        },
        "tools": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/fieldTypes"
          },
          "description": "Per tool, the fields a call of that tool must carry."
        }
      },
      "required": [
        "required",
        "optional"
      ],
      "additionalProperties": false
    },
    "toolKind": {
      "type": "string",
      "enum": [
        "shell",
        "read",
        "edit",
        "write",
        "search",
        "fetch",
        "mcp",
        "unknown"
      ],
      "x-closure": {
        "closed": "the values come from agents and tools that add new ones; a reader at an earlier minor reads a value it does not know as unknown",
        "reopens": "a minor that adds a member; a reader at the earlier minor takes it for unknown",
        "mark": "extensible"
      }
    },
    "stopCause": {
      "type": "string",
      "enum": [
        "sign_in_required",
        "token_refresh_failed",
        "plan_window_spent",
        "rate_limited",
        "refusal",
        "max_turns",
        "context_overflow",
        "tool_schema_rejected",
        "agent_crashed",
        "timed_out",
        "unknown"
      ],
      "x-closure": {
        "closed": "the values come from agents and tools that add new ones; a reader at an earlier minor reads a value it does not know as unknown",
        "reopens": "a minor that adds a member; a reader at the earlier minor takes it for unknown",
        "mark": "extensible"
      }
    },
    "causeMap": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[^\\n]+$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/stopCause"
      }
    },
    "originRule": {
      "type": "object",
      "properties": {
        "prompt": {
          "$ref": "#/$defs/text",
          "description": "The prompt text the agent's own app writes opens with this."
        },
        "match": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_.]*$"
          },
          "additionalProperties": {
            "x-opaque": "the value the joined transcript entry carries at that path"
          },
          "description": "Fields the joined transcript entry must carry with these values."
        },
        "from": {
          "$ref": "#/$defs/text"
        }
      },
      "required": [
        "from"
      ],
      "additionalProperties": false
    },
    "hookRule": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "pattern": "^[a-z][a-z_]*\\.[a-z][a-z_]*$",
          "description": "The event kind the hook maps to."
        },
        "data": {
          "$ref": "#/$defs/dataTemplate"
        },
        "origin": {
          "type": "object",
          "properties": {
            "join": {
              "type": "object",
              "properties": {
                "payload": {
                  "$ref": "#/$defs/text"
                },
                "transcript": {
                  "$ref": "#/$defs/text"
                }
              },
              "required": [
                "payload",
                "transcript"
              ],
              "additionalProperties": false
            },
            "rules": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/originRule"
              }
            },
            "otherwise": {
              "$ref": "#/$defs/text"
            }
          },
          "required": [
            "rules",
            "otherwise"
          ],
          "additionalProperties": false
        },
        "call": {
          "type": "string",
          "enum": [
            "kind",
            "detail"
          ],
          "description": "The event carries the tool call's kind and detail, or its detail alone.",
          "x-closure": {
            "closed": "each value is a state the record defines and every reader acts on, so a value outside the list has no meaning",
            "reopens": "a new major of this schema",
            "mark": "exhaustive"
          }
        },
        "stop": {
          "type": "boolean",
          "description": "The event is a stop: it names its cause and carries its usage by the facts' stop section."
        },
        "cause": {
          "type": "object",
          "properties": {
            "field": {
              "$ref": "#/$defs/text"
            },
            "values": {
              "$ref": "#/$defs/causeMap"
            },
            "otherwise": {
              "$ref": "#/$defs/stopCause"
            }
          },
          "required": [
            "field",
            "values",
            "otherwise"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    },
    "operation": {
      "type": "object",
      "properties": {
        "readBy": {
          "$ref": "#/$defs/text"
        },
        "conformance": {
          "$ref": "#/$defs/text"
        }
      },
      "required": [
        "readBy",
        "conformance"
      ],
      "additionalProperties": false,
      "description": "An optional operation ships only with its conformance case."
    },
    "markerMap": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[^\\n]+$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/text"
      },
      "description": "A marker text, as the transcript carries it, to what it names."
    }
  },
  "x-rules": [
    {
      "id": "who-is-calling",
      "rule": "Who is calling: a subagent's stop or permission request is not its parent's, and another tool running the agent's hooks is not the agent; a session is owned by the adapter that bound its ID first."
    },
    {
      "id": "order-by-seq",
      "rule": "Order by seq with ties by ID: a session's events sort by the seq deep-hook stamped, two with one seq by their IDs, and no two events share an ID."
    },
    {
      "id": "clock-stepped-back",
      "rule": "A clock stepped back never moves an event before its turn started: the event keeps its arrival place, stamped no earlier than the turn's first event."
    },
    {
      "id": "late-event-in-stopped-turn",
      "rule": "A late event in a stopped turn is recorded in that turn and reopens nothing: a PostToolUse after its turn's Stop changes nothing about how the turn ended."
    },
    {
      "id": "unknown-not-finished",
      "rule": "When hooks go quiet the session reads unknown rather than finished; a wait is a lease, never a finish."
    },
    {
      "id": "threads-across-rotated-ids",
      "rule": "The session map threads across rotated IDs: a start after /clear, /compact or a fork names the thread it continues."
    },
    {
      "id": "one-owner-per-session",
      "rule": "One owner per session: an answer reaches the session it was asked for and no other; another adapter only relays."
    },
    {
      "id": "allow-only-from-decision",
      "rule": "A permission answer takes allow only from decision, never from a suggestion or the text beside it."
    },
    {
      "id": "unparsed-stop-reads-unknown",
      "rule": "A stop that can't be parsed read as unknown: a cause the facts don't list is unknown, never a listed cause and never a success."
    },
    {
      "id": "delivery-confirmed-from-transcript",
      "rule": "Delivery confirmed from the transcript: an acknowledgement counts only with the transcript's sign of it."
    }
  ]
}
