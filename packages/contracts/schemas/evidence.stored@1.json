{
  "title": "evidence.stored@1",
  "description": "The evidence store kept a file: appended by the record for each put, with what the file was stored as.",
  "x-since": "R1",
  "x-stability": "stable",
  "x-feeds": [
    "evidence"
  ],
  "type": "object",
  "properties": {
    "v": {
      "const": 1,
      "description": "The kind's schema version."
    },
    "id": {
      "type": "string",
      "format": "ulid",
      "description": "The event's ULID, its identity."
    },
    "kind": {
      "const": "evidence.stored"
    },
    "subject": {
      "type": "string",
      "pattern": "^(task|ask|claim|verdict|run|req|decision|plan|lease|reading|notice|doc|ev|session):[0-9A-Za-z]+(#[A-Za-z0-9][A-Za-z0-9._-]*)?$",
      "description": "The record object this event is about."
    },
    "writer": {
      "type": "string",
      "pattern": "^(hook|app|cli|core|ext:[^\\s]+)$",
      "description": "Who wrote it, from the connection; never an agent through MCP, since no deep_* tool produces this kind."
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "description": "The person behind it, from the credential."
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "description": "Who may see it."
    },
    "ts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Milliseconds since the Unix epoch."
    },
    "seq": {
      "type": "string",
      "format": "seq",
      "description": "Order within the session: ns since the epoch when the hook started."
    },
    "log_pos": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Its position in the event log, assigned by the hub at append."
    },
    "data": {
      "type": "object",
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "A SHA-256, in lower-case hex.",
          "maxLength": 8192
        },
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "type": {
          "type": "string",
          "enum": [
            "png",
            "jpeg",
            "mp4",
            "text",
            "binary"
          ],
          "description": "What intake found the bytes to be.",
          "x-closure": {
            "closed": "each value is a class the evidence store's intake assigns, binary taking every file it does not recognise, so a value outside the list has no meaning",
            "reopens": "a new major of this schema",
            "mark": "exhaustive"
          }
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "The file's size in bytes."
        },
        "origin": {
          "type": "string",
          "enum": [
            "deepbuild",
            "you",
            "agent"
          ],
          "description": "From the writer's connection; a file made from others is agent when any input is.",
          "x-closure": {
            "closed": "each value is a state the record defines and every reader acts on, so a value outside the list has no meaning",
            "reopens": "a new major of this schema",
            "mark": "exhaustive"
          }
        },
        "redaction": {
          "type": "string",
          "enum": [
            "complete",
            "incomplete",
            "unknown"
          ],
          "x-closure": {
            "closed": "the values come from agents and tools that add new ones; a reader at an earlier minor reads a value it does not know as unknown",
            "reopens": "a minor that adds a member; a reader at the earlier minor takes it for unknown",
            "mark": "extensible"
          }
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "derived_from": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "A SHA-256, in lower-case hex.",
            "maxLength": 8192
          },
          "description": "The hashes of the files this one was made from."
        },
        "step_times": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "step": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
              },
              "start_ms": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "end_ms": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "step",
              "start_ms",
              "end_ms"
            ],
            "additionalProperties": false
          },
          "description": "For a recording: where each step starts and ends."
        }
      },
      "required": [
        "sha256",
        "kind",
        "type",
        "size",
        "origin",
        "redaction",
        "license",
        "derived_from",
        "step_times"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$",
        "description": "A SHA-256, in lower-case hex."
      }
    }
  },
  "required": [
    "v",
    "id",
    "kind",
    "writer",
    "actor",
    "scope",
    "ts",
    "data"
  ],
  "additionalProperties": false
}
