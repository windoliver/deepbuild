{
  "title": "decision.revoked@1",
  "description": "A decision you saved was revoked on the trusted path: from then on it covers nothing, and a resolver that names it is refused. Only the core appends it.",
  "x-since": "R1",
  "x-stability": "stable",
  "x-feeds": [
    "decisions"
  ],
  "type": "object",
  "properties": {
    "v": {
      "const": 1,
      "description": "The kind's schema version."
    },
    "id": {
      "type": "string",
      "format": "ulid",
      "description": "The event's ULID, its identity."
    },
    "kind": {
      "const": "decision.revoked"
    },
    "subject": {
      "type": "string",
      "pattern": "^(task|ask|claim|verdict|run|req|decision|plan|lease|reading|notice|doc|ev|session):[0-9A-Za-z]+(#[A-Za-z0-9][A-Za-z0-9._-]*)?$",
      "description": "The record object this event is about."
    },
    "writer": {
      "const": "core",
      "description": "Only the core appends this kind."
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "description": "The person behind it, from the credential."
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "description": "Who may see it."
    },
    "ts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Milliseconds since the Unix epoch."
    },
    "seq": {
      "type": "string",
      "format": "seq",
      "description": "Order within the session: ns since the epoch when the hook started."
    },
    "log_pos": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Its position in the event log, assigned by the hub at append."
    },
    "data": {
      "type": "object",
      "properties": {
        "decision": {
          "type": "string",
          "pattern": "^decision:[0-9A-Za-z]+$",
          "description": "The decision revoked, by its handle.",
          "maxLength": 8192
        }
      },
      "required": [
        "decision"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$",
        "description": "A SHA-256, in lower-case hex."
      }
    }
  },
  "required": [
    "v",
    "id",
    "kind",
    "writer",
    "actor",
    "scope",
    "ts",
    "data"
  ],
  "additionalProperties": false
}
