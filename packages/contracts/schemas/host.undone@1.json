              "change",
              "undo"
            ],
            "additionalProperties": false
          },
          "description": "Each change undone, in the order its undo ran."
        },
        "left": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "ulid",
                "description": "The host.changed event it undoes or leaves, by its id."
              },
              "change": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192,
                "description": "What that change did, its host.changed's change."
              },
              "undo": {
                "type": "string",
                "minLength": 1,
