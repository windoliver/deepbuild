{
  "title": "learn.proposed@1",
  "description": "DeepBuild proposed a change to the learned layer.",
  "x-feeds": [
    "learned_layer"
  ],
  "type": "object",
  "properties": {
    "v": {
      "const": 1,
      "description": "The kind's schema version."
    },
    "id": {
      "type": "string",
      "format": "ulid",
      "description": "The event's ULID, its identity."
    },
    "kind": {
      "const": "learn.proposed"
    },
    "subject": {
      "type": "string",
      "pattern": "^(task|ask|claim|verdict|run|req|decision|plan|lease|reading|notice|doc|ev|session):[0-9A-Za-z]+(#[A-Za-z0-9][A-Za-z0-9._-]*)?$",
      "description": "The record object this event is about."
    },
    "writer": {
      "type": "string",
      "pattern": "^(hook|app|cli|core|mcp:[^\\s]+|ext:[^\\s]+)$",
      "description": "Who wrote it, from the connection, never the payload."
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "description": "The person behind it, from the credential."
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "description": "Who may see it."
    },
    "ts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Milliseconds since the Unix epoch."
    },
    "seq": {
      "type": "string",
      "format": "seq",
      "description": "Order within the session: ns since the epoch when the hook started."
    },
    "log_pos": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Its position in the event log, assigned by the hub at append."
    },
    "data": {
      "type": "object",
      "properties": {
        "layer": {
          "type": "string",
          "enum": [
            "learned",
            "base"
          ],
          "description": "base only for changes you make; learning cannot write it."
        },
        "target": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "diff": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "at": {
                "type": "string",
                "pattern": "^(task|ask|claim|verdict|run|req|decision|plan|lease|reading|notice|doc|ev|session):[0-9A-Za-z]+(#[A-Za-z0-9][A-Za-z0-9._-]*)?$",
                "description": "A record handle.",
                "maxLength": 8192
              },
              "quote": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
              }
            },
            "required": [
              "at",
              "quote"
            ],
            "additionalProperties": false
          }
        },
        "scope": {
          "type": "string",
          "pattern": "^(session:[0-9A-Za-z]+|repo:[0-9A-Za-z]+|all)$",
          "description": "Where it applies: session:<id>, then repo:<id>, then all.",
          "maxLength": 8192
        },
        "replay": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "tasks": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "regressions": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "tasks",
            "regressions"
          ],
          "additionalProperties": false
        },
        "applied_by": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(you|rule:[0-9A-Za-z]+)$",
          "description": "You, or the rule that applied it; never an agent.",
          "maxLength": 8192
        },
        "supersedes": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(task|ask|claim|verdict|run|req|decision|plan|lease|reading|notice|doc|ev|session):[0-9A-Za-z]+(#[A-Za-z0-9][A-Za-z0-9._-]*)?$",
          "description": "A record handle.",
          "maxLength": 8192
        }
      },
      "required": [
        "layer",
        "target",
        "diff",
        "evidence",
        "scope",
        "replay",
        "applied_by",
        "supersedes"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$",
        "description": "A SHA-256, in lower-case hex."
      }
    }
  },
  "required": [
    "v",
    "id",
    "kind",
    "writer",
    "actor",
    "scope",
    "ts",
    "data"
  ],
  "additionalProperties": false
}
