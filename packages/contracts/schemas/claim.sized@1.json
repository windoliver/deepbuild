{
  "title": "claim.sized@1",
  "description": "A claim measured for size and scope with no model (#324): its lines and files against its base, the usual size it was compared with, and what it brought outside its plan with where each came from: dependencies, top-level folders, changed files no check reaches and a document's items by stable ID; with what this stop sent back.",
  "x-since": "R1",
  "x-stability": "stable",
  "x-feeds": [],
  "type": "object",
  "properties": {
    "v": {
      "const": 1,
      "description": "The kind's schema version."
    },
    "id": {
      "type": "string",
      "format": "ulid",
      "description": "The event's ULID, its identity."
    },
    "kind": {
      "const": "claim.sized"
    },
    "subject": {
      "type": "string",
      "pattern": "^(task|ask|claim|verdict|run|req|decision|plan|lease|reading|notice|doc|ev|session):[0-9A-Za-z]+(#[A-Za-z0-9][A-Za-z0-9._-]*)?$",
      "description": "The record object this event is about."
    },
    "writer": {
      "type": "string",
      "pattern": "^(hook|app|cli|core|ext:[^\\s]+)$",
      "description": "Who wrote it, from the connection; never an agent through MCP, since no deep_* tool produces this kind."
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "description": "The person behind it, from the credential."
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "description": "Who may see it."
    },
    "ts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Milliseconds since the Unix epoch."
    },
    "seq": {
      "type": "string",
      "format": "seq",
      "description": "Order within the session: ns since the epoch when the hook started."
    },
    "log_pos": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Its position in the event log, assigned by the hub at append."
    },
    "data": {
      "type": "object",
      "properties": {
        "claim": {
          "type": "string",
          "pattern": "^claim:[0-9A-Za-z]+$",
          "description": "A claim: handle.",
          "maxLength": 8192
        },
        "task_ref": {
          "type": "string",
          "pattern": "^(task:[0-9A-Za-z]+|session:[0-9A-Za-z]+#[A-Za-z0-9][A-Za-z0-9._-]*)$",
          "description": "The task: a task handle, or the message that asked for it.",
          "maxLength": 8192
        },
        "kind": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 8192,
          "description": "The kind of issue the task is, which picks the accepted changes it is compared with; null when unknown."
        },
        "lines": {
          "type": "object",
          "properties": {
            "added": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "removed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "added",
            "removed"
          ],
          "additionalProperties": false
        },
        "files": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "usual": {
          "type": [
            "object",
            "null"
          ],
          "description": "The median of the last 20 accepted changes of the same kind in the repo, lines added and removed together.",
          "properties": {
            "lines": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "files": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "n": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "How many accepted changes it is the median of."
            }
          },
          "required": [
            "lines",
            "files",
            "n"
          ],
          "additionalProperties": false
        },
        "over": {
          "type": "boolean",
          "description": "Past twice the usual lines or files."
        },
        "biggest": {
          "type": "array",
          "description": "The largest files of the change, by lines added and removed.",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
              },
              "lines": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "path",
              "lines"
            ],
            "additionalProperties": false
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
              },
              "from": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192,
                "description": "The file it came from."
              }
            },
            "required": [
              "name",
              "from"
            ],
            "additionalProperties": false
          },
          "description": "Dependencies added that the plan does not name, each with the manifest it came from."
        },
        "folders": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
              },
              "from": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192,
                "description": "The file it came from."
              }
            },
            "required": [
              "name",
              "from"
            ],
            "additionalProperties": false
          },
          "description": "Top-level folders added that the plan does not name, each with the first file in it."
        },
        "unreached": {
          "type": [
            "array",
            "null"
          ],
          "description": "Changed files neither the plan nor any check of the claim reaches; null while a check has not run.",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          }
        },
        "items": {
          "type": "array",
          "description": "A document's items its revisions added, changed or removed that neither the plan nor a requirement names, by stable ID.",
          "items": {
            "type": "object",
            "properties": {
              "doc": {
                "type": "string",
                "pattern": "^doc:[0-9A-Za-z]+$",
                "maxLength": 8192
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
              },
              "change": {
                "type": "string",
                "enum": [
                  "added",
                  "changed",
                  "removed"
                ],
                "x-closure": {
                  "closed": "each value is a state the record defines and every reader acts on, so a value outside the list has no meaning",
                  "reopens": "a new major of this schema",
                  "mark": "exhaustive"
                }
              }
            },
            "required": [
              "doc",
              "id",
              "change"
            ],
            "additionalProperties": false
          }
        },
        "sent_back": {
          "type": "array",
          "description": "What this stop sent back, once each: size, and file:, dependency:, folder: or item: with its name.",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          }
        },
        "asked": {
          "type": "array",
          "description": "What this stop brought to you as one taste call, once each, after it was sent back: keyed as sent_back is.",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          }
        }
      },
      "required": [
        "claim",
        "task_ref",
        "kind",
        "lines",
        "files",
        "usual",
        "over",
        "biggest",
        "dependencies",
        "folders",
        "unreached",
        "items",
        "sent_back",
        "asked"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$",
        "description": "A SHA-256, in lower-case hex."
      }
    }
  },
  "required": [
    "v",
    "id",
    "kind",
    "writer",
    "actor",
    "scope",
    "ts",
    "data"
  ],
  "additionalProperties": false
}
