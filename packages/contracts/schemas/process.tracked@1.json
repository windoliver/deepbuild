{
  "title": "process.tracked@1",
  "description": "A process a run owns, by ID and start time: the one the supervisor started, and each one it saw appear in the run's sandbox or process group.",
  "x-since": "R1",
  "x-stability": "stable",
  "x-feeds": [],
  "type": "object",
  "properties": {
    "v": {
      "const": 1,
      "description": "The kind's schema version."
    },
    "id": {
      "type": "string",
      "format": "ulid",
      "description": "The event's ULID, its identity."
    },
    "kind": {
      "const": "process.tracked"
    },
    "subject": {
      "type": "string",
      "pattern": "^(task|ask|claim|verdict|run|req|decision|plan|lease|reading|notice|doc|ev|session):[0-9A-Za-z]+(#[A-Za-z0-9][A-Za-z0-9._-]*)?$",
      "description": "The record object this event is about."
    },
    "writer": {
      "const": "core",
      "description": "Only the core appends this kind."
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "description": "The person behind it, from the credential."
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "description": "Who may see it."
    },
    "ts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Milliseconds since the Unix epoch."
    },
    "seq": {
      "type": "string",
      "format": "seq",
      "description": "Order within the session: ns since the epoch when the hook started."
    },
    "log_pos": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Its position in the event log, assigned by the hub at append."
    },
    "data": {
      "type": "object",
      "properties": {
        "run": {
          "type": "string",
          "pattern": "^run:[0-9A-Za-z]+$",
          "description": "A run: handle.",
          "maxLength": 8192
        },
        "pid": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647,
          "description": "A process ID."
        },
        "start": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "description": "Its start time as `ps -o lstart=` prints it under LC_ALL=C: how it is told apart from a reused ID."
        },
        "pgid": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647,
          "description": "A process ID."
        },
        "cwd": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "description": "The working folder of the run that owns it."
        },
        "token": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$",
          "maxLength": 8192,
          "description": "The SHA-256 of the run token in its environment when it was tracked, or null when it had none."
        }
      },
      "required": [
        "run",
        "pid",
        "start",
        "pgid",
        "cwd",
        "token"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$",
        "description": "A SHA-256, in lower-case hex."
      }
    }
  },
  "required": [
    "v",
    "id",
    "kind",
    "writer",
    "actor",
    "scope",
    "ts",
    "data"
  ],
  "additionalProperties": false
}
