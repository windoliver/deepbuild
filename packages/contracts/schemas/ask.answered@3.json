{
  "title": "ask.answered@3",
  "description": "You answered an ask. Only the core appends it, from the trusted path. It says where the answer came from (the card, deep inbox answer, or text typed in the session, which is unverified), the revision the ask showed, which it is recorded as answered on, the click token an approval bound, and, from the question card, your words and the screenshot you sent with the answer (#327), kept beside its decision and never saved as one.",
  "$defs": {
    "pinned_to": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "commit"
            },
            "ref": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$",
              "maxLength": 8192
            }
          },
          "required": [
            "kind",
            "ref"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "doc_revision"
            },
            "ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            }
          },
          "required": [
            "kind",
            "ref"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "evidence"
            },
            "ref": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "description": "A SHA-256, in lower-case hex.",
              "maxLength": 8192
            }
          },
          "required": [
            "kind",
            "ref"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "x-feeds": [
    "asks"
  ],
  "type": "object",
  "properties": {
    "v": {
      "const": 3,
      "description": "The kind's schema version."
    },
    "id": {
      "type": "string",
      "format": "ulid",
      "description": "The event's ULID, its identity."
    },
    "kind": {
      "const": "ask.answered"
    },
    "subject": {
      "type": "string",
      "pattern": "^ask:[0-9A-Za-z]+$",
      "description": "The ask this event is about."
    },
    "writer": {
      "const": "core",
      "description": "Only the core appends this kind."
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "description": "The person behind it, from the credential."
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "description": "Who may see it."
    },
    "ts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Milliseconds since the Unix epoch."
    },
    "seq": {
      "type": "string",
      "format": "seq",
      "description": "Order within the session: ns since the epoch when the hook started."
    },
    "log_pos": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Its position in the event log, assigned by the hub at append."
    },
    "data": {
      "type": "object",
      "properties": {
        "answer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "plan_hash": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$",
          "description": "A SHA-256, in lower-case hex.",
          "maxLength": 8192
        },
        "decision": {
          "type": "string",
          "enum": [
            "allow",
            "deny",
            "none"
          ],
          "x-closure": {
            "closed": "each value is a state the record defines and every reader acts on, so a value outside the list has no meaning",
            "reopens": "a new major of this schema",
            "mark": "exhaustive"
          }
        },
        "via": {
          "type": "string",
          "enum": [
            "card",
            "inbox",
            "session"
          ],
          "description": "Where the answer came from: the question card, deep inbox answer, or text typed in the session.",
          "x-closure": {
            "closed": "each value is a state the record defines and every reader acts on, so a value outside the list has no meaning",
            "reopens": "a new major of this schema",
            "mark": "exhaustive"
          }
        },
        "verified": {
          "type": "boolean",
          "description": "False for text typed in the session, which another agent or tool may have typed."
        },
        "on": {
          "$ref": "#/$defs/pinned_to",
          "description": "The revision the ask showed, which the answer is recorded as answered on."
        },
        "token": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 8192,
          "description": "The click token an approval bound, or null."
        },
        "words": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 8192,
          "description": "Your own words sent with the answer from the question card: its reason beside an option, or the whole answer with none (then decision is none). null when you typed nothing."
        },
        "image": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$",
          "maxLength": 8192,
          "description": "The SHA-256, in lower-case hex, of a screenshot sent with the answer, stored in evidence; null without one."
        }
      },
      "required": [
        "answer",
        "plan_hash",
        "decision",
        "via",
        "verified",
        "on",
        "token",
        "words",
        "image"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$",
        "description": "A SHA-256, in lower-case hex."
      }
    }
  },
  "required": [
    "v",
    "id",
    "kind",
    "subject",
    "writer",
    "actor",
    "scope",
    "ts",
    "data"
  ],
  "additionalProperties": false
}
