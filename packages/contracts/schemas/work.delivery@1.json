{
  "title": "work.delivery@1",
  "description": "A result delivered back to the work source it came from (#66), one event per step: recorded, asked (waiting on your authority ask), claimed (synced before the request goes out), sent, tried (answered and not taken; it is tried again), gone (the target can never take it), refused (you said no) or unknown (no answer and no way to find out).",
  "x-since": "R2",
  "x-stability": "preview",
  "x-tracking": "#66",
  "x-preview_since": "R2",
  "x-decide_by": "R5",
  "x-feeds": [],
  "type": "object",
  "properties": {
    "v": {
      "const": 1,
      "description": "The kind's schema version."
    },
    "id": {
      "type": "string",
      "format": "ulid",
      "description": "The event's ULID, its identity."
    },
    "kind": {
      "const": "work.delivery"
    },
    "subject": {
      "type": "string",
      "pattern": "^(task|ask|claim|verdict|run|req|decision|plan|lease|reading|notice|doc|ev|session):[0-9A-Za-z]+(#[A-Za-z0-9][A-Za-z0-9._-]*)?$",
      "description": "The record object this event is about."
    },
    "writer": {
      "const": "core",
      "description": "Only the core appends this kind."
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "description": "The person behind it, from the credential."
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "description": "Who may see it."
    },
    "ts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Milliseconds since the Unix epoch."
    },
    "seq": {
      "type": "string",
      "format": "seq",
      "description": "Order within the session: ns since the epoch when the hook started."
    },
    "log_pos": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Its position in the event log, assigned by the hub at append."
    },
    "data": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "description": "The send key, which the delivery carries as a marker the provider keeps."
        },
        "task_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "description": "The task whose result it is."
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "description": "The work source's handle."
        },
        "thread": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "description": "The item's ID at its source: the thread the delivery goes into."
        },
        "phase": {
          "type": "string",
          "enum": [
            "recorded",
            "asked",
            "claimed",
            "sent",
            "tried",
            "gone",
            "refused",
            "unknown"
          ],
          "description": "The step this event records.",
          "x-closure": {
            "closed": "a delivery is recorded, asked for, claimed, then sent, tried again, gone, refused or unknown",
            "reopens": "a new major of this kind",
            "mark": "exhaustive"
          }
        },
        "detail": {
          "x-opaque": "the step's own facts: the text recorded, the ask, the rule, the cause",
          "description": "The step's facts."
        }
      },
      "required": [
        "key",
        "task_ref",
        "source",
        "thread",
        "phase",
        "detail"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$",
        "description": "A SHA-256, in lower-case hex."
      }
    }
  },
  "required": [
    "v",
    "id",
    "kind",
    "writer",
    "actor",
    "scope",
    "ts",
    "data"
  ],
  "additionalProperties": false
}
