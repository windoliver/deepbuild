{
  "title": "approval.held@1",
  "description": "Your yes to a step that can't be undone was answered, and the hub holds the step for 10 s before it starts, the card's receipt counting the hold down with Undo. Its end is approval.started, or approval.withdrawn when you pressed Undo inside the hold or the hub started again during it. Only the core appends it.",
  "x-since": "R2",
  "x-stability": "stable",
  "x-feeds": [
    "asks"
  ],
  "type": "object",
  "properties": {
    "v": {
      "const": 1,
      "description": "The kind's schema version."
    },
    "id": {
      "type": "string",
      "format": "ulid",
      "description": "The event's ULID, its identity."
    },
    "kind": {
      "const": "approval.held"
    },
    "subject": {
      "type": "string",
      "pattern": "^(task|ask|claim|verdict|run|req|decision|plan|lease|reading|notice|doc|ev|session):[0-9A-Za-z]+(#[A-Za-z0-9][A-Za-z0-9._-]*)?$",
      "description": "The record object this event is about."
    },
    "writer": {
      "const": "core",
      "description": "Only the core appends this kind."
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "description": "The person behind it, from the credential."
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "description": "Who may see it."
    },
    "ts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Milliseconds since the Unix epoch."
    },
    "seq": {
      "type": "string",
      "format": "seq",
      "description": "Order within the session: ns since the epoch when the hook started."
    },
    "log_pos": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Its position in the event log, assigned by the hub at append."
    },
    "data": {
      "type": "object",
      "properties": {
        "until": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "When the steps start, in ms since the Unix epoch: your yes plus the 10 s hold."
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8192,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "description": "The steps held, each as its plan says what it does."
        }
      },
      "required": [
        "until",
        "steps"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$",
        "description": "A SHA-256, in lower-case hex."
      }
    }
  },
  "required": [
    "v",
    "id",
    "kind",
    "subject",
    "writer",
    "actor",
    "scope",
    "ts",
    "data"
  ],
  "additionalProperties": false
}
