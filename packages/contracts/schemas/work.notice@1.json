{
  "title": "work.notice@1",
  "description": "A standing run's weekly notice (#1335): what it landed, what is left and what it spent in the week, needing no answer. Only the core appends it.",
  "x-since": "R1",
  "x-stability": "stable",
  "x-feeds": [],
  "type": "object",
  "properties": {
    "v": {
      "const": 1,
      "description": "The kind's schema version."
    },
    "id": {
      "type": "string",
      "format": "ulid",
      "description": "The event's ULID, its identity."
    },
    "kind": {
      "const": "work.notice"
    },
    "subject": {
      "type": "string",
      "pattern": "^(task|ask|claim|verdict|run|req|decision|plan|lease|reading|notice|doc|ev|session):[0-9A-Za-z]+(#[A-Za-z0-9][A-Za-z0-9._-]*)?$",
      "description": "The record object this event is about."
    },
    "writer": {
      "const": "core",
      "description": "Only the core appends this kind."
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "description": "The person behind it, from the credential."
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "description": "Who may see it."
    },
    "ts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Milliseconds since the Unix epoch."
    },
    "seq": {
      "type": "string",
      "format": "seq",
      "description": "Order within the session: ns since the epoch when the hook started."
    },
    "log_pos": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Its position in the event log, assigned by the hub at append."
    },
    "data": {
      "type": "object",
      "properties": {
        "ask": {
          "type": "string",
          "pattern": "^ask:[0-9A-Za-z]+$",
          "maxLength": 8192,
          "description": "The run's approval: the start.approve ask it was raised as."
        },
        "from": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "The week it covers, from: ms since the epoch."
        },
        "to": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "The week it covers, until: ms since the epoch."
        },
        "landed": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991,
            "description": "The issue."
          },
          "description": "The issues whose change landed in the week."
        },
        "left": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "issue": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991,
                "description": "The issue."
              },
              "word": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192,
                "description": "Its state word now."
              }
            },
            "required": [
              "issue",
              "word"
            ],
            "additionalProperties": false
          },
          "description": "The run's issues still to land, each with its state word."
        },
        "spent": {
          "type": "object",
          "properties": {
            "attempts": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "The attempts it started in the week."
            },
            "sessions": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "The sessions those attempts ran."
            },
            "usd": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "description": "What those sessions' usage says they cost, where priced; null when none was."
            },
            "tokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "The tokens their usage counts."
            }
          },
          "required": [
            "attempts",
            "sessions",
            "usd",
            "tokens"
          ],
          "additionalProperties": false,
          "description": "What it spent in the week."
        }
      },
      "required": [
        "ask",
        "from",
        "to",
        "landed",
        "left",
        "spent"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$",
        "description": "A SHA-256, in lower-case hex."
      }
    }
  },
  "required": [
    "v",
    "id",
    "kind",
    "writer",
    "actor",
    "scope",
    "ts",
    "data"
  ],
  "additionalProperties": false
}
