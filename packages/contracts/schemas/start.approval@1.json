{
  "title": "start.approval@1",
  "description": "Your approval of a run of sessions DeepBuild may start without your Send (#1330), as asked: the authority ask it waits on, and its bounds. It counts only once that ask is answered yes on the trusted path.",
  "x-since": "R1",
  "x-stability": "stable",
  "x-feeds": [],
  "type": "object",
  "properties": {
    "v": {
      "const": 1,
      "description": "The kind's schema version."
    },
    "id": {
      "type": "string",
      "format": "ulid",
      "description": "The event's ULID, its identity."
    },
    "kind": {
      "const": "start.approval"
    },
    "subject": {
      "type": "string",
      "pattern": "^(task|ask|claim|verdict|run|req|decision|plan|lease|reading|notice|doc|ev|session):[0-9A-Za-z]+(#[A-Za-z0-9][A-Za-z0-9._-]*)?$",
      "description": "The record object this event is about."
    },
    "writer": {
      "const": "core",
      "description": "Only the core appends this kind."
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "description": "The person behind it, from the credential."
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "description": "Who may see it."
    },
    "ts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Milliseconds since the Unix epoch."
    },
    "seq": {
      "type": "string",
      "format": "seq",
      "description": "Order within the session: ns since the epoch when the hook started."
    },
    "log_pos": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Its position in the event log, assigned by the hub at append."
    },
    "data": {
      "type": "object",
      "properties": {
        "ask": {
          "type": "string",
          "pattern": "^ask:[0-9A-Za-z]+$",
          "description": "An ask: handle.",
          "maxLength": 8192
        },
        "repo": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "description": "The repo's checkout, a real path."
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "minItems": 1,
          "description": "The set: the issues a start may name."
        },
        "agents": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "minItems": 1,
          "description": "The agents a start may run, by their facts' names."
        },
        "homes": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "description": "The account home each agent runs in, by agent; one not named runs in its default home.",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9-]*$"
          }
        },
        "modes": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "description": "The permission mode each agent may run in, by agent; one not named runs only in its mode that asks before acting.",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9-]*$"
          }
        },
        "at_once": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "description": "How many of its sessions may run at once."
        },
        "plan_share": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "The share of each account's plan window, in percent, past which no new start begins."
        },
        "until": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Its end, in ms since the epoch, or null for none."
        },
        "hosts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "description": "The hosts a session's commands may reach, beside the agent's own API."
        },
        "sandbox": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "sandboxed": {
                "type": "boolean",
                "description": "Whether it runs inside its agent's own sandbox; false for a version whose facts name none."
              },
              "walls": {
                "type": "object",
                "properties": {
                  "writes": {
                    "type": "boolean"
                  },
                  "credentials": {
                    "type": "boolean"
                  },
                  "network": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "writes",
                  "credentials",
                  "network"
                ],
                "additionalProperties": false,
                "description": "Each wall the agent's own sandbox holds, as its facts name them: writes held to the worktree and temp folders, credential folders unreadable, the network held to the hosts the approval names. One its facts don't name is false."
              }
            },
            "required": [
              "sandboxed",
              "walls"
            ],
            "additionalProperties": false
          },
          "description": "What each agent's own sandbox holds at the version installed when you were asked, by agent.",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9-]*$"
          }
        }
      },
      "required": [
        "ask",
        "repo",
        "issues",
        "agents",
        "homes",
        "modes",
        "at_once",
        "plan_share",
        "until",
        "hosts",
        "sandbox"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$",
        "description": "A SHA-256, in lower-case hex."
      }
    }
  },
  "required": [
    "v",
    "id",
    "kind",
    "writer",
    "actor",
    "scope",
    "ts",
    "data"
  ],
  "additionalProperties": false
}
