{
  "title": "review.settled@1",
  "description": "A claim on a pull request settled, passing (#1862): how each item its review rounds sent back ended, fixed by the first later commit that changed a line it cites, or left, decided by the commit the claim settled on. A reading, never a pass or a fail.",
  "x-since": "R1",
  "x-stability": "stable",
  "x-feeds": [],
  "type": "object",
  "properties": {
    "v": {
      "const": 1,
      "description": "The kind's schema version."
    },
    "id": {
      "type": "string",
      "format": "ulid",
      "description": "The event's ULID, its identity."
    },
    "kind": {
      "const": "review.settled"
    },
    "subject": {
      "type": "string",
      "pattern": "^(task|ask|claim|verdict|run|req|decision|plan|lease|reading|notice|doc|ev|session):[0-9A-Za-z]+(#[A-Za-z0-9][A-Za-z0-9._-]*)?$",
      "description": "The record object this event is about."
    },
    "writer": {
      "const": "core",
      "description": "Only the core appends this kind."
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "description": "The person behind it, from the credential."
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "description": "Who may see it."
    },
    "ts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Milliseconds since the Unix epoch."
    },
    "seq": {
      "type": "string",
      "format": "seq",
      "description": "Order within the session: ns since the epoch when the hook started."
    },
    "log_pos": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Its position in the event log, assigned by the hub at append."
    },
    "data": {
      "type": "object",
      "properties": {
        "pr": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "description": "The pull request, by its link."
        },
        "claim": {
          "type": "string",
          "pattern": "^claim:[0-9A-Za-z]+$",
          "maxLength": 8192,
          "description": "The claim that settled."
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$",
          "maxLength": 8192,
          "description": "The commit the claim settled on."
        },
        "outcomes": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "object",
            "properties": {
              "rule": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192,
                "description": "The rubric's rule."
              },
              "sites": {
                "type": "array",
                "minItems": 1,
                "maxItems": 4096,
                "items": {
                  "type": "object",
                  "properties": {
                    "file": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 8192,
                      "description": "The file, as the diff names it."
                    },
                    "line": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991,
                      "description": "The line in the commit the round read."
                    },
                    "quote": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 8192,
                      "description": "The text at that line."
                    }
                  },
                  "required": [
                    "file",
                    "line",
                    "quote"
                  ],
                  "additionalProperties": false
                },
                "description": "Every site of the rule the round cited."
              },
              "ended": {
                "type": "string",
                "enum": [
                  "fixed",
                  "left"
                ],
                "description": "Fixed, a later commit changed a line it cites; or left.",
                "x-closure": {
                  "closed": "the two ways a sent-back item ends",
                  "reopens": "a new major of this schema",
                  "mark": "exhaustive"
                }
              },
              "commit": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$",
                "maxLength": 8192,
                "description": "The commit that decided it: the one that changed a cited line, or the one the claim settled on."
              }
            },
            "required": [
              "rule",
              "sites",
              "ended",
              "commit"
            ],
            "additionalProperties": false
          },
          "description": "Each sent-back item with how it ended."
        }
      },
      "required": [
        "pr",
        "claim",
        "commit",
        "outcomes"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$",
        "description": "A SHA-256, in lower-case hex."
      }
    }
  },
  "required": [
    "v",
    "id",
    "kind",
    "writer",
    "actor",
    "scope",
    "ts",
    "data"
  ],
  "additionalProperties": false
}
