{
  "title": "verdict.made@1",
  "description": "The verdict engine made a verdict. Only the core appends it.",
  "$defs": {
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "req": {
            "type": "string",
            "pattern": "^req:[0-9A-Za-z]+#R[1-9][0-9]*$",
            "description": "A requirement: req:<definition>#R<n>.",
            "maxLength": 8192
          },
          "outcome": {
            "type": "string",
            "enum": [
              "PASS",
              "FAIL",
              "INVALID",
              "BLOCKED",
              "INCONCLUSIVE",
              "pending"
            ],
            "x-closure": {
              "closed": "each value is a state the record defines and every reader acts on, so a value outside the list has no meaning",
              "reopens": "a new major of this schema",
              "mark": "exhaustive"
            }
          },
          "check": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "depth": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "oracle": {
            "type": "string",
            "enum": [
              "code",
              "model",
              "person"
            ],
            "description": "Who judges it: code, a model or a person.",
            "x-closure": {
              "closed": "each value is a state the record defines and every reader acts on, so a value outside the list has no meaning",
              "reopens": "a new major of this schema",
              "mark": "exhaustive"
            }
          },
          "runs": {
            "type": "object",
            "properties": {
              "clean": {
                "type": "integer",
                "minimum": 0,
                "maximum": 65535
              },
              "needed": {
                "type": "integer",
                "minimum": 0,
                "maximum": 65535
              },
              "counted": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^run:[0-9A-Za-z]+$",
                  "description": "A run: handle.",
                  "maxLength": 8192
                }
              }
            },
            "required": [
              "clean",
              "needed",
              "counted"
            ],
            "additionalProperties": false
          },
          "smallest": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 8192
          },
          "points_to": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 8192
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "description": "A SHA-256, in lower-case hex.",
              "maxLength": 8192
            }
          },
          "proof": {
            "type": "string",
            "enum": [
              "statement",
              "static_check",
              "test_run",
              "journey",
              "decision"
            ],
            "x-closure": {
              "closed": "each value is a state the record defines and every reader acts on, so a value outside the list has no meaning",
              "reopens": "a new major of this schema",
              "mark": "exhaustive"
            }
          },
          "ask": {
            "type": "string",
            "pattern": "^ask:[0-9A-Za-z]+$",
            "description": "An ask: handle.",
            "maxLength": 8192
          }
        },
        "required": [
