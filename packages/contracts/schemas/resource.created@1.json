{
  "title": "resource.created@1",
  "description": "A session's command created an outside resource the repo's spec declares, which gets a teardown task (#342). Only the core appends it.",
  "x-since": "R1",
  "x-stability": "stable",
  "x-feeds": [],
  "type": "object",
  "properties": {
    "v": {
      "const": 1,
      "description": "The kind's schema version."
    },
    "id": {
      "type": "string",
      "format": "ulid",
      "description": "The event's ULID, its identity."
    },
    "kind": {
      "const": "resource.created"
    },
    "subject": {
      "type": "string",
      "pattern": "^(task|ask|claim|verdict|run|req|decision|plan|lease|reading|notice|doc|ev|session):[0-9A-Za-z]+(#[A-Za-z0-9][A-Za-z0-9._-]*)?$",
      "description": "The record object this event is about."
    },
    "writer": {
      "const": "core",
      "description": "Only the core appends this kind."
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "description": "The person behind it, from the credential."
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "description": "Who may see it."
    },
    "ts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Milliseconds since the Unix epoch."
    },
    "seq": {
      "type": "string",
      "format": "seq",
      "description": "Order within the session: ns since the epoch when the hook started."
    },
    "log_pos": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Its position in the event log, assigned by the hub at append."
    },
    "data": {
      "type": "object",
      "properties": {
        "resource": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "maxLength": 8192,
          "description": "The resource's identity: a SHA-256 of its kind and key. Its teardown task is pinned to it."
        },
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "description": "The kind's name in done.yaml's resources."
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "description": "What the command's output named it; absent when it named none."
        },
        "cost_usd": {
          "type": "number",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Its price in US dollars, as the spec gives it."
        },
        "check": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "description": "The check that proves it gone."
        },
        "cwd": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "description": "The folder the session worked in, whose spec holds the check."
        }
      },
      "required": [
        "resource",
        "kind",
        "cost_usd",
        "check",
        "cwd"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$",
        "description": "A SHA-256, in lower-case hex."
      }
    }
  },
  "required": [
    "v",
    "id",
    "kind",
    "writer",
    "actor",
    "scope",
    "ts",
    "data"
  ],
  "additionalProperties": false
}
