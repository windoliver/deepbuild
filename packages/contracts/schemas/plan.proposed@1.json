{
  "title": "plan.proposed@1",
  "description": "A plan was proposed for an authority ask.",
  "x-feeds": [
    "plans"
  ],
  "type": "object",
  "properties": {
    "v": {
      "const": 1,
      "description": "The kind's schema version."
    },
    "id": {
      "type": "string",
      "format": "ulid",
      "description": "The event's ULID, its identity."
    },
    "kind": {
      "const": "plan.proposed"
    },
    "subject": {
      "type": "string",
      "pattern": "^(task|ask|claim|verdict|run|req|decision|plan|lease|reading|notice|doc|ev|session):[0-9A-Za-z]+(#[A-Za-z0-9][A-Za-z0-9._-]*)?$",
      "description": "The record object this event is about."
    },
    "writer": {
      "type": "string",
      "pattern": "^(hook|app|cli|core|mcp:[^\\s]+|ext:[^\\s]+)$",
      "description": "Who wrote it, from the connection, never the payload."
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "description": "The person behind it, from the credential."
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "description": "Who may see it."
    },
    "ts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Milliseconds since the Unix epoch."
    },
    "seq": {
      "type": "string",
      "format": "seq",
      "description": "Order within the session: ns since the epoch when the hook started."
    },
    "log_pos": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Its position in the event log, assigned by the hub at append."
    },
    "data": {
      "type": "object",
      "properties": {
        "ask": {
          "type": "string",
          "pattern": "^ask:[0-9A-Za-z]+$",
          "description": "A ask: handle.",
          "maxLength": 8192
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "does": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
              },
              "changes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8192
                }
              },
              "undo": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
              },
              "public": {
                "type": "boolean"
              },
              "cost": {
                "type": "number",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "does",
              "changes",
              "undo",
              "public",
              "cost"
            ],
            "additionalProperties": false
          }
        },
        "diff": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "A SHA-256, in lower-case hex.",
          "maxLength": 8192
        },
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "A SHA-256, in lower-case hex.",
          "maxLength": 8192
        }
      },
      "required": [
        "ask",
        "steps",
        "diff",
        "hash"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$",
        "description": "A SHA-256, in lower-case hex."
      }
    }
  },
  "required": [
    "v",
    "id",
    "kind",
    "writer",
    "actor",
    "scope",
    "ts",
    "data"
  ],
  "additionalProperties": false
}
