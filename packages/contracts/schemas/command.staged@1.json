{
  "title": "command.staged@1",
  "description": "A destructive command whose reach can't be worked out had the folders it names staged as a copy-on-write copy before it ran, so the run can be undone from the copy (deep undo staged:<id>) until the copy is let go.",
  "x-feeds": [
    "sessions"
  ],
  "type": "object",
  "properties": {
    "v": {
      "const": 1,
      "description": "The kind's schema version."
    },
    "id": {
      "type": "string",
      "format": "ulid",
      "description": "The event's ULID, its identity."
    },
    "kind": {
      "const": "command.staged"
    },
    "subject": {
      "type": "string",
      "pattern": "^(task|ask|claim|verdict|run|req|decision|plan|lease|reading|notice|doc|ev|session):[0-9A-Za-z]+(#[A-Za-z0-9][A-Za-z0-9._-]*)?$",
      "description": "The record object this event is about."
    },
    "writer": {
      "const": "core",
      "description": "Only the core appends this kind."
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "description": "The person behind it, from the credential."
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "description": "Who may see it."
    },
    "ts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Milliseconds since the Unix epoch."
    },
    "seq": {
      "type": "string",
      "format": "seq",
      "description": "Order within the session: ns since the epoch when the hook started."
    },
    "log_pos": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Its position in the event log, assigned by the hub at append."
    },
    "data": {
      "type": "object",
      "properties": {
        "call": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "description": "The tool call it was staged for, by the agent's tool_use_id: the call its tool.before carries."
        },
        "command": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "description": "The command, as the agent sent it."
        },
        "folders": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "maxItems": 256,
          "description": "The absolute folders staged, in the order the copy holds them."
        },
        "until": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "When the copy is let go, in ms on the hub's clock: the event's ts plus staging.keep."
        }
      },
      "required": [
        "call",
        "command",
        "folders",
        "until"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$",
        "description": "A SHA-256, in lower-case hex."
      }
    }
  },
  "required": [
    "v",
    "id",
    "kind",
    "writer",
    "actor",
    "scope",
    "ts",
    "data"
  ],
  "additionalProperties": false
}
