{
  "title": "definition.locked@2",
  "description": "A definition of done was locked: its hash, the issue's revision and the base commit, each requirement with its author and its check's approved bytes by digest. Only the core appends it.",
  "x-feeds": [
    "definitions"
  ],
  "type": "object",
  "properties": {
    "v": {
      "const": 2,
      "description": "The kind's schema version."
    },
    "id": {
      "type": "string",
      "format": "ulid",
      "description": "The event's ULID, its identity."
    },
    "kind": {
      "const": "definition.locked"
    },
    "subject": {
      "type": "string",
      "pattern": "^(task|ask|claim|verdict|run|req|decision|plan|lease|reading|notice|doc|ev|session):[0-9A-Za-z]+(#[A-Za-z0-9][A-Za-z0-9._-]*)?$",
      "description": "The record object this event is about."
    },
    "writer": {
      "const": "core",
      "description": "Only the core appends this kind."
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "description": "The person behind it, from the credential."
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "description": "Who may see it."
    },
    "ts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Milliseconds since the Unix epoch."
    },
    "seq": {
      "type": "string",
      "format": "seq",
      "description": "Order within the session: ns since the epoch when the hook started."
    },
    "log_pos": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Its position in the event log, assigned by the hub at append."
    },
    "data": {
      "type": "object",
      "properties": {
        "definition": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "A SHA-256, in lower-case hex.",
          "maxLength": 8192
        },
        "task_ref": {
          "type": "string",
          "pattern": "^(task:[0-9A-Za-z]+|session:[0-9A-Za-z]+#[A-Za-z0-9][A-Za-z0-9._-]*)$",
          "description": "The task: a task handle, or the message that asked for it (session:<id>#<message>).",
          "maxLength": 8192
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^R[1-9][0-9]*$",
                "maxLength": 8192
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
              },
              "source_line": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192,
                "description": "The line of text the requirement came from: ask#L<n> for a line of the prompt, <source_id>#L<n> for a line of a work item."
              },
              "refuted_by": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192,
                "description": "The observation that would refute it, so it can fail."
              },
              "check": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1,
                "maxLength": 8192,
                "description": "The check that judges it, a path in the repo; null for a requirement left without one."
              },
              "check_sha256": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[0-9a-f]{64}$",
                "description": "The SHA-256 of the check's bytes as approved at the lock, kept by digest in the hub; null with no check, or a check that wasn't there.",
                "maxLength": 8192
              },
              "on_base": {
                "type": "string",
                "enum": [
                  "fails",
                  "fails_sometimes",
                  "passes"
                ],
                "description": "What its check must do on the base commit.",
                "x-closure": {
                  "closed": "each value is a state the record defines and every reader acts on, so a value outside the list has no meaning",
                  "reopens": "a new major of this schema",
                  "mark": "exhaustive"
                }
              },
              "asserts": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8192
                },
                "description": "The assertions in its check that carry the requirement, by file and line, step ID or deadline."
              },
              "depth": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
              },
              "oracle": {
                "type": "string",
                "enum": [
                  "code",
                  "model",
                  "person"
                ],
                "description": "Who judges it: code, a model or a person.",
                "x-closure": {
                  "closed": "each value is a state the record defines and every reader acts on, so a value outside the list has no meaning",
                  "reopens": "a new major of this schema",
                  "mark": "exhaustive"
                }
              },
              "near_misses": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8192
                },
                "description": "For a requirement without a check: the existing checks that came closest, and why each falls short."
              },
              "author": {
                "type": "object",
                "description": "Who wrote the text it came from, with the role their work source's work.item@1 reading gives them, never one read from the text.",
                "properties": {
                  "handle": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 8192
                  },
                  "role": {
                    "type": "string",
                    "enum": [
                      "you",
                      "owner",
                      "collaborator",
                      "outside"
                    ],
                    "description": "you for your prompt; otherwise the work source's membership record.",
                    "x-closure": {
                      "closed": "each value is a state the record defines and every reader acts on, so a value outside the list has no meaning",
                      "reopens": "a new major of this schema",
                      "mark": "exhaustive"
                    }
                  }
                },
                "required": [
                  "handle",
                  "role"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "text",
              "source_line",
              "refuted_by",
              "check",
              "check_sha256",
              "on_base",
              "asserts",
              "depth",
              "oracle",
              "near_misses",
              "author"
            ],
            "additionalProperties": false
          }
        },
        "deliverables": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "description": "What the work must deliver, each a path or a name."
        },
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "A SHA-256, in lower-case hex.",
          "maxLength": 8192
        },
        "issue_rev": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "description": "The issue's revision the definition was drafted from: a work item's updated time, or the prompt's digest for a message."
        },
        "base_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$",
          "maxLength": 8192
        },
        "budget": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "runs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            },
            "cap_usd": {
              "type": "number",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "runs",
            "cap_usd"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "definition",
        "task_ref",
        "requirements",
        "deliverables",
        "hash",
        "issue_rev",
        "base_commit",
        "budget"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$",
        "description": "A SHA-256, in lower-case hex."
      }
    }
  },
  "required": [
    "v",
    "id",
    "kind",
    "writer",
    "actor",
    "scope",
    "ts",
    "data"
  ],
  "additionalProperties": false
}
