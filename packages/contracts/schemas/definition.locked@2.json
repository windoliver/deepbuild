{
  "title": "definition.locked@2",
  "description": "A definition of done was locked, with its hash, the issue's revision and the base commit; each requirement keeps its author at the role the work source gave, and each check file its approved digest. Only the core appends it.",
  "x-feeds": [
    "definitions"
  ],
  "type": "object",
  "properties": {
    "v": {
      "const": 2,
      "description": "The kind's schema version."
    },
    "id": {
      "type": "string",
      "format": "ulid",
      "description": "The event's ULID, its identity."
    },
    "kind": {
      "const": "definition.locked"
    },
    "subject": {
      "type": "string",
      "pattern": "^(task|ask|claim|verdict|run|req|decision|plan|lease|reading|notice|doc|ev|session):[0-9A-Za-z]+(#[A-Za-z0-9][A-Za-z0-9._-]*)?$",
      "description": "The record object this event is about."
    },
    "writer": {
      "const": "core",
      "description": "Only the core appends this kind."
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "description": "The person behind it, from the credential."
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "description": "Who may see it."
    },
    "ts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Milliseconds since the Unix epoch."
    },
    "seq": {
      "type": "string",
      "format": "seq",
      "description": "Order within the session: ns since the epoch when the hook started."
    },
    "log_pos": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Its position in the event log, assigned by the hub at append."
    },
    "data": {
      "type": "object",
      "properties": {
        "definition": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "A SHA-256, in lower-case hex.",
          "maxLength": 8192
        },
        "task_ref": {
          "type": "string",
          "pattern": "^(task:[0-9A-Za-z]+|session:[0-9A-Za-z]+#[A-Za-z0-9][A-Za-z0-9._-]*)$",
          "description": "The task: a task handle, or the message that asked for it (session:<id>#<message>).",
          "maxLength": 8192
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^R[1-9][0-9]*$",
                "maxLength": 8192
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
              },
              "checks": {
                "type": "array",
                "description": "The check files the requirement names, each with the digest of the bytes approved at the lock.",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 8192
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$",
                      "description": "A SHA-256, in lower-case hex.",
                      "maxLength": 8192
                    }
                  },
                  "required": [
                    "path",
                    "sha256"
                  ],
                  "additionalProperties": false
                }
              },
              "oracle": {
                "type": "string",
                "enum": [
                  "code",
                  "model",
                  "person"
                ],
                "description": "Who judges it: code, a model or a person.",
                "x-closure": {
                  "closed": "each value is a state the record defines and every reader acts on, so a value outside the list has no meaning",
                  "reopens": "a new major of this schema",
                  "mark": "exhaustive"
                }
              },
              "depth": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
              },
              "author": {
                "type": "object",
                "description": "The author of the text the requirement came from, at the role its work source's work.item@1 reading gives that author, never a role read from the text.",
                "properties": {
                  "handle": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 8192
                  },
                  "role": {
                    "type": "string",
                    "enum": [
                      "owner",
                      "collaborator",
                      "outside"
                    ],
                    "description": "The author's standing in the repo, from the provider's membership record.",
                    "x-closure": {
                      "closed": "each value is a state the record defines and every reader acts on, so a value outside the list has no meaning",
                      "reopens": "a new major of this schema",
                      "mark": "exhaustive"
                    }
                  }
                },
                "required": [
                  "handle",
                  "role"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "text",
              "author",
              "checks",
              "oracle",
              "depth"
            ],
            "additionalProperties": false
          }
        },
        "deliverables": {
          "type": "array",
          "description": "What the task must leave behind, by path.",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          }
        },
        "issue_rev": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "description": "The revision of the issue the definition was drafted from."
        },
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "A SHA-256, in lower-case hex.",
          "maxLength": 8192
        },
        "base_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$",
          "maxLength": 8192
        },
        "budget": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "runs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            },
            "cap_usd": {
              "type": "number",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "runs",
            "cap_usd"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "definition",
        "task_ref",
        "requirements",
        "deliverables",
        "issue_rev",
        "hash",
        "base_commit",
        "budget"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$",
        "description": "A SHA-256, in lower-case hex."
      }
    }
  },
  "required": [
    "v",
    "id",
    "kind",
    "writer",
    "actor",
    "scope",
    "ts",
    "data"
  ],
  "additionalProperties": false
}
