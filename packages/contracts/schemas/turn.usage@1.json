{
  "title": "turn.usage@1",
  "description": "What a turn, or the session so far, spent: tokens by the agent's own count, a cost only with its basis, and the model that actually answered.",
  "x-feeds": [
    "sessions"
  ],
  "type": "object",
  "properties": {
    "v": {
      "const": 1,
      "description": "The kind's schema version."
    },
    "id": {
      "type": "string",
      "format": "ulid",
      "description": "The event's ULID, its identity."
    },
    "kind": {
      "const": "turn.usage"
    },
    "subject": {
      "type": "string",
      "pattern": "^session:[0-9A-Za-z]+$",
      "description": "The session this event is about."
    },
    "writer": {
      "type": "string",
      "pattern": "^(hook|app|cli|core|ext:[^\\s]+)$",
      "description": "Who wrote it, from the connection; never an agent through MCP, since no deep_* tool produces this kind."
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "description": "The person behind it, from the credential."
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "description": "Who may see it."
    },
    "ts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Milliseconds since the Unix epoch."
    },
    "seq": {
      "type": "string",
      "format": "seq",
      "description": "Order within the session: ns since the epoch when the hook started."
    },
    "log_pos": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Its position in the event log, assigned by the hub at append."
    },
    "data": {
      "type": "object",
      "properties": {
        "turn": {
          "type": "string",
          "minLength": 1,
          "description": "The turn it covers, or the last turn of a session reading.",
          "maxLength": 8192
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "description": "The model that actually answered, never the one asked for.",
          "maxLength": 8192
        },
        "covers": {
          "type": "string",
          "enum": [
            "turn",
            "session"
          ],
          "description": "Per turn, or cumulative for the session so far."
        },
        "tokens": {
          "type": "object",
          "properties": {
            "input": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "cached": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "output": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "exact": {
              "type": "boolean",
              "description": "The agent's own count, or an estimate."
            }
          },
          "required": [
            "input",
            "cached",
            "output",
            "exact"
          ],
          "additionalProperties": false
        },
        "cost": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "basis": {
                  "const": "reported"
                },
                "usd": {
                  "type": "number",
                  "minimum": 0,
                  "description": "What the agent itself reported; a free tier reports 0."
                }
              },
              "required": [
                "basis",
                "usd"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "basis": {
                  "const": "estimated"
                },
                "usd": {
                  "type": "number",
                  "minimum": 0
                },
                "rate_card": {
                  "type": "string",
                  "minLength": 1,
                  "description": "The rate card the estimate came from.",
                  "maxLength": 8192
                }
              },
              "required": [
                "basis",
                "usd",
                "rate_card"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "basis": {
                  "const": "unpriced"
                }
              },
              "required": [
                "basis"
              ],
              "additionalProperties": false,
              "description": "No amount at all: a plan that reports tokens only is never stored as $0."
            }
          ]
        },
        "context": {
          "type": "object",
          "properties": {
            "used": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "window": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "used",
            "window"
          ],
          "additionalProperties": false,
          "description": "How full the context window is; absent when not captured, never zero."
        }
      },
      "required": [
        "turn",
        "model",
        "covers",
        "tokens",
        "cost"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$",
        "description": "A SHA-256, in lower-case hex."
      }
    }
  },
  "required": [
    "v",
    "id",
    "kind",
    "subject",
    "writer",
    "actor",
    "scope",
    "ts",
    "data"
  ],
  "additionalProperties": false
}
