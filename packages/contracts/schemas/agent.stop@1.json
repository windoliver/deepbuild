{
  "title": "agent.stop@1",
  "description": "The agent stopped a turn.",
  "x-feeds": [
    "claims"
  ],
  "type": "object",
  "properties": {
    "v": {
      "const": 1,
      "description": "The kind's schema version."
    },
    "id": {
      "type": "string",
      "format": "ulid",
      "description": "The event's ULID, its identity."
    },
    "kind": {
      "const": "agent.stop"
    },
    "subject": {
      "type": "string",
      "pattern": "^session:[0-9A-Za-z]+$",
      "description": "The session this event is about."
    },
    "writer": {
      "const": "hook",
      "description": "Only deep-hook appends this kind, from the agent's hook; never an agent through MCP."
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "description": "The person behind it, from the credential."
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "description": "Who may see it."
    },
    "ts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Milliseconds since the Unix epoch."
    },
    "seq": {
      "type": "string",
      "format": "seq",
      "description": "Order within the session: ns since the epoch when the hook started."
    },
    "log_pos": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Its position in the event log, assigned by the hub at append."
    },
    "data": {
      "type": "object",
      "properties": {
        "turn": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "did_work": {
          "type": "boolean"
        }
      },
      "required": [
        "turn",
        "did_work"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$",
        "description": "A SHA-256, in lower-case hex."
      }
    }
  },
  "required": [
    "v",
    "id",
    "kind",
    "subject",
    "writer",
    "actor",
    "scope",
    "ts",
    "data"
  ],
  "additionalProperties": false
}
