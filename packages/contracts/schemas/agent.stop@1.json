{
  "title": "agent.stop@1",
  "description": "The agent stopped a turn.",
  "x-feeds": [
    "claims"
  ],
  "type": "object",
  "properties": {
    "v": {
      "const": 1,
      "description": "The kind's schema version."
    },
    "id": {
      "type": "string",
      "format": "ulid",
      "description": "The event's ULID, its identity."
    },
    "kind": {
      "const": "agent.stop"
    },
    "subject": {
      "type": "string",
      "pattern": "^session:[0-9A-Za-z]+$",
      "description": "The session this event is about."
    },
    "writer": {
      "type": "string",
      "pattern": "^(hook|app|cli|core|ext:[^\\s]+)$",
      "description": "Who wrote it, from the connection; never an agent through MCP, since no deep_* tool produces this kind."
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "description": "The person behind it, from the credential."
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "description": "Who may see it."
    },
    "ts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Milliseconds since the Unix epoch."
    },
    "seq": {
      "type": "string",
      "format": "seq",
      "description": "Order within the session: ns since the epoch when the hook started."
    },
    "log_pos": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Its position in the event log, assigned by the hub at append."
    },
    "data": {
      "type": "object",
      "properties": {
        "turn": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "did_work": {
          "type": "boolean"
        },
        "cause": {
          "type": "string",
          "enum": [
            "sign_in_required",
            "token_refresh_failed",
            "plan_window_spent",
            "rate_limited",
            "refusal",
            "max_turns",
            "context_overflow",
            "tool_schema_rejected",
            "agent_crashed",
            "timed_out",
            "unknown"
          ],
          "description": "Why the turn stopped, read from the payload, never from the agent's text; a stop nothing explains is unknown, never a pass."
        },
        "reset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "With plan_window_spent: when the window resets, in ms since the Unix epoch."
        }
      },
      "required": [
        "turn",
        "did_work"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$",
        "description": "A SHA-256, in lower-case hex."
      }
    }
  },
  "required": [
    "v",
    "id",
    "kind",
    "subject",
    "writer",
    "actor",
    "scope",
    "ts",
    "data"
  ],
  "additionalProperties": false
}
