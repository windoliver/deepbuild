{
  "title": "definition.drafted@1",
  "description": "A definition of done was drafted, without the session's work.",
  "x-feeds": [
    "definitions"
  ],
  "type": "object",
  "properties": {
    "v": {
      "const": 1,
      "description": "The kind's schema version."
    },
    "id": {
      "type": "string",
      "format": "ulid",
      "description": "The event's ULID, its identity."
    },
    "kind": {
      "const": "definition.drafted"
    },
    "subject": {
      "type": "string",
      "pattern": "^(task|ask|claim|verdict|run|req|decision|plan|lease|reading|notice|doc|ev|session):[0-9A-Za-z]+(#[A-Za-z0-9][A-Za-z0-9._-]*)?$",
      "description": "The record object this event is about."
    },
    "writer": {
      "type": "string",
      "pattern": "^(hook|app|cli|core|mcp:[^\\s]+|ext:[^\\s]+)$",
      "description": "Who wrote it, from the connection, never the payload."
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "description": "The person behind it, from the credential."
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "description": "Who may see it."
    },
    "ts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Milliseconds since the Unix epoch."
    },
    "seq": {
      "type": "string",
      "format": "seq",
      "description": "Order within the session: ns since the epoch when the hook started."
    },
    "log_pos": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Its position in the event log, assigned by the hub at append."
    },
    "data": {
      "type": "object",
      "properties": {
        "definition": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "A SHA-256, in lower-case hex."
        },
        "task_ref": {
          "type": "string",
          "pattern": "^task:[0-9A-Za-z]+$",
          "description": "A task: handle."
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^R[1-9][0-9]*$"
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "checks": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "oracle": {
                "type": "string",
                "enum": [
                  "code",
                  "model",
                  "person"
                ],
                "description": "Who judges it: code, a model or a person."
              },
              "depth": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "text",
              "checks",
              "oracle",
              "depth"
            ],
            "additionalProperties": false
          }
        },
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "A SHA-256, in lower-case hex."
        },
        "base_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "budget": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "runs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            },
            "cap_usd": {
              "type": "number",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "runs",
            "cap_usd"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "definition",
        "task_ref",
        "requirements",
        "hash",
        "base_commit",
        "budget"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$",
        "description": "A SHA-256, in lower-case hex."
      }
    }
  },
  "required": [
    "v",
    "id",
    "kind",
    "writer",
    "actor",
    "scope",
    "ts",
    "data"
  ],
  "additionalProperties": false
}
