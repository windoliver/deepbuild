    "pinned_to": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "commit"
            },
            "ref": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$",
              "maxLength": 8192
            }
          },
