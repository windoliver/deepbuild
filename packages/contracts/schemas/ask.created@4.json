    "subject_effect": {
      "type": "object",
      "description": "An authority ask's subject: the effect class, its target and the change it carries.",
      "properties": {
        "effect": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "description": "The effect class, such as push, merge or permission."
        },
