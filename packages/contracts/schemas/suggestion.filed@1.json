{
  "title": "suggestion.filed@1",
  "description": "A suggestion was filed on your item.",
  "x-feeds": [
    "suggestions"
  ],
  "type": "object",
  "properties": {
    "v": {
      "const": 1,
      "description": "The kind's schema version."
    },
    "id": {
      "type": "string",
      "format": "ulid",
      "description": "The event's ULID, its identity."
    },
    "kind": {
      "const": "suggestion.filed"
    },
    "subject": {
      "type": "string",
      "pattern": "^(task|ask|claim|verdict|run|req|decision|plan|lease|reading|notice|doc|ev|session):[0-9A-Za-z]+(#[A-Za-z0-9][A-Za-z0-9._-]*)?$",
      "description": "The record object this event is about."
    },
    "writer": {
      "type": "string",
      "pattern": "^(hook|app|cli|core|mcp:[^\\s]+|ext:[^\\s]+)$",
      "description": "Who wrote it, from the connection, never the payload."
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "description": "The person behind it, from the credential."
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "description": "Who may see it."
    },
    "ts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Milliseconds since the Unix epoch."
    },
    "seq": {
      "type": "string",
      "format": "seq",
      "description": "Order within the session: ns since the epoch when the hook started."
    },
    "log_pos": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Its position in the event log, assigned by the hub at append."
    },
    "data": {
      "type": "object",
      "properties": {
        "suggestion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "doc": {
          "type": "string",
          "pattern": "^doc:[0-9A-Za-z]+$",
          "description": "A doc: handle.",
          "maxLength": 8192
        },
        "item": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,47}(\\.[a-z0-9][a-z0-9_-]{0,47}){0,7}$",
          "description": "An item's ID in its document.",
          "maxLength": 8192
        },
        "writer": {
          "type": "string",
          "pattern": "^(hook|app|cli|core|mcp:[^\\s]+|ext:[^\\s]+)$",
          "description": "Who wrote it, from the connection, as the envelope writes a writer.",
          "maxLength": 8192
        },
        "patch": {
          "type": "string",
          "format": "ulid"
        },
        "base": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "ops": {
          "type": "array",
          "items": {
            "x-opaque": "a document op, as the Patch primitive gives it; the document checks it"
          }
        }
      },
      "required": [
        "suggestion",
        "doc",
        "item",
        "writer",
        "patch",
        "base",
        "ops"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$",
        "description": "A SHA-256, in lower-case hex."
      }
    }
  },
  "required": [
    "v",
    "id",
    "kind",
    "writer",
    "actor",
    "scope",
    "ts",
    "data"
  ],
  "additionalProperties": false
}
