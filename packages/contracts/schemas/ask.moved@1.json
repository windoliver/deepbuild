{
  "title": "ask.moved@1",
  "description": "An open ask now shows another revision of what it is pinned to, such as a taste call's evidence with a picture replaced by a new hash (#3234). Only the core appends it. A card showing the ask presents it again, and a picture whose hash is new counts as not shown.",
  "x-since": "R1",
  "x-stability": "stable",
  "x-feeds": [
    "asks"
  ],
  "$defs": {
    "pinned_to": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "commit"
            },
            "ref": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$",
              "maxLength": 8192
            }
          },
          "required": [
            "kind",
            "ref"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "doc_revision"
            },
            "ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            }
          },
          "required": [
            "kind",
            "ref"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "evidence"
            },
            "ref": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "description": "A SHA-256, in lower-case hex.",
              "maxLength": 8192
            }
          },
          "required": [
            "kind",
            "ref"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "type": "object",
  "properties": {
    "v": {
      "const": 1,
      "description": "The kind's schema version."
    },
    "id": {
      "type": "string",
      "format": "ulid",
      "description": "The event's ULID, its identity."
    },
    "kind": {
      "const": "ask.moved"
    },
    "subject": {
      "type": "string",
      "pattern": "^ask:[0-9A-Za-z]+$",
      "description": "The ask this event is about."
    },
    "writer": {
      "const": "core",
      "description": "Only the core appends this kind."
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "description": "The person behind it, from the credential."
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "description": "Who may see it."
    },
    "ts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Milliseconds since the Unix epoch."
    },
    "seq": {
      "type": "string",
      "format": "seq",
      "description": "Order within the session: ns since the epoch when the hook started."
    },
    "log_pos": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Its position in the event log, assigned by the hub at append."
    },
    "data": {
      "type": "object",
      "properties": {
        "pinned_to": {
          "$ref": "#/$defs/pinned_to",
          "description": "What the ask shows from now on."
        }
      },
      "required": [
        "pinned_to"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$",
        "description": "A SHA-256, in lower-case hex."
      }
    }
  },
  "required": [
    "v",
    "id",
    "kind",
    "subject",
    "writer",
    "actor",
    "scope",
    "ts",
    "data"
  ],
  "additionalProperties": false
}
