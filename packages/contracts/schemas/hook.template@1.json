{
  "title": "hook.template@1",
  "description": "A hook context template an extension's manifest declares, under its `templates`: an extension outside DeepBuild's signed release adds context for the agent, and gives a deny's reason, only by filling one of these with typed values. Its text names each field as {field}.",
  "x-since": "R1",
  "x-stability": "stable",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "maxLength": 64,
      "description": "The template's name, which a handler's reply names."
    },
    "hook": {
      "type": "string",
      "enum": [
        "session.start",
        "tool.before",
        "tool.after",
        "prompt.submit",
        "agent.stop"
      ],
      "description": "The hook whose replies may fill it.",
      "x-closure": {
        "closed": "each value is an agent hook whose reply the host joins",
        "reopens": "a new major of this schema",
        "mark": "exhaustive"
      }
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "description": "The words the agent sees, each {field} replaced by its value."
    },
    "fields": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "handle",
                "description": "A record handle, <scheme>:<id>[#<fragment>]."
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "number",
                "description": "A finite number."
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "name",
                "description": "The extension's own name: its owner/name ID."
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "one_of",
                "description": "A value from the closed list `values`."
              },
              "values": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._-]*$",
                  "maxLength": 64
                }
              }
            },
            "required": [
              "type",
              "values"
            ],
            "additionalProperties": false
          }
        ]
      },
      "description": "Each field its text names, with the type of value it takes."
    }
  },
  "required": [
    "name",
    "hook",
    "text",
    "fields"
  ],
  "additionalProperties": false
}
