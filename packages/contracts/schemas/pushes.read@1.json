{
  "title": "pushes.read@1",
  "description": "What the hub read of a repo's default branch in GitHub's record of pushes (#2750): each ref change it hadn't read yet, with its time, its pusher and each commit it brought with its tree, and the tree of each verdict's snapshot that no push here brought. The reading of how each commit the default branch gained was judged is folded from these and the record's verdicts. The forge reports it, so an agent's word never writes it.",
  "x-since": "R2",
  "x-stability": "stable",
  "x-feeds": [],
  "type": "object",
  "properties": {
    "v": {
      "const": 1,
      "description": "The kind's schema version."
    },
    "id": {
      "type": "string",
      "format": "ulid",
      "description": "The event's ULID, its identity."
    },
    "kind": {
      "const": "pushes.read"
    },
    "subject": {
      "type": "string",
      "pattern": "^(task|ask|claim|verdict|run|req|decision|plan|lease|reading|notice|doc|ev|session):[0-9A-Za-z]+(#[A-Za-z0-9][A-Za-z0-9._-]*)?$",
      "description": "The record object this event is about."
    },
    "writer": {
      "const": "core",
      "description": "Only the core appends this kind."
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "description": "The person behind it, from the credential."
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "description": "Who may see it."
    },
    "ts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Milliseconds since the Unix epoch."
    },
    "seq": {
      "type": "string",
      "format": "seq",
      "description": "Order within the session: ns since the epoch when the hook started."
    },
    "log_pos": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Its position in the event log, assigned by the hub at append."
    },
    "data": {
      "type": "object",
      "properties": {
        "repo": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "description": "The forge's repository, owner/name."
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "description": "Its default branch, as the forge names it: refs/heads/main."
        },
        "as_of": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "When the forge was read, in ms since the Unix epoch: the reading's thirty days end here."
        },
        "pushes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991,
                "description": "The forge's ID for the ref change."
              },
              "at": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991,
                "description": "When the forge says the ref changed, in ms since the Unix epoch."
              },
              "pusher": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 8192,
                "description": "The account the forge recorded pushing it, or null when it recorded none."
              },
              "commits": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "object",
                  "properties": {
                    "commit": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{40}$",
                      "maxLength": 8192,
                      "description": "The commit's full SHA."
                    },
                    "tree": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{40}$",
                      "maxLength": 8192,
                      "description": "Its tree."
                    },
                    "reverts": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{40}$",
                      "maxLength": 8192,
                      "description": "The commit its message says it reverts, as git writes a revert."
                    }
                  },
                  "required": [
                    "commit",
                    "tree"
                  ],
                  "additionalProperties": false
                },
                "description": "The commits the change brought, oldest first; null when the forge refused to name them, so its date reads missing until a later read names them."
              }
            },
            "required": [
              "id",
              "at",
              "pusher",
              "commits"
            ],
            "additionalProperties": false
          },
          "description": "The default branch's ref changes of the last thirty days read this time: those no earlier read named the commits of."
        },
        "snapshots": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "commit": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$",
                "maxLength": 8192,
                "description": "A verdict's commit: the snapshot it judged."
              },
              "tree": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$",
                "maxLength": 8192,
                "description": "Its tree, read from the session's worktree or DeepBuild's own object store."
              }
            },
            "required": [
              "commit",
              "tree"
            ],
            "additionalProperties": false
          },
          "description": "The snapshots of this repo's verdicts whose tree was read this time: a commit with one of these trees was judged by that verdict."
        }
      },
      "required": [
        "repo",
        "ref",
        "as_of",
        "pushes",
        "snapshots"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$",
        "description": "A SHA-256, in lower-case hex."
      }
    }
  },
  "required": [
    "v",
    "id",
    "kind",
    "writer",
    "actor",
    "scope",
    "ts",
    "data"
  ],
  "additionalProperties": false
}
