{
  "title": "ci.archived@1",
  "description": "A completed CI run was copied from the forge before its retention deletes it: its result, and each job log as evidence.",
  "x-since": "R1",
  "x-stability": "stable",
  "x-feeds": [
    "evidence"
  ],
  "type": "object",
  "properties": {
    "v": {
      "const": 1,
      "description": "The kind's schema version."
    },
    "id": {
      "type": "string",
      "format": "ulid",
      "description": "The event's ULID, its identity."
    },
    "kind": {
      "const": "ci.archived"
    },
    "subject": {
      "type": "string",
      "pattern": "^(task|ask|claim|verdict|run|req|decision|plan|lease|reading|notice|doc|ev|session):[0-9A-Za-z]+(#[A-Za-z0-9][A-Za-z0-9._-]*)?$",
      "description": "The record object this event is about."
    },
    "writer": {
      "type": "string",
      "pattern": "^(hook|app|cli|core|ext:[^\\s]+)$",
      "description": "Who wrote it, from the connection; never an agent through MCP, since no deep_* tool produces this kind."
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "description": "The person behind it, from the credential."
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "description": "Who may see it."
    },
    "ts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Milliseconds since the Unix epoch."
    },
    "seq": {
      "type": "string",
      "format": "seq",
      "description": "Order within the session: ns since the epoch when the hook started."
    },
    "log_pos": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Its position in the event log, assigned by the hub at append."
    },
    "data": {
      "type": "object",
      "properties": {
        "repo": {
          "type": "string",
          "description": "The repository, owner/name.",
          "maxLength": 8192,
          "pattern": "^[^/\\s]+/[^/\\s]+$"
        },
        "run": {
          "type": "string",
          "description": "The forge's run ID.",
          "maxLength": 8192,
          "pattern": "^[0-9]+$"
        },
        "result": {
          "type": "string",
          "description": "The run's conclusion as the forge gave it, such as success or failure.",
          "maxLength": 8192,
          "minLength": 1
        },
        "logs": {
          "type": "array",
          "description": "Each job's log, by hash.",
          "maxItems": 1000,
          "items": {
            "type": "object",
            "properties": {
              "job": {
                "type": "string",
                "description": "The forge's job ID.",
                "maxLength": 8192,
                "pattern": "^[0-9]+$"
              },
              "evidence": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$",
                "description": "The job log copy's SHA-256, in lower-case hex.",
                "maxLength": 8192
              }
            },
            "required": [
              "job",
              "evidence"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "repo",
        "run",
        "result",
        "logs"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$",
        "description": "A SHA-256, in lower-case hex."
      }
    }
  },
  "required": [
    "v",
    "id",
    "kind",
    "writer",
    "actor",
    "scope",
    "ts",
    "data"
  ],
  "additionalProperties": false
}
