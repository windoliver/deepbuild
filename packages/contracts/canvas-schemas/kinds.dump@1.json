      "properties": {
        "name": {
          "type": "string"
        },
        "registry": {
          "type": "string"
        },
        "origin": {
          "type": "string"
        },
        "since": {
          "type": "string"
        },
        "stability": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        },
        "fields": {
