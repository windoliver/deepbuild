{
  "name": "@deepbuild/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": { "node": ">=24.22.0" },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "types": "./src/runtime.ts",
      "development": "./src/runtime.ts",
      "default": "./dist/runtime.js"
    },
    "./json": {
      "types": "./src/json.ts",
      "development": "./src/json.ts",
      "default": "./dist/json.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/built-escapes.mjs dist",
    "generate": "tsc -p tsconfig.json && node dist/generate.js"
  }
}
