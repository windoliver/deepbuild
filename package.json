    "preflight": "scripts/preflight",
    "release:check": "scripts/preflight --release"
  },
  "devDependencies": {
    "@stryker-mutator/core": "10.0.0",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.19.2",
    "fast-check": "4.10.2",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
