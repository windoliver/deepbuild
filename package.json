{
  "name": "deepbuild",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.22.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "bin": {
    "deep": "packages/cli/dist/main.js"
