            "permission_mode": "string",
            "prompt": "string",
            "session_id": "string",
            "transcript_path": "string|null",
            "turn_id": "string"
          },
          "optional": { "agent_id": "string", "agent_type": "string" }
        },
        "PreToolUse": {
          "required": {
            "cwd": "string",
            "hook_event_name": "string",
            "model": "string",
            "permission_mode": "string",
            "session_id": "string",
