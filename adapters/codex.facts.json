            "tool_use_id": "string",
            "transcript_path": "string|null",
            "turn_id": "string"
          },
          "optional": { "agent_id": "string", "agent_type": "string" },
          "tools": {
            "Bash": { "tool_input.command": "string" },
            "apply_patch": { "tool_input.command": "string" }
