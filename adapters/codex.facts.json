{
  "schema": "adapter.facts@1",
  "versions": ["0.144.0", "0.160.0", "0.163.0-alpha.10.2"],
  "agent": "codex",
  "hookTimeouts": {
    "readBy": "a hold waits no longer than the agent lets a hook run",
    "conformance": "codex/hookTimeouts/hold-within-timeout",
    "defaultMs": null,
    "perHook": { "Stop": 600000, "Interrupt": 1000 }
  },
  "continuation": {
    "readBy": "a stop hold continues a turn only while the payload says no stop hook already did; the cap is the design's",
    "conformance": "codex/continuation/stop-hook-active",
    "field": "stop_hook_active"
  },
  "signIn": {
    "readBy": "a run is BLOCKED until the agent is signed in",
    "conformance": "codex/signIn/login-status",
    "args": ["login", "status"],
    "signedIn": "exit code 0; the output is never kept"
  },
  "launch": {
    "readBy": "how DeepBuild starts the agent headless: a scripted session in a pseudo-terminal, a read-only job on stdin",
    "conformance": "codex/launch/flags",
    "readOnlyJob": {
      "readBy": "DeepBuild's own jobs: read-only sandbox, none of the user's config or MCP servers, no bypass flag, prompt on stdin",
      "args": [
        "exec",
        "--json",
        "-s",
        "read-only",
        "--skip-git-repo-check",
        "--ignore-user-config",
        "-m",
        "gpt-reserve",
        "-c",
        "model_reasoning_effort=\"low\"",
        "-"
      ],
      "prompt": "stdin"
    }
  },
  "modelFamily": {
    "readBy": "which rate card and context window a model name belongs to",
    "conformance": "codex/modelFamily/known-names",
    "families": { "gpt-reserve": "gpt-reserve", "gpt-reserve-mini": "gpt-reserve-mini" }
  },
  "billing": {
    "readBy": "whether a session bills a plan or an API account: set, these variables mean the API",
    "conformance": "codex/billing/api-key-variables",
    "apiKeyVariables": ["OPENAI_API_KEY"]
  },
  "usage": {
    "readBy": "every run prints its cost and is held to its cap",
    "conformance": "codex/usage/counting",
    "cost": "unpriced",
    "costFrom": "nothing: on a plan Codex reports tokens only, and no rate card is verified, so a token cap stands in for the cost cap",
    "tokens": "the rollout's last token_count info.total_token_usage; input_tokens includes cached_input_tokens, which is taken back out"
  },
  "questionTools": {
    "readBy": "which tool calls are questions to the person, so each one is caught as a permission request of kind question",
    "conformance": "codex/questionTools/question-is-a-request",
    "tools": []
  },
  "transcripts": {
    "readBy": "a run keeps its session's own rollout",
    "conformance": "codex/transcripts/folder",
    "home": ["CODEX_HOME", "~/.codex"],
    "path": "sessions/{YYYY}/{MM}/{DD}/rollout-{time}-{thread}.jsonl"
  },
  "appLinks": {
    "readBy": "Open on a session's row",
    "conformance": "codex/appLinks/open",
    "open": "none: the Codex app publishes no link that opens a thread"
  },
  "errorTexts": {
    "readBy": "a stop's cause from the error the agent reports, never from its words; a stop that matches none is unknown, never a pass",
    "conformance": "codex/errorTexts/unknown-otherwise",
    "causes": {}
  },
  "events": {
    "readBy": "each hook's strict payload schema per covered version, from Codex's published hook input schemas (codex-rs/hooks/schema/generated at the version's tag), with tool_input an object and a shell or apply_patch call's tool_input.command a string as recorded; a missing or retyped field, or an event not listed, reads unverified and the session's holds go watch-only, naming the field; an unlisted field is only a reading (#47)",
    "conformance": "codex/events/strict-payloads",
    "versions": {
