{
  "schema": "adapter.facts@4",
  "versions": ["0.144.0", "0.160.0", "0.163.0-alpha.10.2", "0.166.0-alpha.5.1"],
  "agent": "codex",
  "hookTimeouts": {
    "readBy": "a hold waits no longer than the agent lets a hook run",
    "conformance": "codex/hookTimeouts/hold-within-timeout",
    "defaultMs": null,
    "perHook": { "Stop": 600000, "Interrupt": 1000 }
  },
  "continuation": {
    "readBy": "a stop hold continues a turn only while the payload says no stop hook already did; the cap is the design's",
    "conformance": "codex/continuation/stop-hook-active",
    "field": "stop_hook_active"
  },
  "signIn": {
    "readBy": "a run is BLOCKED until the agent is signed in",
    "conformance": "codex/signIn/login-status",
    "args": ["login", "status"],
    "signedIn": "exit code 0; the output is never kept"
  },
  "launch": {
    "readBy": "how DeepBuild starts the agent headless: a scripted session in a pseudo-terminal, a read-only job on stdin",
    "conformance": "codex/launch/flags",
    "readOnlyJob": {
      "readBy": "DeepBuild's own jobs: Codex's sandbox off because macOS can't nest Seatbelt (exit 71, every command, reads too), so the supervisor's sandbox is what confines it; none of the user's config or MCP servers, prompt on stdin",
      "args": [
        "exec",
        "--json",
        "-s",
        "danger-full-access",
        "--skip-git-repo-check",
        "--ignore-user-config",
        "-m",
        "gpt-reserve",
        "-c",
        "model_reasoning_effort=\"low\"",
        "-"
      ],
      "prompt": "stdin"
    },
    "started": {
      "readBy": "a session DeepBuild starts under your approval (#1330): the unmodified CLI in a terminal the hub hosts, your words the prompt's argument and never typed in, its approval policy set at launch as TOML (the one that asks before acting unless the approval names another) and its sandbox's overrides beside it; the environment drops the variables that mark a nested session, and names the account's home only when it isn't the default",
      "args": ["-c", "approval_policy={mode}", "-c", "projects.\"{worktree}\".trust_level=\"trusted\"", "{sandbox}", "{prompt}"],
      "asks": "on-request",
      "modes": { "on-request": "\"on-request\"", "never": "\"never\"" },
      "skipping": ["never"],
      "nested": ["CODEX_SANDBOX", "CODEX_SANDBOX_NETWORK_DISABLED", "CODEX_THREAD_ID"],
      "home": "CODEX_HOME",
      "defaultHome": "~/.codex"
    }
  },
  "sandbox": {
    "readBy": "a session DeepBuild starts runs inside the agent's own sandbox (#1330): per version, the config overrides that turn it on (spliced where {sandbox} stands), the walls they hold, how the agent's way out is turned off, and the approval policy each mode takes under it. {filesystem} is a TOML inline table: your home read-only and each credential folder denied. A wall not named here is not held, and a version not listed starts with no sandbox and says so. Checked on 0.166.0-alpha.5.1 (spikes/1330): its trusted hooks run outside the sandbox and reach the hub",
    "conformance": "codex/sandbox/walls",
    "versions": {
      "0.166.0-alpha.5.1": {
        "args": [
          "-c",
          "default_permissions=\"deepbuild\"",
          "-c",
          "permissions.deepbuild.extends=\":workspace\"",
          "-c",
          "permissions.deepbuild.filesystem={filesystem}",
          "-c",
          "permissions.deepbuild.network.enabled=false"
        ],
        "modes": { "on-request": "{granular={sandbox_approval=false,rules=true,mcp_elicitations=true,request_permissions=true,skill_approval=true}}" },
        "walls": {
          "writes": "a command writes only its worktree and the temp folders, your home read-only: a profile extending :workspace",
          "credentials": "a command can't read the credential folders: each one \"deny\" in the profile's filesystem",
          "network": "a command reaches no host at all, the approval's hosts included, since naming hosts needs Codex's network proxy: the profile's network.enabled false; the agent's own API calls run outside its sandbox"
        },
        "wayOut": { "call": "sandbox_permissions require_escalated", "setting": "approval_policy granular sandbox_approval", "off": false }
      }
    }
  },
  "modelFamily": {
    "readBy": "which rate card and context window a model name belongs to",
    "conformance": "codex/modelFamily/known-names",
    "families": { "gpt-reserve": "gpt-reserve", "gpt-reserve-mini": "gpt-reserve-mini", "gpt-5-codex": "gpt-5-codex" }
  },
  "billing": {
    "readBy": "whether a session bills a plan or an API account: set, these variables mean the API",
    "conformance": "codex/billing/api-key-variables",
    "apiKeyVariables": ["OPENAI_API_KEY"]
  },
  "usage": {
    "readBy": "every run prints its cost and is held to its cap",
    "conformance": "codex/usage/counting",
    "cost": "unpriced",
    "costFrom": "nothing: on a plan Codex reports tokens only, and no rate card is verified, so a token cap stands in for the cost cap",
    "tokens": "the rollout's last token_count info.total_token_usage; input_tokens includes cached_input_tokens, which is taken back out"
  },
  "questionTools": {
    "readBy": "which tool calls are questions to the person: Codex fires PreToolUse for a request_user_input card, so each one is caught there as a permission request of kind question",
    "conformance": "codex/questionTools/question-is-a-request",
    "tools": ["request_user_input"]
  },
  "transcripts": {
    "readBy": "a run keeps its session's own rollout",
    "conformance": "codex/transcripts/folder",
    "home": ["CODEX_HOME", "~/.codex"],
    "path": "sessions/{YYYY}/{MM}/{DD}/rollout-{time}-{thread}.jsonl",
    "archived": "archived_sessions/rollout-{time}-{thread}.jsonl"
  },
  "appLinks": {
    "readBy": "Open on a session's row",
    "conformance": "codex/appLinks/open",
    "open": "none: the Codex app publishes no link that opens a thread. The same hooks' stop hold in the Codex app is unverified at app builds on 0.160.0 until a live run proves it (openai/codex#33992, openai/codex#47607); until then an app session's verdicts and answers may wait for its next prompt"
  },
  "errorTexts": {
    "readBy": "a stop's cause from the error the agent reports, never from its words; a stop that matches none is unknown, never a pass",
    "conformance": "codex/errorTexts/unknown-otherwise",
    "causes": {}
  },
  "events": {
    "readBy": "each hook's strict payload schema per covered version, from Codex's published hook input schemas (codex-rs/hooks/schema/generated at the version's tag), with tool_input an object and a shell or apply_patch call's tool_input.command a string as recorded; a missing or retyped field, or an event not listed, reads unverified and the session's holds go watch-only, naming the field; an unlisted field is only a reading (#47)",
