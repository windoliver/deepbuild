        "SessionStart": {
          "required": {
            "cwd": "string",
            "hook_event_name": "string",
            "model": "string",
            "permission_mode": "string",
            "session_id": "string",
            "source": "string",
            "transcript_path": "string|null"
          },
          "optional": {}
        },
        "UserPromptSubmit": {
