{
  "schema": "adapter.facts@6",
  "versions": ["2.1.299", "2.1.304", "2.1.308"],
  "agent": "claude",
  "hookTimeouts": {
    "readBy": "a hold waits no longer than the agent lets a hook run",
    "conformance": "claude/hookTimeouts/hold-within-timeout",
    "defaultMs": 60000,
    "perHook": { "Stop": 600000, "UserPromptSubmit": 30000 }
  },
  "routes": {
    "network": {
      "readBy": "deep-hook waits failOpenMs from the hook's start for a joined project's hub to acknowledge over its TLS connection, then decides as with the hub away; its fast rules stay local",
      "measured": "PreToolUse p95 647, 748 and 661 ms in three runs of ten (#1338 AC2), on a link holding every chunk 100 ms each way, three round trips: the TLS handshake, the hub's hello, the hook; this Mac at load 120 to 156, Nov 8 2026",
      "hookOverheadMs": 900,
      "failOpenMs": 1500
    }
  },
  "continuation": {
    "readBy": "a stop hold continues a turn at most cap times in a row, counted per turn and from its last tool call; past it, what would continue the turn goes by the next prompt",
    "conformance": "claude/continuation/stop-hook-active",
    "cap": 8,
    "field": "stop_hook_active"
  },
  "signIn": {
    "readBy": "a run is BLOCKED until the agent is signed in",
    "conformance": "claude/signIn/auth-status",
    "args": ["auth", "status"],
    "signedIn": "stdout is JSON with loggedIn true"
  },
  "launch": {
    "readBy": "how DeepBuild starts the agent headless: a scripted session in a pseudo-terminal, a read-only job on stdin",
    "conformance": "claude/launch/flags",
    "session": {
      "readBy": "scripted sessions run interactively in a pseudo-terminal, never with -p, which ends async hooks at teardown",
      "args": ["--model", "haiku", "--setting-sources", "project", "--strict-mcp-config", "--settings", "{settings}"]
    },
    "readOnlyJob": {
      "readBy": "DeepBuild's own jobs: only the MCP servers they need, none of the checkout's settings, no bypass flag, prompt on stdin",
      "args": [
        "-p",
        "--output-format",
        "stream-json",
        "--verbose",
        "--model",
        "haiku",
        "--strict-mcp-config",
        "--setting-sources",
        "user",
        "--permission-mode",
        "dontAsk"
      ],
      "prompt": "stdin"
    },
    "started": {
      "readBy": "a session DeepBuild starts under your approval (#1330): the unmodified CLI in a terminal the hub hosts, your words the prompt's argument and never typed in, its permission mode set at launch (the one that asks before acting unless the approval names another) and its sandbox's settings beside it; the environment drops the variables that mark a nested session, and names the account's home only when it isn't the default",
      "args": ["--permission-mode", "{mode}", "--settings", "{settings}", "{prompt}"],
      "asks": "default",
      "modes": { "default": "default", "acceptEdits": "acceptEdits", "plan": "plan", "dontAsk": "dontAsk", "bypassPermissions": "bypassPermissions" },
      "skipping": ["bypassPermissions"],
      "nested": ["CLAUDECODE", "CLAUDE_CODE_ENTRYPOINT", "CLAUDE_CODE_SSE_PORT", "CLAUDE_PROJECT_DIR"],
      "home": "CLAUDE_CONFIG_DIR",
      "defaultHome": "~/.claude",
      "trust": { "readBy": "the worktree a start made is one you approved, so it starts trusted: nothing types into the folder-trust dialog", "file": "~/.claude.json", "homeFile": ".claude.json", "set": "projects.{worktree}.hasTrustDialogAccepted" }
    }
  },
  "sandbox": {
    "readBy": "a session DeepBuild starts runs inside the agent's own sandbox (#1330): per version, the settings that turn it on, the walls they hold, and how the agent's way out is turned off. {credentials} is the folders no command may read, {hosts} the hosts the approval names, {sockets} the hub's socket. A wall not named here is not held, and a version not listed starts with no sandbox and says so. Checked on 2.1.308 (spikes/1330): its hooks run outside the sandbox and reach the hub",
    "conformance": "claude/sandbox/walls",
    "versions": {
      "2.1.308": {
        "settings": "{\"sandbox\":{\"enabled\":true,\"failIfUnavailable\":true,\"autoAllowBashIfSandboxed\":true,\"allowUnsandboxedCommands\":false,\"filesystem\":{\"denyRead\":\"{credentials}\"},\"network\":{\"allowedDomains\":\"{hosts}\",\"allowUnixSockets\":\"{sockets}\"}}}",
        "walls": {
          "writes": "a command writes only its worktree and the temp folders",
          "credentials": "a command can't read the credential folders: sandbox.filesystem.denyRead",
          "network": "a command reaches only the hosts the approval names: sandbox.network.allowedDomains; the agent's own API calls run outside its sandbox"
        },
        "wayOut": { "call": "dangerouslyDisableSandbox", "setting": "sandbox.allowUnsandboxedCommands", "off": false }
      }
    }
  },
  "modelFamily": {
    "readBy": "which rate card and context window a model name belongs to",
    "conformance": "claude/modelFamily/known-names",
    "families": { "claude-opus-5-5": "opus", "claude-sonnet-5-5": "sonnet", "claude-haiku-5-5": "haiku", "claude-fable-5-1": "fable", "claude-opus-4-1": "opus", "claude-sonnet-4-5": "sonnet", "claude-haiku-4-5": "haiku" }
  },
  "billing": {
    "readBy": "whether a session bills a plan or an API account: set, these variables mean the API",
    "conformance": "claude/billing/api-key-variables",
    "apiKeyVariables": ["ANTHROPIC_API_KEY"]
  },
  "usage": {
    "readBy": "every run prints its cost and is held to its cap",
    "conformance": "claude/usage/counting",
    "cost": "reported",
    "costFrom": "the status line's cost.total_cost_usd in a session, the result event's total_cost_usd in a job",
    "tokens": "assistant entries' message.usage, once per message.id, since each content block repeats it; input is input_tokens plus cache_creation_input_tokens, cached is cache_read_input_tokens"
  },
  "questionTools": {
    "readBy": "which tool calls are questions to the person, so each one is caught as a permission request of kind question",
    "conformance": "claude/questionTools/question-is-a-request",
    "tools": ["AskUserQuestion"]
  },
  "mods": {
    "readBy": "a mod that handles the overriding event can approve a call past a PreToolUse deny: deep doctor names each one a home loads, a PostToolUse for a call deep-hook denied is recorded as guard.overridden and keeps its session's claims from passing, and a session in a home with one reads its guard as watch-only unless a case below holds the deny",
    "conformance": "claude/mods/override-recorded",
    "since": { "terminal": "2.1.287", "desktop": "2.1.286" },
    "validate": { "args": ["plugin", "validate"], "hooks": "hooks:", "calls": "calls:" },
    "overrides": { "event": "tool.check", "past": "PreToolUse" },
    "promptCalls": ["$.prompt.submit"],
    "holdsWhen": [
      { "case": "managed", "text": "managed settings are present on the machine" },
      { "case": "login", "text": "the session's credential is a Team or Enterprise login", "subscriptionTypes": ["team", "enterprise"] },
      { "case": "plan", "text": "the session is in plan mode and the call isn't read-only", "mode": "plan" },
      { "case": "interactive", "text": "the call is AskUserQuestion or another tool that needs your interaction, from 2.1.292", "since": "2.1.292", "tools": ["AskUserQuestion"] }
    ]
  },
  "contextOutput": {
    "readBy": "the hub keeps each hook reply's injected text within capChars and sends the rest by handle with a line saying where to continue, and sends text the model needs only on an output these events mark model",
    "conformance": "context/reaches-model",
    "capChars": 10000,
    "previewChars": 2000,
    "versions": ["2.1.299", "2.1.304", "2.1.308"],
    "source": "code.claude.com/docs/en/hooks (Add context for Claude; exit code output), read Nov 9 2026 against 2.1.308: past the cap the text goes to a file in the session folder with a preview, and Claude isn't asked to read it",
    "events": {
      "SessionStart": { "additionalContext": "model", "systemMessage": "user", "stdout": "model", "stderr": "debug", "stderrOnBlock": "user" },
      "UserPromptSubmit": { "additionalContext": "model", "systemMessage": "user", "stdout": "model", "stderr": "debug", "stderrOnBlock": "user" },
      "PreToolUse": { "additionalContext": "model", "systemMessage": "user", "stdout": "debug", "stderr": "debug", "stderrOnBlock": "model" },
      "PermissionRequest": { "additionalContext": "none", "systemMessage": "user", "stdout": "debug", "stderr": "debug", "stderrOnBlock": "none" },
      "PostToolUse": { "additionalContext": "model", "systemMessage": "user", "stdout": "debug", "stderr": "debug", "stderrOnBlock": "model" },
      "PostToolUseFailure": { "additionalContext": "model", "systemMessage": "user", "stdout": "debug", "stderr": "debug", "stderrOnBlock": "model" },
      "Stop": { "additionalContext": "model", "systemMessage": "user", "stdout": "debug", "stderr": "debug", "stderrOnBlock": "model" },
      "SubagentStop": { "additionalContext": "model", "systemMessage": "user", "stdout": "debug", "stderr": "debug", "stderrOnBlock": "model" },
      "PostCompact": { "additionalContext": "none", "systemMessage": "none", "stdout": "debug", "stderr": "debug", "stderrOnBlock": "user" },
      "Notification": { "additionalContext": "none", "systemMessage": "none", "stdout": "debug", "stderr": "debug", "stderrOnBlock": "none" },
      "SessionEnd": { "additionalContext": "none", "systemMessage": "none", "stdout": "debug", "stderr": "debug", "stderrOnBlock": "user" }
    }
  },
  "transcripts": {
    "readBy": "a run keeps its session's own transcript",
    "conformance": "claude/transcripts/folder",
    "home": ["CLAUDE_CONFIG_DIR", "~/.claude"],
    "path": "projects/{cwd with each non-alphanumeric character as -}/{session}.jsonl"
  },
  "appLinks": {
    "readBy": "Open on a session's row",
    "conformance": "claude/appLinks/open",
    "open": "none: the Claude desktop app publishes no link that opens a session"
  },
  "errorTexts": {
    "readBy": "a stop's cause from the texts the agent writes, never from its words about them; Claude Code's StopFailure payload carries the error as a code instead, mapped by mapping.StopFailure.cause, so no text is matched",
    "conformance": "claude/errorTexts/unknown-otherwise",
    "causes": {}
  },
  "events": {
