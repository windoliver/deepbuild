  "mapping": {
    "readBy": "the adapter maps each hook payload to events by these entries, and deep explain names the entry behind each event (#47); a value names a payload field, or =text a constant; a hook that says the session waits on you or moved on (Notification, Elicitation, ElicitationResult) maps to a session.attention, its state from the payload field state names and no event for a value not listed (#992): a session-state signal, never an ask and never evidence",
    "conformance": "claude/mapping/explain",
    "common": { "session": "session_id", "subagent": "agent_id" },
    "SessionStart": {
      "kind": "session.start",
      "data": { "source": "source" }
    },
    "UserPromptSubmit": {
      "kind": "user.ask",
      "data": { "text": "prompt" },
      "origin": {
        "join": { "payload": "prompt_id", "transcript": "promptId" },
        "rules": [
          { "prompt": "The app was quit while you were working.", "from": "continuation" },
          {
            "match": { "origin.handback": true },
            "from": "subagent"
          },
          {
            "match": { "turnOrigin": "task_notification" },
            "from": "subagent"
          },
          {
            "match": { "turnOrigin": "peer" },
            "from": "session"
          },
          {
            "match": { "turnOrigin": "scheduled" },
            "from": "scheduled"
          },
          {
            "match": { "turnOrigin": "human" },
            "from": "person"
          }
        ],
        "otherwise": "unknown"
      }
    },
    "PreToolUse": {
      "kind": "tool.before",
      "data": { "call": "tool_use_id", "tool": "tool_name" },
      "call": "kind"
    },
    "PermissionRequest": {
      "kind": "permission.request",
      "data": { "kind": "=tool", "tool": "tool_name" },
      "call": "detail"
    },
    "PostToolUse": {
      "kind": "tool.after",
      "data": { "call": "tool_use_id", "tool": "tool_name", "outcome": "=ok" }
    },
    "PostToolUseFailure": {
      "kind": "tool.after",
      "data": { "call": "tool_use_id", "tool": "tool_name", "outcome": "=failed" }
    },
    "Stop": {
      "kind": "agent.stop",
      "data": { "outcome": "=finished", "continued": "stop_hook_active" },
      "stop": true
    },
    "StopFailure": {
      "kind": "agent.stop",
      "data": { "outcome": "=failed" },
      "stop": true
    },
    "SessionEnd": {
      "kind": "session.end",
      "data": { "reason": "reason" }
    },
    "SubagentStop": {
      "kind": "agent.stop",
      "data": { "outcome": "=finished", "continued": "stop_hook_active" },
      "stop": true
    },
    "TaskCompleted": {
      "kind": "task.completed",
      "data": { "agent_task": "task_id", "title": "task_subject" }
    },
    "Notification": {
      "kind": "session.attention",
      "data": {},
      "state": {
        "field": "notification_type",
        "values": {
          "permission_prompt": "waiting",
          "elicitation_dialog": "waiting",
          "elicitation_url_dialog": "waiting",
          "agent_needs_input": "waiting",
          "idle_prompt": "finished",
          "elicitation_complete": "working",
          "elicitation_response": "working"
        }
      }
    },
    "Elicitation": {
      "kind": "session.attention",
      "data": { "state": "=waiting" }
    },
    "ElicitationResult": {
      "kind": "session.attention",
      "data": { "state": "=working" }
    }
  },
  "retries": {
    "readBy": "a row reads retrying from these records alone (#2019): each entry the match names is the agent retrying a model call the provider refused, one model.call event by its own uuid and timestamp, with its attempt, its most and the cause its error names; the next assistant entry is the model's reply, which ends them",
    "conformance": "claude/retries/records",
    "match": { "type": "system", "subtype": "api_error" },
    "attempt": "retryAttempt",
    "max": "maxRetries",
    "at": "timestamp",
    "id": "uuid",
    "cause": {
      "fields": ["error.status", "error.error.error.type", "error.error.type", "error.connection.code"],
      "values": {
        "529": "overloaded", "overloaded_error": "overloaded",
        "429": "rate_limited", "rate_limit_error": "rate_limited",
        "500": "server_error", "502": "server_error", "503": "server_error", "504": "server_error", "api_error": "server_error",
        "ECONNRESET": "connection", "ECONNREFUSED": "connection", "ENOTFOUND": "connection", "ETIMEDOUT": "connection", "EPIPE": "connection", "StreamNoResponse": "connection"
      },
      "otherwise": "unknown"
    },
    "reply": { "type": "assistant" },
    "source": "Claude Code's session transcripts on 2.1.317 and 2.1.321 (recorded Nov 11 2026: type system, subtype api_error, source request_retry, with retryAttempt, maxRetries, retryInMs and timestamp, for connection errors); the overload and rate-limit values follow the API's own error shape, not yet recorded in a transcript"
  },
  "stop": {
    "readBy": "each agent.stop names its cause from the stop's closed set and carries its turn's usage (#603); the turn is the transcript's entries from the user entry whose promptId is the payload's prompt_id to the next prompt's; a subagent's stop (its payload carries agent_id) ran in the subagent's own transcript, agent_transcript_path, so no entry of the session's transcript is its turn: its cause comes from the payload alone and its usage is not captured",
    "conformance": "claude/stop/cause-and-usage",
    "turn": { "payload": "prompt_id", "transcript": "promptId", "elsewhere": "agent_id" },
    "cause": {
      "readBy": "the first that names a cause: the StopFailure payload's error, then an API error entry of the turn (isApiErrorMessage, its error taking the same values), never the agent's text; Claude Code's hooks reference lists the values; billing_error, a spend limit or credits run out, is a rate limit (the hub places it as yours to raise, #85), and server_error, which is what a refused connection, an unknown host or a request timeout reads as (recorded live on 2.1.308), a timeout; it records rate limits only as those errors, with no reset time in any field, so a Claude Code stop is rate_limited and never plan_window_spent; a value not listed, and a stop nothing names a cause for, is unknown",
      "payload": {
        "field": "error",
        "values": {
          "rate_limit": "rate_limited",
          "overloaded": "rate_limited",
          "authentication_failed": "sign_in_required",
          "oauth_org_not_allowed": "sign_in_required",
          "billing_error": "rate_limited",
          "server_error": "timed_out"
        }
      },
      "errors": {
        "match": { "type": "assistant", "isApiErrorMessage": true },
        "field": "error",
        "values": {
          "rate_limit": "rate_limited",
          "overloaded": "rate_limited",
          "authentication_failed": "sign_in_required",
          "oauth_org_not_allowed": "sign_in_required",
          "billing_error": "rate_limited",
          "server_error": "timed_out"
        }
      },
      "otherwise": "unknown"
    },
    "usage": {
      "readBy": "the turn's assistant entries' message.usage, once per message.id, since each content block repeats it; input is input_tokens plus cache_creation_input_tokens, cached is cache_read_input_tokens, each exact; an API error's synthetic entry (model <synthetic>) carries zeros, not usage, so it is left out; the model is the last entry's message.model; no context window and no cost is recorded, so context_fill is null and the cost unpriced",
      "covers": "turn",
      "records": {
        "match": { "type": "assistant" },
        "has": "message.usage",
        "skip": { "message.model": "<synthetic>" },
        "once": "message.id"
      },
      "take": "sum",
      "counts": {
        "input": ["message.usage.input_tokens", "message.usage.cache_creation_input_tokens"],
        "cached": ["message.usage.cache_read_input_tokens"],
        "output": ["message.usage.output_tokens"]
      },
      "exact": true,
      "model": { "record": "message.model" }
    }
  },
  "toolKinds": {
    "readBy": "a tool call's kind (shell, read, edit, write, search, fetch, mcp or unknown, which guards treat as change), by tool name or name prefix",
    "conformance": "claude/toolKinds/unknown-otherwise",
    "tools": {
      "Bash": "shell",
      "Read": "read",
      "Edit": "edit",
      "MultiEdit": "edit",
      "NotebookEdit": "edit",
      "Write": "write",
      "Glob": "search",
      "Grep": "search",
      "WebFetch": "fetch",
      "WebSearch": "fetch"
    },
    "prefixes": { "mcp__": "mcp" },
    "otherwise": "unknown"
  },
  "toolDetail": {
    "readBy": "what a call of each kind carries: a shell call's command, a file call's paths",
    "conformance": "claude/toolDetail/paths-and-command",
    "command": { "shell": "tool_input.command" },
    "paths": {
      "Read": "tool_input.file_path",
      "Edit": "tool_input.file_path",
      "MultiEdit": "tool_input.file_path",
      "Write": "tool_input.file_path",
      "NotebookEdit": "tool_input.notebook_path"
    },
    "mcp": { "tool": "tool" }
  },
  "taskList": {
    "readBy": "the session's own task list: the newest TodoWrite call of the turn's transcript, whose todos each name their content and status",
    "conformance": "claude/taskList/open-at-stop",
    "tool": "TodoWrite",
    "items": "todos",
    "text": "content",
    "status": "status",
    "open": ["pending", "in_progress"]
  },
  "readUsage": {
    "readBy": "a turn's usage from the transcript: the model that answered, tokens by the agent's own count, a cost only with its basis",
    "conformance": "claude/readUsage/model-switch"
  },
  "entries": {
    "readBy": "where the hub's sync (#148) writes and reads this agent's MCP servers and skills, at user level only, and the fields it refuses; checked against each entry before a plan shows",
    "name": "Claude Code",
    "mcp": {
      "file": "~/.claude.json",
      "format": "json",
      "key": "mcpServers",
      "perProject": "projects",
      "transports": {
        "stdio": {
          "type": "stdio",
          "fields": ["command", "args", "env"]
        },
        "http": {
          "type": "http",
          "fields": ["url", "headers", "env"]
        }
      },
      "refused": [
        {
          "transport": "stdio",
          "field": "url",
          "reason": "a stdio entry runs a command"
        },
        {
          "transport": "stdio",
          "field": "headers",
          "reason": "a stdio entry runs a command"
        },
        {
          "transport": "http",
          "field": "command",
          "reason": "an http entry names a URL"
        },
        {
          "transport": "http",
          "field": "args",
          "reason": "an http entry names a URL"
        }
      ],
      "list": ["mcp", "list"]
    },
    "skills": {
      "write": "~/.claude/skills",
      "readFrom": ["~/.claude/skills"]
    }
  }
}
