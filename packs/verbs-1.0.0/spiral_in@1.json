{
  "id": "verbs.spiral_in",
  "version": "1.0",
  "title": "Spiral in",
  "license": "Apache-2.0",
  "author": "DeepBuild",
  "description": "An enter: each target turns a full turn in from `scale` times its size, fading up over the first `fade` of its window.",
  "inputs": {
    "scale": {
      "type": "number",
      "default": 8,
      "min": 0,
      "about": "how many times its size it starts at"
    },
    "fade": {
      "type": "number",
      "default": 0.3,
      "min": 0,
      "max": 1,
      "about": "the share of its window its opacity rises over"
    }
  },
  "steps": {
    "turn": {
      "op": "cue",
      "params": {
        "from": {
          "at/rot/2": "now - 360",
          "at/scale": [
            "now[0] * scale",
            "now[1] * scale",
            "now[2]"
          ]
        }
      }
    },
    "fade": {
      "op": "cue",
      "params": {
        "from": {
          "adjust/opacity": 0
        },
        "until": "fade"
      }
    }
  }
}
