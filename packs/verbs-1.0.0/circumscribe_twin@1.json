{
  "id": "verbs.circumscribe_twin",
  "version": "1.0",
  "title": "Circumscribe, planted twin",
  "license": "Apache-2.0",
  "author": "DeepBuild",
  "description": "The planted twin of circumscribe: a wrong curve, timing or end state its fixture must catch.",
  "inputs": {
    "shape": {
      "type": "choice",
      "options": [
        "rect",
        "circle"
      ],
      "default": "rect",
      "about": "the frame's shape"
    },
    "buff": {
      "type": "number",
      "default": 10,
      "min": 0,
      "about": "the gap between the bounds and the frame"
    }
  },
  "steps": {
    "ring": {
      "op": "mark",
      "kind": "rect@1",
      "params": {
        "box": [
          "x0 - buff - cx",
          "y0 - buff - cy",
          "w + 2 * buff",
          "h + 2 * buff"
        ],
        "corner": "shape == circle ? max(w, h) / 2 + buff : 0",
        "paint": {
          "stroke": {
            "role": "accent",
            "width": 3
          }
        },
        "ops": [
          {
            "trim": {
              "start": 0,
              "end": 1
            }
          }
        ]
      },
      "at": {
        "pos": [
          "cx",
          "cy",
          0
        ]
      }
    },
    "out": {
      "op": "cue",
      "params": {
        "on": "ring",
        "from": {
          "params/ops/0/trim/end": 0
        },
        "until": 0.5
      }
    },
    "lift": {
      "op": "cue",
      "params": {
        "set": {
          "adjust/brightness": {
            "pulse": {
              "amount": 0.3
            }
          }
        }
      }
    }
  }
}
