{
  "id": "verbs.spiral_in_twin",
  "version": "1.0",
  "title": "Spiral in, planted twin",
  "license": "Apache-2.0",
  "author": "DeepBuild",
  "description": "The planted twin of spiral_in: a wrong curve, timing or end state its fixture must catch.",
  "inputs": {
    "scale": {
      "type": "number",
      "default": 8,
      "min": 0,
      "about": "how many times its size it starts at"
    },
    "fade": {
      "type": "number",
      "default": 0.3,
      "min": 0,
      "max": 1,
      "about": "the share of its window its opacity rises over"
    }
  },
  "steps": {
    "turn": {
      "op": "cue",
      "params": {
        "from": {
          "at/scale": [
            "now[0] * scale",
            "now[1] * scale",
            "now[2]"
          ]
        }
      }
    },
    "fade": {
      "op": "cue",
      "params": {
        "from": {
          "adjust/opacity": 0
        },
        "until": "fade"
      }
    }
  }
}
