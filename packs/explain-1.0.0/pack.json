      "children": [],
      "capabilities": {
        "pickable": false,
        "snap": false
      },
      "rules": [
        {
          "code": "explain.one_entrance",
          "over": "cues",
          "at": "rest",
          "expr": "!(cue.class == enter && other.class == enter && other.start < cue.end && cue.start < other.end)",
          "fix": "Start each entrance once the one before it has landed."
        },
        {
          "code": "explain.still_once_landed",
          "over": "cues",
          "at": "rest",
          "expr": "!(touches && other.class == enter && cue.start >= other.end && (cue.class == move || cue.class == change))",
          "fix": "Leave a landed word still: move it before it lands, or let it exit."
        },
        {
          "code": "explain.section_length",
          "over": "cues",
          "at": "rest",
          "expr": "cue.end - cue.section <= 8",
          "fix": "Keep each section to 8 s: start a new one with a cue whose data sets section."
        }
