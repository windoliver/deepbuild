  "entries": {
    "cue.kind@1": [
      {
        "name": "explain.slam",
        "class": "enter",
        "recipe": "explain.slam@1",
        "description": "An enter: the main word appears at 1.7 times its size and springs to it along 1 - e^(-10t) cos(2 pi 2.2 t); a second target, its sub-line, rises into place over 0.33 s."
      },
      {
        "name": "explain.apply",
        "class": "change",
        "recipe": "explain.apply@1",
        "description": "A change: the moving plane's matrix becomes M times itself, each entry keyed so the matrix itself mixes, (1 - u) M0 + u M M0; with ghosts, its rows are held at the cue's start for the old tips.",
        "kit": {
          "targets": [
            "a",
            "b"
          ],
          "params": {
            "matrix": [
              [
                1,
                1
              ],
              [
                0,
                1
              ]
            ]
          }
        },
        "joins": [
          "vec",
          "coord",
          "path",
          "label",
          "bend",
          "moving",
          "g0",
          "g1"
        ]
      },
      {
        "name": "explain.inverse",
        "class": "change",
        "recipe": "explain.inverse@1",
        "description": "A change: the moving plane's matrix becomes its inverse; a singular matrix has none and is refused.",
        "kit": {
          "targets": [
            "a",
            "b"
          ]
        },
        "joins": [
          "vec",
          "coord",
          "path",
          "label",
          "bend",
          "moving",
          "g0",
          "g1"
        ]
      },
      {
        "name": "explain.transpose",
        "class": "change",
        "recipe": "explain.transpose@1",
