{
  "id": "explain.warp",
  "version": "1.0",
  "title": "Warp",
  "license": "Apache-2.0",
  "author": "DeepBuild",
  "description": "A change: the moving plane takes the formulas x and y, of x and y, the matrix entries a, b, c and d and the warp's progress u, which runs from 0 to 1 over the cue, so a formula that reads a x + b y at u = 0 bends in from the matrix.",
  "inputs": {
    "matrix": {
      "type": "records",
      "default": [
        [
          1,
          0
        ],
        [
          0,
          1
        ]
      ],
      "about": "the matrix applied, by rows"
    },
    "x": {
      "type": "text",
      "default": "x",
      "about": "a warp's x as a formula of x and y"
    },
    "y": {
      "type": "text",
      "default": "y",
      "about": "a warp's y as a formula of x and y"
    },
    "text": {
      "type": "text",
      "default": "",
      "about": "a label's new text"
    },
    "vec": {
      "type": "ID",
      "default": "none",
      "about": "the vector's arrow"
    },
    "coord": {
      "type": "ID",
      "default": "none",
      "about": "the vector's coordinates"
    },
    "path": {
      "type": "ID",
      "default": "none",
      "about": "the vector's path along its coordinates"
    },
    "label": {
      "type": "ID",
      "default": "none",
      "about": "the vector's label"
    },
    "bend": {
      "type": "ID",
      "default": "none",
      "about": "where a warp's progress u runs from 0 to 1"
    },
    "moving": {
      "type": "ID",
      "default": "none",
      "about": "the moving plane's group, whose formulas a warp sets"
    },
    "g0": {
      "type": "ID",
      "default": "none",
      "about": "where the first row is held at the cue's start"
    },
    "g1": {
      "type": "ID",
      "default": "none",
      "about": "where the second row is held at the cue's start"
    }
  },
  "steps": {
    "formula": {
      "op": "cue",
      "when": "i == 0 && moving != none",
      "params": {
        "on": "moving",
        "set": {
          "params/warp/map/x": "x",
          "params/warp/map/y": "y"
        },
        "until": 0,
        "type": "string"
      }
    },
    "progress": {
      "op": "cue",
      "when": "i == 0 && bend != none",
      "params": {
        "on": "bend",
        "from": {
          "at/pos": [
            0,
            0,
            0
          ]
        },
        "set": {
          "at/pos": [
            1,
            0,
            0
          ]
        }
      }
    }
  }
}
