{
  "id": "explain.transpose",
  "version": "1.0",
  "title": "Transpose",
  "license": "Apache-2.0",
  "author": "DeepBuild",
  "description": "A change: the moving plane's matrix becomes its transpose.",
  "inputs": {
    "matrix": {
      "type": "records",
      "default": [
        [
          1,
          0
        ],
        [
          0,
          1
        ]
      ],
      "about": "the matrix applied, by rows"
    },
    "x": {
      "type": "text",
      "default": "x",
      "about": "a warp's x as a formula of x and y"
    },
    "y": {
      "type": "text",
      "default": "y",
      "about": "a warp's y as a formula of x and y"
    },
    "text": {
      "type": "text",
      "default": "",
      "about": "a label's new text"
    },
    "vec": {
      "type": "ID",
      "default": "none",
      "about": "the vector's arrow"
    },
    "coord": {
      "type": "ID",
      "default": "none",
      "about": "the vector's coordinates"
    },
    "path": {
      "type": "ID",
      "default": "none",
      "about": "the vector's path along its coordinates"
    },
    "label": {
      "type": "ID",
      "default": "none",
      "about": "the vector's label"
    },
    "bend": {
      "type": "ID",
      "default": "none",
      "about": "where a warp's progress u runs from 0 to 1"
    },
    "moving": {
      "type": "ID",
      "default": "none",
      "about": "the moving plane's group, whose formulas a warp sets"
    },
    "g0": {
      "type": "ID",
      "default": "none",
      "about": "where the first row is held at the cue's start"
    },
    "g1": {
      "type": "ID",
      "default": "none",
      "about": "where the second row is held at the cue's start"
    }
  },
  "steps": {
    "row0": {
      "op": "cue",
      "when": "i == 0",
      "params": {
        "set": {
          "at/pos": [
            "now[0]",
            "next_now[0]",
            "now[2]"
          ]
        }
      }
    },
    "row1": {
      "op": "cue",
      "when": "i == 1",
      "params": {
        "set": {
          "at/pos": [
            "next_now[1]",
            "now[1]",
            "now[2]"
          ]
        }
      }
    }
  }
}
