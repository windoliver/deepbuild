(module
  (import "env" "__linear_memory" (memory 32 32))
  (import "lib:lanes@1" "graph" (func $graph (param i32 i32) (result i32)))
  (import "lib:lanes@1" "vehicle" (func $vehicle (param i32 i32) (result i32)))
  (import "lib:lanes@1" "route" (func $route (param i32 i32 i32) (result f64)))
  (import "lib:lanes@1" "go" (func $go (param i32 f64 i32)))
  (import "lib:lanes@1" "lift" (func $lift (param i32 i32 f64)))
  (import "lib:lanes@1" "carry" (func $carry (param i32 i32)))
  (import "lib:lanes@1" "set_down" (func $set_down (param i32 i32)))
  (import "lib:lanes@1" "park" (func $park (param i32 i32 i32) (result f64)))
  (global (export "reads_at") i32 (i32.const 0))
  (global (export "writes_at") i32 (i32.const 4096))
  (global (export "assets_at") i32 (i32.const 65536))
  (func (export "init") (param $seed i64)
    (drop (call $graph (i32.const 1048576) (i32.const 65540)))
    (drop (call $vehicle (i32.const 1048576) (i32.const 1))))
  (func (export "step") (param $k i64) (local $ph i32)
    (local.set $ph (i32.load (i32.const 16384)))
    (block $done
      (if (i64.eqz (local.get $k)) (then (call $lift (i32.const 1048576) (i32.const 0) (f64.const 0.1)) (br $done)))
      (br_if $done (i32.ne (i32.load (i32.const 4128)) (i32.const 0)))
      (if (i32.eq (local.get $ph) (i32.const 0))
        (then (call $carry (i32.const 1048576) (i32.const 0)) (drop (call $park (i32.const 1048576) (i32.const 0) (i32.const 2))) (local.set $ph (i32.const 1)) (br $done)))
      (if (i32.eq (local.get $ph) (i32.const 1))
        (then (call $lift (i32.const 1048576) (i32.const 0) (f64.const 5.4)) (local.set $ph (i32.const 2)) (br $done)))
      (if (i32.eq (local.get $ph) (i32.const 2))
        (then (call $set_down (i32.const 1048576) (i32.const 0)) (call $lift (i32.const 1048576) (i32.const 0) (f64.const 0.1)) (local.set $ph (i32.const 3)) (br $done)))
      (if (i32.eq (local.get $ph) (i32.const 3))
        (then (drop (call $park (i32.const 1048576) (i32.const 0) (i32.const 0))) (local.set $ph (i32.const 4)))))
    (i32.store (i32.const 16384) (local.get $ph))
    (call $go (i32.const 1048576) (f64.const 0.1) (i32.const 4096))
    (i32.store (i32.const 4168) (local.get $ph)))
  (data (i32.const 8192) "\00"))