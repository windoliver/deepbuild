(module
  (import "env" "__linear_memory" (memory 64 64))
  (import "lib:sense.lib@1" "sight" (func $sight (param i32 i64)))
  (global (export "reads_at") i32 (i32.const 0))
  (global (export "writes_at") i32 (i32.const 4096))
  (global (export "assets_at") i32 (i32.const 3342336))
  ;; Takes n bytes, rounded up to 8, at the address held at 8: stores the address in the header's field and moves on.
  (func $array (param $field i32) (param $n i32)
    (i32.store (local.get $field) (i32.load (i32.const 8)))
    (i32.store (i32.const 8) (i32.add (i32.load (i32.const 8)) (i32.and (i32.add (local.get $n) (i32.const 7)) (i32.const -8)))))
  (func (export "init") (param $seed i64) (local $u i32) (local $us i32) (local $f i32) (local $i i32)
    (i32.store (i32.const 1048576) (i32.add (i32.add (i32.const 3342340) (i32.load (i32.const 3342336))) (i32.const 4)))
    (memory.copy (i32.const 1048580) (i32.const 3342340) (i32.const 24))
    (i32.store (i32.const 1048604) (i32.const 3145728))
    (i32.store (i32.const 1048608) (i32.load (i32.const 3342364)))
    (i32.store (i32.const 1048612) (i32.const 3211264))
    (i32.store (i32.const 1048616) (i32.load (i32.const 3342368)))
    (memory.copy (i32.const 1048648) (i32.const 3342372) (i32.const 32))
    (memory.copy (i32.const 1048680) (i32.const 3342404) (i32.const 32))
    (local.set $u (i32.load (i32.const 3342368)))
    (local.set $us (i32.mul (local.get $u) (i32.load (i32.const 3342360))))
    ;; The fog grid's cells: the sight cells across and down, each cut into (cell ÷ radar cell)² fog cells.
    (local.set $f (i32.div_u (i32.load (i32.const 3342348)) (i32.load (i32.const 3342352))))
    (local.set $f (i32.mul (i32.mul (local.get $f) (local.get $f)) (i32.mul
      (i32.div_u (i32.sub (i32.load (i32.const 3342340)) (i32.const 1)) (i32.load (i32.const 3342348)))
      (i32.div_u (i32.sub (i32.load (i32.const 3342344)) (i32.const 1)) (i32.load (i32.const 3342348))))))
    (i32.store (i32.const 8) (i32.const 4096))
    (call $array (i32.const 1048628) (i32.shl (local.get $u) (i32.const 2)))
    (call $array (i32.const 1048632) (i32.shl (local.get $u) (i32.const 4)))
    (call $array (i32.const 1048620) (i32.shl (local.get $f) (i32.const 2)))
    (call $array (i32.const 1048636) (i32.shl (local.get $us) (i32.const 2)))
    (call $array (i32.const 1048644) (i32.shl (local.get $us) (i32.const 2)))
    (call $array (i32.const 1048640) (i32.shl (local.get $us) (i32.const 4)))
    (call $array (i32.const 1048624) (i32.shl (local.get $u) (i32.const 2)))
    ;; Every unit row starts empty: its side −1.
    (block $done (loop $each
      (br_if $done (i32.ge_u (local.get $i) (local.get $u)))
      (i32.store offset=24 (i32.add (i32.const 3211264) (i32.mul (local.get $i) (i32.const 40))) (i32.const -1))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $each))))
  (func (export "step") (param $k i64) (local $p i32) (local $op i32)
    (local.set $p (i32.load (i32.const 3276800)))
    (block $done (loop $next
      (local.set $op (i32.load (local.get $p)))
      (br_if $done (i32.eq (local.get $op) (i32.const 3)))
      (local.set $p (i32.add (local.get $p) (i32.const 8)))
      (br_if $done (i32.eqz (local.get $op)))
      (memory.copy
        (i32.add (select (i32.const 3145728) (i32.const 3211264) (i32.eq (local.get $op) (i32.const 1))) (i32.mul (i32.load (i32.sub (local.get $p) (i32.const 4))) (i32.const 40)))
        (local.get $p) (i32.const 40))
      (local.set $p (i32.add (local.get $p) (i32.const 40)))
      (br $next)))
    (i32.store (i32.const 3276800) (local.get $p))
    (call $sight (i32.const 1048576) (local.get $k)))
  (data (i32.const 3276800) "\84\00\33\00"))