{
  "id": "godot.spot_light_3d",
  "version": "1.0",
  "title": "SpotLight3D",
  "license": "Apache-2.0",
  "author": "DeepBuild",
  "description": "Godot 4's SpotLight3D in physical units: its lumens are an omni light's, kept; spot_angle the outer half angle; it shines along its local −Z, as ours.",
  "inputs": {
    "position": {
      "type": "vec3",
      "default": [
        0,
        0,
        0
      ],
      "unit": "m",
      "about": ""
    },
    "rotation": {
      "type": "vec3",
      "default": [
        0,
        0,
        0
      ],
      "unit": "rad",
      "about": "YXZ"
    },
    "light_intensity_lumens": {
      "type": "number",
      "default": 1000,
      "unit": "lm",
      "min": 0,
      "about": ""
    },
    "spot_angle": {
      "type": "number",
      "default": 45,
      "unit": "deg",
      "min": 0,
      "max": 90,
      "about": ""
    }
  },
  "let": {
    "ca": "cos(rotation[0])",
    "sa": "sin(rotation[0])",
    "cb": "cos(rotation[1])",
    "sb": "sin(rotation[1])",
    "cc": "cos(rotation[2])",
    "sc": "sin(rotation[2])",
    "m00": "cb * cc + sb * sa * sc",
    "m01": "-cb * sc + sb * sa * cc",
    "m02": "sb * ca",
    "m10": "ca * sc",
    "m11": "ca * cc",
    "m12": "-sa",
    "m20": "-sb * cc + cb * sa * sc",
    "m21": "sb * sc + cb * sa * cc",
    "m22": "cb * ca",
    "n00": "m00",
    "n01": "m01",
    "n02": "m02",
    "n10": "m10",
    "n11": "m11",
    "n12": "m12",
    "n20": "m20",
    "n21": "m21",
    "n22": "m22",
    "rx": "abs(n20) < 0.9999999999 ? deg(atan2(n21, n22)) : 0",
    "ry": "deg(asin(max(-1, min(1, -n20))))",
    "rz": "abs(n20) < 0.9999999999 ? deg(atan2(n10, n00)) : deg(atan2(-n01, n11))"
  },
  "steps": {
    "light": {
      "op": "item",
      "kind": "light.spot@1",
      "params": {
        "power": "light_intensity_lumens",
        "outer": "spot_angle"
      },
      "at": {
        "pos": [
          "position[0]",
          "position[1]",
          "position[2]"
        ],
        "rot": [
          "rx",
          "ry",
          "rz"
        ]
      }
    }
  }
}
