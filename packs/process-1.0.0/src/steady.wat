  (import "lib:process@1" "queue" (func $queue (param i32 i32 i32 i32) (result i32)))
  (import "lib:process@1" "source" (func $source (param i32 i32 f64 f64 i32 f64 i32) (result i32)))
  (import "lib:process@1" "stats" (func $stats (param i32 i32 i32)))
  (global (export "reads_at") i32 (i32.const 0))
  (global (export "writes_at") i32 (i32.const 4096))
  (func (export "init") (param $seed i64)
    (f64.store (i32.const 1048576) (f64.const 0.016666666666666666))
    (i64.store offset=8 (i32.const 1048576) (local.get $seed))
    (i32.store offset=16 (i32.const 1048576) (i32.const 8))
    (i32.store offset=20 (i32.const 1048576) (i32.const 1))
    (i32.store offset=24 (i32.const 1048576) (i32.const 64))
    (f64.store offset=32 (i32.const 1048576) (f64.const 3600.0))
    (f64.store offset=40 (i32.const 1048576) (f64.const 0.0))
    (drop (call $sink (i32.const 1048576)))
    (drop (call $resource (i32.const 1048576) (i32.const 1)))
    (drop (call $request (i32.const 1048576) (i32.const 0) (i32.const 1) (f64.const 45.0) (f64.const 0.0) (i32.const 0)))
    (drop (call $queue (i32.const 1048576) (i32.const 0) (i32.const -1) (i32.const 1)))
    (drop (call $source (i32.const 1048576) (i32.const 0) (f64.const 60.0) (f64.const 0.0) (i32.const -1) (f64.const -1.0) (i32.const 2))))
  (func (export "step") (param $k i64)
    (call $stats (i32.const 1048576) (i32.const 3600) (i32.const 4096)))
  (data (i32.const 8192) "\00"))
