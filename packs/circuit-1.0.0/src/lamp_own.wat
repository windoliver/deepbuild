(module
  (import "env" "__linear_memory" (memory 32 32))
  (import "lib:circuit_ref" "node" (func $node (param i32 i32 i32) (result i32)))
  (import "lib:circuit_ref" "source_ac" (func $source_ac (param i32 i32 i32) (result i32)))
  (import "lib:circuit_ref" "load" (func $load (param i32 i32 i32) (result i32)))
  (import "lib:circuit_ref" "solve" (func $solve (param i32 i32 i64 i64) (result i32)))
  (global (export "reads_at") i32 (i32.const 0))
  (global (export "writes_at") i32 (i32.const 4096))
  (global (export "assets_at") i32 (i32.const 262144))
  (func (export "init") (param $seed i64)
    (drop (call $node (i32.const 1048576) (i32.const 262148) (i32.const 0)))
    (drop (call $node (i32.const 1048576) (i32.const 262148) (i32.const 1)))
    (drop (call $source_ac (i32.const 1048576) (i32.const 262148) (i32.const 0)))
    (drop (call $load (i32.const 1048576) (i32.const 262148) (i32.const 1))))
  (func (export "step") (param $k i64)
    (drop (call $solve (i32.const 1048576) (i32.const 0) (local.get $k) (i64.const 1000)))
    (memory.copy (i32.const 4096) (i32.const 1048576) (i32.const 152)))
  (data (i32.const 49152) "\00\00\00\00\00\00\00\00"))