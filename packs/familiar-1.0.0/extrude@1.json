{
  "id": "familiar.extrude",
  "version": "1.0",
  "title": "Extrude",
  "license": "Apache-2.0",
  "author": "DeepBuild",
  "description": "The library's ExtrudeGeometry with its parameter names and defaults, as extrude@1; angles in degrees.",
  "inputs": {
    "shape": {
      "type": "records",
      "default": null,
      "about": "the Shape's points, [[x, y]] in m, one polygon"
    },
    "depth": {
      "type": "number",
      "default": 1,
      "unit": "m",
      "min": 0,
      "about": ""
    },
    "steps": {
      "type": "integer",
      "default": 1,
      "min": 1,
      "max": 1024,
      "about": ""
    },
    "bevelEnabled": {
      "type": "bool",
      "default": true,
      "about": ""
    },
    "bevelThickness": {
      "type": "number",
      "default": 0.2,
      "unit": "m",
      "min": 0,
      "about": ""
    },
    "bevelSize": {
      "type": "number",
      "default": -1,
      "unit": "m",
      "about": "−1: the library's default, bevelThickness − 0.1"
    },
    "bevelOffset": {
      "type": "number",
      "default": 0,
      "unit": "m",
      "about": ""
    },
    "bevelSegments": {
      "type": "integer",
      "default": 3,
      "min": 1,
      "max": 64,
      "about": ""
    },
    "curveSegments": {
      "type": "integer",
      "default": 12,
      "min": 1,
      "max": 1024,
      "about": ""
    },
    "position": {
      "type": "vec3",
      "default": [
        0,
        0,
        0
      ],
      "unit": "m",
      "about": "Object3D.position"
    },
    "rotation": {
      "type": "vec3",
      "default": [
        0,
        0,
        0
      ],
      "unit": "deg",
      "about": "Object3D.rotation, in the library's default order XYZ, in degrees"
    },
    "scale": {
      "type": "vec3",
      "default": [
        1,
        1,
        1
      ],
      "about": "Object3D.scale"
    },
    "pivot": {
      "type": "vec3",
      "default": [
        0,
        0,
        0
      ],
      "unit": "m",
      "about": "Object3D.pivot: the point the object turns and scales about, landing at position + pivot"
    }
  },
  "let": {
    "n": "len(shape)",
    "ar": "sum(k, 0, n - 1, shape[(k + n - 1) % n][0] * shape[k][1] - shape[k][0] * shape[(k + n - 1) % n][1])",
    "th": "bevelEnabled ? bevelThickness : 0",
    "sz": "bevelEnabled ? (bevelSize < 0 ? bevelThickness - 0.1 : bevelSize) : 0",
    "off": "bevelEnabled ? bevelOffset : 0",
    "bs": "bevelEnabled ? bevelSegments : 0",
    "cw": {
      "repeat": {
        "count": "n",
        "as": "k",
        "of": "ar < 0 ? shape[k] : shape[n - 1 - k]"
      }
    },
    "moves": {
      "repeat": {
        "count": "n",
        "as": "k",
        "let": {
          "a": "cw[(k + n - 1) % n]",
          "b": "cw[k]",
          "c": "cw[(k + 1) % n]",
          "px": "b[0] - a[0]",
          "py": "b[1] - a[1]",
          "nx": "c[0] - b[0]",
          "ny": "c[1] - b[1]",
          "pl": "sqrt(px * px + py * py)",
          "nl": "sqrt(nx * nx + ny * ny)",
          "col": "px * ny - py * nx",
          "psx": "a[0] - py / pl",
          "psy": "a[1] + px / pl",
          "nsx": "c[0] - ny / nl",
          "nsy": "c[1] + nx / nl",
          "sf": "abs(col) > 0.0000000000000002220446 ? ((nsx - psx) * ny - (nsy - psy) * nx) / col : 0",
          "tx": "psx + px * sf - b[0]",
          "ty": "psy + py * sf - b[1]",
          "lsq": "tx * tx + ty * ty",
          "same": "px > 0.0000000000000002220446 ? (nx > 0.0000000000000002220446) : (px < -0.0000000000000002220446 ? (nx < -0.0000000000000002220446) : ((py > 0) == (ny > 0) && (py < 0) == (ny < 0)))",
          "shrink": "abs(col) > 0.0000000000000002220446 ? (lsq <= 2 ? 1 : sqrt(lsq / 2)) : (same ? pl : sqrt((px * px + py * py) / 2))",
          "mx": "abs(col) > 0.0000000000000002220446 ? tx / shrink : (same ? -py / shrink : px / shrink)",
          "my": "abs(col) > 0.0000000000000002220446 ? ty / shrink : (same ? px / shrink : py / shrink)"
        },
        "of": [
          "mx",
          "my"
        ]
      }
    },
    "layers": {
      "repeat": {
        "count": "2 * bs + steps + 1",
        "as": "k",
        "let": {
          "front": "k < bs",
          "back": "k > bs + steps",
          "t": "front ? k / bs : (back ? (2 * bs + steps - k) / bs : 1)",
          "z": "front ? -th * cos(t * pi / 2) : (back ? depth + th * cos(t * pi / 2) : (k - bs) * depth / steps)",
          "s": "front || back ? sz * sin(t * pi / 2) + off : sz + off"
        },
        "of": [
          "z",
          {
            "repeat": {
              "count": "n",
              "as": "m",
              "of": [
                "cw[m][0] + moves[m][0] * s",
                "cw[m][1] + moves[m][1] * s"
              ]
            }
          }
        ]
      }
    },
    "ca": "cos(rad(rotation[0]))",
    "sa": "sin(rad(rotation[0]))",
    "cb": "cos(rad(rotation[1]))",
    "sb": "sin(rad(rotation[1]))",
    "cc": "cos(rad(rotation[2]))",
    "sc": "sin(rad(rotation[2]))",
    "m00": "cb * cc",
    "m01": "-cb * sc",
    "m02": "sb",
    "m10": "ca * sc + sa * sb * cc",
    "m11": "ca * cc - sa * sb * sc",
    "m12": "-sa * cb",
    "m20": "sa * sc - ca * sb * cc",
    "m21": "sa * cc + ca * sb * sc",
    "m22": "ca * cb",
    "n00": "m00",
    "n01": "m01",
    "n02": "m02",
    "n10": "m10",
    "n11": "m11",
    "n12": "m12",
    "n20": "m20",
    "n21": "m21",
    "n22": "m22",
    "rx": "abs(n20) < 0.9999999999 ? deg(atan2(n21, n22)) : 0",
    "ry": "deg(asin(max(-1, min(1, -n20))))",
    "rz": "abs(n20) < 0.9999999999 ? deg(atan2(n10, n00)) : deg(atan2(-n01, n11))",
    "s0": "scale[0]",
    "q0": "0 + pivot[0]",
    "s1": "scale[1]",
    "q1": "0 + pivot[1]",
    "s2": "scale[2]",
    "q2": "0 + pivot[2]",
    "px": "position[0] + pivot[0]",
    "py": "position[1] + pivot[1]",
    "pz": "position[2] + pivot[2]"
  },
  "steps": {
    "mesh": {
      "op": "builder",
      "kind": "extrude@1",
      "params": {
        "levels": "layers",
        "paint": {
          "fill": {
            "role": "accent"
          }
        }
      },
      "at": {
        "pos": [
          "px",
          "py",
          "pz"
        ],
        "rot": [
          "rx",
          "ry",
          "rz"
        ],
        "scale": [
          "s0",
          "s1",
          "s2"
        ],
        "pivot": [
          "q0",
          "q1",
          "q2"
        ]
      }
    }
  }
}
