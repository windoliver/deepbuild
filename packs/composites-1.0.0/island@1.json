{
  "id": "composites.island",
  "version": "1.0",
  "title": "Island",
  "license": "Apache-2.0",
  "author": "DeepBuild",
  "description": "A floating island: a flat-shaded rock body turned on a lathe, a grass plate on top, and rocks whose sizes come from their stable IDs' seeds.",
  "inputs": {
    "radius": {
      "type": "number",
      "unit": "m",
      "default": 10,
      "min": 2,
      "max": 100,
      "about": ""
    },
    "rocks": {
      "type": "integer",
      "default": 6,
      "min": 0,
      "max": 9,
      "about": "rocks on the top"
    }
  },
  "steps": {
    "body": {
      "op": "builder",
      "kind": "lathe@1",
      "params": {
        "outline": [
          [
            "radius",
            0,
            false
          ],
          [
            "radius * 0.6",
            "0 - radius * 0.4",
            false
          ],
          [
            0,
            "0 - radius * 0.9",
            false
          ]
        ],
        "segments": 9,
        "caps": "flat",
        "shade": "flat",
        "paint": {
          "fill": {
            "role": "muted"
          }
        }
      },
      "at": {
        "pos": [
          0,
          0,
          0
        ]
      }
    },
    "grass": {
      "op": "builder",
      "kind": "plate@1",
      "params": {
        "grid": [
          8,
          8
        ],
        "size": [
          "radius * 1.3",
          "radius * 1.3"
        ],
        "paint": {
          "fill": {
            "role": "accent"
          }
        }
      },
      "at": {
        "pos": [
          0,
          0.02,
          0
        ]
      }
    },
    "rock": {
      "op": "builder",
      "kind": "ball@1",
      "repeat": {
        "count": "rocks",
        "as": "i"
      },
      "params": {
        "radius": "0.3 + (seed % 5) * 0.08",
        "tessellation": "geodesic",
        "base": "icosa",
        "detail": 0,
        "shade": "flat",
        "paint": {
          "fill": {
            "role": "ink"
          }
        }
      },
      "at": {
        "pos": [
          "radius * 0.5 * ((i % 3) - 1)",
          0.3,
          "radius * 0.5 * (floor(i / 3) % 3 - 1)"
        ]
      }
    }
  },
  "outputs": {
    "parts": [
      "body",
      "grass",
      "rock"
    ]
  }
}
