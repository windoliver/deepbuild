(module
  (import "env" "__linear_memory" (memory 1 1))
  (import "lib:physics2d.lib@1" "world" (func $world (param i32 f64 i32 f64)))
  (import "lib:physics2d.lib@1" "body" (func $body (param i32 f64 f64 f64 f64 f64 f64 f64) (result i32)))
  (import "lib:physics2d.lib@1" "step" (func $step (param i32 f64)))
  (import "lib:physics2d.lib@1" "x" (func $x (param i32 i32) (result f64)))
  (import "lib:physics2d.lib@1" "y" (func $y (param i32 i32) (result f64)))
  (global (export "reads_at") i32 (i32.const 0))
  (global (export "writes_at") i32 (i32.const 4096))
  (func (export "init") (param $seed i64)
    (call $world (i32.const 16384) (f64.const 9.81) (i32.const 4) (f64.const 0.8))
    (drop (call $body (i32.const 16384) (f64.const 0) (f64.const 10) (f64.const 0.5) (f64.const 0.5)
      (f64.const 0) (f64.const 0) (f64.const 0.5))))
  (func (export "step") (param $k i64)
    (call $step (i32.const 16384) (f64.div (f64.const 1) (f64.const 120)))
    (f64.store (i32.const 4096) (f64.sub (f64.const 10) (call $y (i32.const 16384) (i32.const 0)))))
  (data (i32.const 8192) "\00"))