{
  "id": "math.stream_lines",
  "version": "1.0",
  "title": "StreamLines",
  "license": "Apache-2.0",
  "author": "DeepBuild",
  "description": "StreamLines(func, x_range, y_range, virtual_time) as one vector_field@1 of streams from a grid of starts, integrated at check. a unit is the frame's short side ÷ 8 in u (fw, fh), so the frame is 14.22 × 8 units at 16:9; y flips and the origin moves to the frame's center; radians become degrees; a stroke width w becomes w × unit ÷ 100 u; font_size f is an em of f ÷ 96 units.",
  "inputs": {
    "x": {
      "type": "text",
      "default": "-y",
      "about": "the field's x component, a function of x and y"
    },
    "y": {
      "type": "text",
      "default": "x",
      "about": "the field's y component, a function of x and y"
    },
    "x_range": {
      "type": "records",
      "default": [
        -7,
        7,
        0.5
      ],
      "about": "x_range: [min, max, delta] the field covers, in units"
    },
    "y_range": {
      "type": "records",
      "default": [
        -4,
        4,
        0.5
      ],
      "about": "y_range: [min, max, delta] the field covers, in units"
    },
    "move_to": {
      "type": "vec3",
      "default": [
        0,
        0,
        0
      ],
      "unit": "unit",
      "about": "move_to: where (0, 0) goes, in units"
    },
    "virtual_time": {
      "type": "number",
      "default": 3,
      "about": "how long each line flows",
      "min": 0
    },
    "dt": {
      "type": "number",
      "default": 0.05,
      "about": "the integration step",
      "min": 0
    },
    "color": {
      "type": "choice",
      "options": [
        "default",
        "BLACK",
        "BLUE_A",
        "BLUE_B",
        "BLUE_C",
        "BLUE_D",
        "BLUE_E",
        "DARK_BROWN",
        "GOLD_A",
        "GOLD_B",
        "GOLD_C",
        "GOLD_D",
        "GOLD_E",
        "GRAY_A",
        "GRAY_B",
        "GRAY_BROWN",
        "GRAY_C",
        "GRAY_D",
        "GRAY_E",
        "GREEN_A",
        "GREEN_B",
        "GREEN_C",
        "GREEN_D",
        "GREEN_E",
        "LIGHT_BROWN",
        "LIGHT_PINK",
        "MAROON_A",
        "MAROON_B",
        "MAROON_C",
        "MAROON_D",
        "MAROON_E",
        "ORANGE",
        "PINK",
        "PURPLE_A",
        "PURPLE_B",
        "PURPLE_C",
        "PURPLE_D",
        "PURPLE_E",
        "RED_A",
        "RED_B",
        "RED_C",
        "RED_D",
        "RED_E",
        "TEAL_A",
        "TEAL_B",
        "TEAL_C",
        "TEAL_D",
        "TEAL_E",
        "WHITE",
        "YELLOW_A",
        "YELLOW_B",
        "YELLOW_C",
        "YELLOW_D",
        "YELLOW_E",
        "BLUE",
        "DARKER_GRAY",
        "DARK_BLUE",
        "DARK_GRAY",
        "GOLD",
        "GRAY",
        "GREEN",
        "GREY",
        "LIGHTER_GRAY",
        "LIGHT_GRAY",
        "MAROON",
        "PURPLE",
        "RED",
        "TEAL",
        "YELLOW"
      ],
      "default": "default",
      "about": "the lines' color; unwritten, the accent role"
    },
    "stroke_width": {
      "type": "number",
      "default": 1,
      "about": "the lines' width, w × unit ÷ 100 u",
      "min": 0
    }
  },
  "let": {
    "unit": "min(fw, fh) / 8",
    "ys": -1,
    "ox": "fw / 2",
    "oy": "fh / 2",
    "cx": "ox + move_to[0] * unit",
    "cy": "oy + ys * move_to[1] * unit",
    "fxw": [
      "cx - fw",
      "cx + fw"
    ],
    "fyw": [
      "cy - ys * fw",
      "cy + ys * fw"
    ],
    "dom": [
      "-fw / unit",
      "fw / unit"
    ],
    "role": "color == default ? accent : color",
    "nx": "floor((x_range[1] - x_range[0]) / x_range[2]) + 1",
    "ny": "floor((y_range[1] - y_range[0]) / y_range[2]) + 1",
    "starts": {
      "repeat": {
        "count": "nx * ny",
        "as": "k",
        "of": [
          "x_range[0] + (k % nx) * x_range[2]",
          "y_range[0] + floor(k / nx) * y_range[2]",
          0
        ]
      }
    }
  },
  "steps": {
    "all": {
      "op": "item",
      "kind": "group@1",
      "params": {}
    },
    "xs": {
      "op": "item",
      "kind": "scale@1",
      "params": {
        "type": "linear",
        "domain": "dom",
        "range": "fxw",
        "nice": false
      },
      "parent": "id(instance, all)"
    },
    "ys": {
      "op": "item",
      "kind": "scale@1",
      "params": {
        "type": "linear",
        "domain": "dom",
        "range": "fyw",
        "nice": false
      },
      "parent": "id(instance, all)"
    },
    "field": {
      "op": "mark",
      "kind": "vector_field@1",
      "params": {
        "fn": {
          "x": "x",
          "y": "y"
        },
        "scales": {
          "x": "id(instance, xs)",
          "y": "id(instance, ys)"
        },
        "streams": {
          "starts": {
            "points": "starts"
          },
          "step": "dt",
          "time": "virtual_time"
        },
        "paint": {
          "stroke": {
            "role": "role",
            "width": "stroke_width * unit / 100"
          }
        }
      },
      "parent": "id(instance, all)"
    }
  },
  "refuses": {
    "noise_factor": "Leave it out: starts sit on the grid exactly, so a check reads the same lines.",
    "n_repeats": "Leave it out: one line per start.",
    "max_anchors_per_line": "Leave it out: lines are integrated to virtual_time.",
    "use_vectorized": "Leave it out: every math@1 shape is a path the renderer strokes and fills on its own.",
    "sheen_factor": "Leave it out: a flat fill has no sheen; use a gradient fill through the look.",
    "sheen_direction": "Leave it out: a flat fill has no sheen; use a gradient fill through the look.",
    "background_stroke_width": "Leave it out, or draw a second, wider copy beneath in the background color.",
    "background_stroke_color": "Leave it out, or draw a second, wider copy beneath in the background color.",
    "joint_type": "Leave it out: paths join by the look's line style.",
    "cap_style": "Leave it out: paths cap by the look's line style.",
    "shade_in_3d": "Leave it out: 2D shapes draw flat; for a lit shape use math.surface."
  }
}
