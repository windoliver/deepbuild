{
  "id": "math.arrow3d",
  "version": "1.0",
  "title": "Arrow3D",
  "license": "Apache-2.0",
  "author": "DeepBuild",
  "description": "Arrow3D(start, end, thickness) as a curve@1 shaft from start to the tip's base and a cone tip. 3D units are math@1 units, as meters.",
  "inputs": {
    "start": {
      "type": "vec3",
      "default": [
        0,
        0,
        0
      ],
      "unit": "m",
      "about": "the start"
    },
    "end": {
      "type": "vec3",
      "default": [
        1,
        1,
        0
      ],
      "unit": "m",
      "about": "the end"
    },
    "thickness": {
      "type": "number",
      "default": 0.02,
      "about": "the shaft's radius",
      "min": 0
    },
    "height": {
      "type": "number",
      "default": 0.3,
      "about": "the tip's height",
      "min": 0
    },
    "base_radius": {
      "type": "number",
      "default": 0.08,
      "about": "the tip's base radius",
      "min": 0
    },
    "tip": {
      "type": "bool",
      "default": true,
      "about": "whether it ends in a cone"
    },
    "color": {
      "type": "choice",
      "options": [
        "default",
        "BLACK",
        "BLUE_A",
        "BLUE_B",
        "BLUE_C",
        "BLUE_D",
        "BLUE_E",
        "DARK_BROWN",
        "GOLD_A",
        "GOLD_B",
        "GOLD_C",
        "GOLD_D",
        "GOLD_E",
        "GRAY_A",
        "GRAY_B",
        "GRAY_BROWN",
        "GRAY_C",
        "GRAY_D",
        "GRAY_E",
        "GREEN_A",
        "GREEN_B",
        "GREEN_C",
        "GREEN_D",
        "GREEN_E",
        "LIGHT_BROWN",
        "LIGHT_PINK",
        "MAROON_A",
        "MAROON_B",
        "MAROON_C",
        "MAROON_D",
        "MAROON_E",
        "ORANGE",
        "PINK",
        "PURPLE_A",
        "PURPLE_B",
        "PURPLE_C",
        "PURPLE_D",
        "PURPLE_E",
        "RED_A",
        "RED_B",
        "RED_C",
        "RED_D",
        "RED_E",
        "TEAL_A",
        "TEAL_B",
        "TEAL_C",
        "TEAL_D",
        "TEAL_E",
        "WHITE",
        "YELLOW_A",
        "YELLOW_B",
        "YELLOW_C",
        "YELLOW_D",
        "YELLOW_E",
        "BLUE",
        "DARKER_GRAY",
        "DARK_BLUE",
        "DARK_GRAY",
        "GOLD",
        "GRAY",
        "GREEN",
        "GREY",
        "LIGHTER_GRAY",
        "LIGHT_GRAY",
        "MAROON",
        "PURPLE",
        "RED",
        "TEAL",
        "YELLOW"
      ],
      "default": "default",
      "about": "the arrow's color; unwritten, the ink role"
    }
  },
  "let": {
    "unit": "min(fw, fh) / 8",
    "ys": -1,
    "ox": "fw / 2",
    "oy": "fh / 2",
    "role": "color == default ? ink : color",
    "dx": "end[0] - start[0]",
    "dy": "end[1] - start[1]",
    "dz": "end[2] - start[2]",
    "len": "sqrt(dx * dx + dy * dy + dz * dz)",
    "k": "tip && len > 0 ? (len - height) / len : 1",
    "base": [
      "start[0] + dx * k",
      "start[1] + dy * k",
      "start[2] + dz * k"
    ]
  },
  "steps": {
    "shaft": {
      "op": "mark",
      "kind": "curve@1",
      "params": {
        "points": [
          "start",
          "base"
        ],
        "mode": "linear",
        "width": "thickness * 2",
        "paint": {
          "stroke": {
            "role": "role"
          }
        }
      }
    },
    "cone": {
      "op": "builder",
      "kind": "lathe@1",
      "when": "tip",
      "params": {
        "outline": [
          [
            0,
            0
          ],
          [
            "base_radius",
            0
          ],
          [
            0,
            "height"
          ]
        ],
        "segments": 24,
        "axis": "y",
        "caps": "none",
        "paint": {
          "fill": {
            "role": "role"
          }
        }
      },
      "at": {
        "pos": "base",
        "rot": [
          0,
          0,
          0
        ]
      }
    }
  },
  "refuses": {
    "resolution": "Leave it out: the shaft is a curve and the tip a 24-segment cone.",
    "use_vectorized": "Leave it out: every math@1 shape is a path the renderer strokes and fills on its own.",
    "sheen_factor": "Leave it out: a flat fill has no sheen; use a gradient fill through the look.",
    "sheen_direction": "Leave it out: a flat fill has no sheen; use a gradient fill through the look.",
    "background_stroke_width": "Leave it out, or draw a second, wider copy beneath in the background color.",
    "background_stroke_color": "Leave it out, or draw a second, wider copy beneath in the background color.",
    "joint_type": "Leave it out: paths join by the look's line style.",
    "cap_style": "Leave it out: paths cap by the look's line style.",
    "shade_in_3d": "Leave it out: 2D shapes draw flat; for a lit shape use math.surface."
  }
}
