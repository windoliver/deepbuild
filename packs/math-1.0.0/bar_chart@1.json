{
  "id": "math.bar_chart",
  "version": "1.0",
  "title": "BarChart",
  "license": "Apache-2.0",
  "author": "DeepBuild",
  "description": "BarChart(values, bar_names) as a y scale@1 and axis@1 and one rect@1 bar per value from the base line, each bar's name as text@1 beneath it. a unit is the frame's short side ÷ 8 in u (fw, fh), so the frame is 14.22 × 8 units at 16:9; y flips and the origin moves to the frame's center; radians become degrees; a stroke width w becomes w × unit ÷ 100 u; font_size f is an em of f ÷ 96 units.",
  "inputs": {
    "values": {
      "type": "records",
      "default": [
        1,
        2,
        3
      ],
      "about": "the bars' values"
    },
    "bar_names": {
      "type": "records",
      "default": [],
      "about": "each bar's name, as text"
    },
    "y_range": {
      "type": "records",
      "default": [
        0,
        4,
        1
      ],
      "about": "y_range: [min, max, step]"
    },
    "x_length": {
      "type": "number",
      "default": 12,
      "about": "the chart's width in units",
      "min": 0
    },
    "y_length": {
      "type": "number",
      "default": 6,
      "about": "the chart's height in units",
      "min": 0
    },
    "bar_width": {
      "type": "number",
      "default": 0.6,
      "about": "each bar's share of its slot",
      "min": 0,
      "max": 1
    },
    "bar_fill_opacity": {
      "type": "number",
      "default": 0.7,
      "about": "the bars' fill opacity",
      "min": 0,
      "max": 1
    },
    "move_to": {
      "type": "vec3",
      "default": [
        0,
        0,
        0
      ],
      "unit": "unit",
      "about": "move_to: the chart's center, in units"
    },
    "color": {
      "type": "choice",
      "options": [
        "default",
        "BLACK",
        "BLUE_A",
        "BLUE_B",
        "BLUE_C",
        "BLUE_D",
        "BLUE_E",
        "DARK_BROWN",
        "GOLD_A",
        "GOLD_B",
        "GOLD_C",
        "GOLD_D",
        "GOLD_E",
        "GRAY_A",
        "GRAY_B",
        "GRAY_BROWN",
        "GRAY_C",
        "GRAY_D",
        "GRAY_E",
        "GREEN_A",
        "GREEN_B",
        "GREEN_C",
        "GREEN_D",
        "GREEN_E",
        "LIGHT_BROWN",
        "LIGHT_PINK",
        "MAROON_A",
        "MAROON_B",
        "MAROON_C",
        "MAROON_D",
        "MAROON_E",
        "ORANGE",
        "PINK",
        "PURPLE_A",
        "PURPLE_B",
        "PURPLE_C",
        "PURPLE_D",
        "PURPLE_E",
        "RED_A",
        "RED_B",
        "RED_C",
        "RED_D",
        "RED_E",
        "TEAL_A",
        "TEAL_B",
        "TEAL_C",
        "TEAL_D",
        "TEAL_E",
        "WHITE",
        "YELLOW_A",
        "YELLOW_B",
        "YELLOW_C",
        "YELLOW_D",
        "YELLOW_E",
        "BLUE",
        "DARKER_GRAY",
        "DARK_BLUE",
        "DARK_GRAY",
        "GOLD",
        "GRAY",
        "GREEN",
        "GREY",
        "LIGHTER_GRAY",
        "LIGHT_GRAY",
        "MAROON",
        "PURPLE",
        "RED",
        "TEAL",
        "YELLOW"
      ],
      "default": "default",
      "about": "the bars' color; unwritten, the accent role"
    }
  },
  "let": {
    "unit": "min(fw, fh) / 8",
    "ys": -1,
    "ox": "fw / 2",
    "oy": "fh / 2",
    "role": "color == default ? accent : color",
    "cx": "ox + move_to[0] * unit",
    "cy": "oy + ys * move_to[1] * unit",
    "n": "max(len(values), 1)",
    "lo": "y_range[0]",
    "hi": "y_range[1]",
    "yd": "len(y_range) > 2 ? y_range[2] : 1",
    "x0": "cx - x_length / 2 * unit",
    "x1": "cx + x_length / 2 * unit",
    "y0": "cy - ys * y_length / 2 * unit",
    "y1": "cy + ys * y_length / 2 * unit",
    "slot": "(x1 - x0) / n",
    "base": "y0 + (y1 - y0) * (max(lo, 0) - lo) / (hi - lo)"
  },
  "steps": {
    "all": {
      "op": "item",
      "kind": "group@1",
      "params": {}
    },
    "yscale": {
      "op": "item",
      "kind": "scale@1",
      "params": {
        "type": "linear",
        "domain": [
          "lo",
          "hi"
        ],
        "range": [
          "y0",
          "y1"
        ],
        "nice": false,
        "ticks": "yd"
      },
      "parent": "id(instance, all)"
    },
    "yaxis": {
      "op": "item",
      "kind": "axis@1",
      "params": {
        "scale": "id(instance, yscale)",
        "side": "left",
        "at": "x0",
        "role": "ink"
      },
      "parent": "id(instance, all)"
    },
    "baseline": {
      "op": "mark",
      "kind": "path@1",
      "params": {
        "d": "polyline(x0, base, x1, base)",
        "paint": {
          "stroke": {
            "role": "ink",
            "width": "2 * unit / 100"
          }
        }
      },
      "parent": "id(instance, all)"
    },
    "bar": {
      "op": "mark",
      "kind": "rect@1",
      "repeat": {
        "over": "values",
        "as": "v"
      },
      "let": {
        "top": "y0 + (y1 - y0) * (v - lo) / (hi - lo)"
      },
      "params": {
        "box": [
          "x0 + (i + (1 - bar_width) / 2) * slot",
          "min(top, base)",
          "bar_width * slot",
          "abs(top - base)"
        ],
        "paint": {
          "fill": {
            "role": "role",
            "opacity": "bar_fill_opacity"
          }
        }
      },
      "parent": "id(instance, all)"
    },
    "name": {
      "op": "mark",
      "kind": "text@1",
      "repeat": {
        "over": "bar_names",
        "as": "b"
      },
      "params": {
        "text": "b",
        "name": true,
        "font": "body",
        "size": "24 / 96 * unit",
        "paint": {
          "fill": {
            "role": "ink"
          }
        }
      },
      "at": {
        "place": {
          "onto": [
            "x0 + (i + 0.5) * slot",
            "base + 0.4 * unit"
          ]
        }
      },
      "parent": "id(instance, all)"
    }
  },
  "refuses": {
    "bar_colors": "Write color: every bar takes one color.",
    "bar_stroke_width": "Leave it out: bars are filled, unstroked.",
    "use_vectorized": "Leave it out: every math@1 shape is a path the renderer strokes and fills on its own.",
    "sheen_factor": "Leave it out: a flat fill has no sheen; use a gradient fill through the look.",
    "sheen_direction": "Leave it out: a flat fill has no sheen; use a gradient fill through the look.",
    "background_stroke_width": "Leave it out, or draw a second, wider copy beneath in the background color.",
    "background_stroke_color": "Leave it out, or draw a second, wider copy beneath in the background color.",
    "joint_type": "Leave it out: paths join by the look's line style.",
    "cap_style": "Leave it out: paths cap by the look's line style.",
    "shade_in_3d": "Leave it out: 2D shapes draw flat; for a lit shape use math.surface."
  }
}
