  "let": {
    "unit": "min(fw, fh) / 8",
    "ys": -1,
    "ox": "fw / 2",
    "oy": "fh / 2",
    "run_role": "dx_line_color == default ? muted : dx_line_color",
    "rise_role": "dy_line_color == default ? muted : dy_line_color",
    "sec_role": "secant_line_color == default ? accent : secant_line_color",
    "axr_def": [
      -7,
      7,
      1
    ],
    "ayr_def": [
      -4,
      4,
      1
    ],
    "amove_def": [
      0,
      0,
      0
    ],
    "axr": "has(axes_params, x_range) ? axes_params.x_range : axr_def",
    "ayr": "has(axes_params, y_range) ? axes_params.y_range : ayr_def",
    "axl": "has(axes_params, x_length) ? axes_params.x_length : 12",
    "ayl": "has(axes_params, y_length) ? axes_params.y_length : 6",
    "amove": "has(axes_params, move_to) ? axes_params.move_to : amove_def",
    "acx": "ox + amove[0] * unit",
    "acy": "oy + ys * amove[1] * unit",
    "axm": "(axr[0] + axr[1]) / 2",
    "aym": "(ayr[0] + ayr[1]) / 2",
    "xu_per": "axl * unit / (axr[1] - axr[0])",
    "yu_per": "ayl * unit / (ayr[1] - ayr[0])",
    "graph_at": {
      "pos": [
        "acx - axm * xu_per",
        "acy - ys * aym * yu_per",
        0
      ],
      "scale": [
        "xu_per",
        "ys * yu_per",
        1
      ]
    },
    "x1": "x + dx",
    "f0": "value_at(f, x)",
    "f1": "value_at(f, x + dx)",
    "m": "dx != 0 ? (f1 - f0) / dx : 0",
    "half": "secant_line_length / 2 / sqrt(1 + m * m)",
    "w": "2 * unit / 100"
  },
  "steps": {
    "all": {
      "op": "item",
      "kind": "group@1",
      "params": {}
    },
    "run": {
      "op": "mark",
      "kind": "path@1",
      "at": "graph_at",
      "params": {
        "fn": {
          "y": "\\c",
          "vars": {
            "c": "f0"
          },
          "over": [
            "x",
            "x1"
          ]
        },
        "paint": {
          "stroke": {
            "role": "run_role",
            "width": "w",
            "opacity": 1
          }
        }
      },
      "parent": "id(instance, all)"
    },
    "rise": {
      "op": "mark",
      "kind": "path@1",
      "at": "graph_at",
      "params": {
        "fn": {
          "x": "\\a",
          "y": "\\c + s * (d - c)",
          "vars": {
            "a": "x1",
            "c": "f0",
            "d": "f1"
          },
          "over": [
            0,
            1
          ]
        },
        "paint": {
          "stroke": {
            "role": "rise_role",
            "width": "w",
            "opacity": 1
          }
        }
      },
      "parent": "id(instance, all)"
    },
    "secant": {
      "op": "mark",
      "kind": "path@1",
      "at": "graph_at",
      "params": {
        "fn": {
          "y": "\\c + (x - a) * k",
          "vars": {
            "a": "x",
            "c": "f0",
            "k": "m"
          },
          "over": [
            "(x + x1) / 2 - half",
            "(x + x1) / 2 + half"
          ]
        },
        "paint": {
          "stroke": {
            "role": "sec_role",
            "width": "w",
            "opacity": 1
          }
        }
      },
      "parent": "id(instance, all)"
    }
  },
  "refuses": {
    "dx_label": "Place a vector@1 label beside the run yourself: labels are typeset, never drawn here.",
    "dy_label": "Place a vector@1 label beside the rise yourself: labels are typeset, never drawn here.",
    "include_secant_line": "Leave it out, or set secant_line_length to 0.",
    "use_vectorized": "Leave it out: every math@1 shape is a path the renderer strokes and fills on its own.",
    "sheen_factor": "Leave it out: a flat fill has no sheen; use a gradient fill through the look.",
    "sheen_direction": "Leave it out: a flat fill has no sheen; use a gradient fill through the look.",
    "background_stroke_width": "Leave it out, or draw a second, wider copy beneath in the background color.",
    "background_stroke_color": "Leave it out, or draw a second, wider copy beneath in the background color.",
    "joint_type": "Leave it out: paths join by the look's line style.",
    "cap_style": "Leave it out: paths cap by the look's line style.",
    "shade_in_3d": "Leave it out: 2D shapes draw flat; for a lit shape use math.surface."
  }
