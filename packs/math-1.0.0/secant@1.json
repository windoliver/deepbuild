      "type": "number",
      "default": 1,
      "about": "where the secant starts"
    },
    "dx": {
      "type": "number",
      "default": 0.1,
      "about": "how far it runs"
    },
    "secant_line_length": {
      "type": "number",
      "default": 10,
      "about": "the secant line's length in units of x",
      "min": 0
    },
    "dx_line_color": {
