{
  "id": "math.riemann",
  "version": "1.0",
  "title": "Axes.get_riemann_rectangles",
  "license": "Apache-2.0",
  "author": "DeepBuild",
  "description": "ax.get_riemann_rectangles(graph, x_range, dx, input_sample_type, show_signed_area) as one closed path@1 per rectangle on the plot's axes: rectangle i spans [a + i dx, a + (i + 1) dx] and rises from the x axis to f at its sample, f read at check; graph is the math.plot instance, whose f and x range it reads, placed as its axes place values. a unit is the frame's short side ÷ 8 in u (fw, fh), so the frame is 14.22 × 8 units at 16:9; y flips and the origin moves to the frame's center; radians become degrees; a stroke width w becomes w × unit ÷ 100 u; font_size f is an em of f ÷ 96 units.",
  "inputs": {
    "plot": {
      "type": "ID",
      "default": "none",
      "about": "graph: the ID of the math.plot instance the rectangles are under"
    },
    "x_range": {
      "type": "records",
      "default": [],
      "about": "x_range: [min, max] the rectangles cover; unwritten, the graph's"
    },
    "dx": {
      "type": "number",
      "default": 0.1,
      "about": "each rectangle's width in x",
      "min": 0
    },
    "input_sample_type": {
      "type": "choice",
      "options": [
        "left",
        "right",
        "center"
      ],
      "default": "left",
      "about": "where each rectangle samples f"
    },
    "show_signed_area": {
      "type": "bool",
      "default": true,
      "about": "rectangles below the axis take the second color"
    },
    "color": {
      "type": "choice",
      "options": [
        "default",
        "BLACK",
        "BLUE_A",
        "BLUE_B",
        "BLUE_C",
        "BLUE_D",
        "BLUE_E",
        "DARK_BROWN",
        "GOLD_A",
        "GOLD_B",
        "GOLD_C",
        "GOLD_D",
        "GOLD_E",
        "GRAY_A",
        "GRAY_B",
        "GRAY_BROWN",
        "GRAY_C",
        "GRAY_D",
        "GRAY_E",
        "GREEN_A",
        "GREEN_B",
        "GREEN_C",
        "GREEN_D",
        "GREEN_E",
        "LIGHT_BROWN",
        "LIGHT_PINK",
        "MAROON_A",
        "MAROON_B",
        "MAROON_C",
        "MAROON_D",
        "MAROON_E",
        "ORANGE",
        "PINK",
        "PURPLE_A",
        "PURPLE_B",
        "PURPLE_C",
        "PURPLE_D",
        "PURPLE_E",
        "RED_A",
        "RED_B",
        "RED_C",
        "RED_D",
        "RED_E",
        "TEAL_A",
        "TEAL_B",
        "TEAL_C",
        "TEAL_D",
        "TEAL_E",
        "WHITE",
        "YELLOW_A",
        "YELLOW_B",
        "YELLOW_C",
        "YELLOW_D",
        "YELLOW_E",
        "BLUE",
        "DARKER_GRAY",
        "DARK_BLUE",
        "DARK_GRAY",
        "GOLD",
        "GRAY",
        "GREEN",
        "GREY",
        "LIGHTER_GRAY",
        "LIGHT_GRAY",
        "MAROON",
        "PURPLE",
        "RED",
        "TEAL",
        "YELLOW"
      ],
      "default": "default",
      "about": "the rectangles' color; unwritten, the accent role"
    },
    "negative_color": {
      "type": "choice",
      "options": [
        "default",
        "BLACK",
        "BLUE_A",
        "BLUE_B",
        "BLUE_C",
        "BLUE_D",
        "BLUE_E",
        "DARK_BROWN",
        "GOLD_A",
        "GOLD_B",
        "GOLD_C",
        "GOLD_D",
        "GOLD_E",
        "GRAY_A",
        "GRAY_B",
        "GRAY_BROWN",
        "GRAY_C",
        "GRAY_D",
        "GRAY_E",
        "GREEN_A",
        "GREEN_B",
        "GREEN_C",
        "GREEN_D",
        "GREEN_E",
        "LIGHT_BROWN",
        "LIGHT_PINK",
        "MAROON_A",
        "MAROON_B",
        "MAROON_C",
        "MAROON_D",
        "MAROON_E",
        "ORANGE",
        "PINK",
        "PURPLE_A",
        "PURPLE_B",
        "PURPLE_C",
        "PURPLE_D",
        "PURPLE_E",
        "RED_A",
        "RED_B",
        "RED_C",
        "RED_D",
        "RED_E",
        "TEAL_A",
        "TEAL_B",
        "TEAL_C",
        "TEAL_D",
        "TEAL_E",
        "WHITE",
        "YELLOW_A",
        "YELLOW_B",
        "YELLOW_C",
        "YELLOW_D",
        "YELLOW_E",
        "BLUE",
        "DARKER_GRAY",
        "DARK_BLUE",
        "DARK_GRAY",
        "GOLD",
        "GRAY",
        "GREEN",
        "GREY",
        "LIGHTER_GRAY",
        "LIGHT_GRAY",
        "MAROON",
        "PURPLE",
        "RED",
        "TEAL",
        "YELLOW"
      ],
      "default": "default",
      "about": "the color below the axis; unwritten, the muted role"
    },
    "fill_opacity": {
      "type": "number",
      "default": 1,
      "about": "the rectangles' fill opacity",
      "min": 0,
      "max": 1
    },
    "stroke_width": {
      "type": "number",
      "default": 1,
      "about": "the rectangles' outline width, w × unit ÷ 100 u",
      "min": 0
    }
  },
  "let": {
    "unit": "min(fw, fh) / 8",
    "ys": -1,
    "ox": "fw / 2",
    "oy": "fh / 2",
    "role": "color == default ? accent : color",
    "neg": "negative_color == default ? muted : negative_color",
    "blank_rec": {},
    "f": "has(plot_params, f) ? plot_params.f : x",
    "ap": "has(plot_params, axes_params) ? plot_params.axes_params : blank_rec",
    "axr_def": [
      -7,
      7,
      1
    ],
    "ayr_def": [
      -4,
      4,
      1
    ],
    "amove_def": [
      0,
      0,
      0
    ],
    "axr": "has(ap, x_range) ? ap.x_range : axr_def",
    "ayr": "has(ap, y_range) ? ap.y_range : ayr_def",
    "axl": "has(ap, x_length) ? ap.x_length : 12",
    "ayl": "has(ap, y_length) ? ap.y_length : 6",
    "amove": "has(ap, move_to) ? ap.move_to : amove_def",
    "acx": "ox + amove[0] * unit",
    "acy": "oy + ys * amove[1] * unit",
    "axm": "(axr[0] + axr[1]) / 2",
    "aym": "(ayr[0] + ayr[1]) / 2",
    "xu_per": "axl * unit / (axr[1] - axr[0])",
    "yu_per": "ayl * unit / (ayr[1] - ayr[0])",
    "plot_range": "has(plot_params, x_range) ? plot_params.x_range : axr",
    "graph_range": "len(plot_range) >= 2 ? plot_range : axr",
    "xr": "len(x_range) >= 2 ? x_range : graph_range",
    "a": "xr[0]",
    "n": "round((xr[1] - a) / dx)",
    "s": "input_sample_type == left ? 0 : (input_sample_type == right ? 1 : 0.5)",
    "base": "acy + ys * (0 - aym) * yu_per",
    "width": "stroke_width * unit / 100"
  },
  "steps": {
    "all": {
      "op": "item",
      "kind": "group@1",
      "params": {}
    },
    "bar": {
      "op": "mark",
      "kind": "path@1",
      "repeat": {
        "count": "n",
        "as": "i"
      },
      "let": {
        "fs": "value_at(f, a + (i + s) * dx)",
        "l": "acx + (a + i * dx - axm) * xu_per",
        "r": "acx + (a + (i + 1) * dx - axm) * xu_per",
        "top": "acy + ys * (fs - aym) * yu_per"
      },
      "params": {
        "d": "polyline(l, base, r, base, r, top, l, top, l, base)",
        "paint": {
          "fill": {
            "role": "fs < 0 && show_signed_area ? neg : role",
            "opacity": "fill_opacity"
          },
          "stroke": {
            "role": "ink",
            "width": "width"
          }
        }
      },
      "parent": "id(instance, all)"
    }
  },
  "refuses": {
    "bounded_graph": "Draw the area between two graphs with math.area {bounded_graph} instead.",
    "blend": "Leave it out: each rectangle takes one color.",
    "width_scale_factor": "Leave it out: rectangles meet edge to edge.",
    "use_vectorized": "Leave it out: every math@1 shape is a path the renderer strokes and fills on its own.",
    "sheen_factor": "Leave it out: a flat fill has no sheen; use a gradient fill through the look.",
    "sheen_direction": "Leave it out: a flat fill has no sheen; use a gradient fill through the look.",
    "background_stroke_width": "Leave it out, or draw a second, wider copy beneath in the background color.",
    "background_stroke_color": "Leave it out, or draw a second, wider copy beneath in the background color.",
    "joint_type": "Leave it out: paths join by the look's line style.",
    "cap_style": "Leave it out: paths cap by the look's line style.",
    "shade_in_3d": "Leave it out: 2D shapes draw flat; for a lit shape use math.surface."
  }
}
