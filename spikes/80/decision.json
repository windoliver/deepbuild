    "#80.6231c088": {
      "criterion": "An idle interactive Claude Code session, in the terminal and in the desktop app (never `claude -p`, which ends async hooks at teardown), wakes on an answer, or the fallback is documented with its delay",
      "status": "PASS",
      "findings": [
        {
          "surface": "claude-terminal",
          "log": "logs/claude-terminal.jsonl",
          "session": "0b1dba30-7d4e-4c66-83df-ce84df27db32",
          "result": "woke",
          "invocation": "1731676df86e"
        },
        {
          "surface": "claude-desktop",
          "log": "logs/claude-desktop.jsonl",
          "session": "4efa4b70-98df-4d62-b0d5-98260935a841",
          "result": "woke",
          "invocation": "bca4518d83bc",
          "transcript": "logs/claude-desktop-transcript.jsonl"
        }
      ],
      "decision": {
        "why": "Woke in the terminal (2.1.303) and the desktop app (2.1.299) with no prompt typed; the wake arrives as a UserPromptSubmit whose prompt is a task-notification with the waiter's stderr. Earlier waiters keep running in the desktop app, so one answer can wake a session more than once: the adapter must end the old waiter itself."
      }
    },
    "#80.9492ec1f": {
      "criterion": "A message typed mid-turn shows up as an ask at the next hook",
      "status": "BLOCKED",
      "findings": [],
      "decision": {
        "blockedOn": "Needs a person to type into a Claude desktop session while one of its tool calls runs; nothing was typed mid-call in the desktop runs. In the terminal (2.1.303) a typed message fires UserPromptSubmit at once and is queued, which the hook records as an ask."
      }
    },
    "#80.8c6cf36a": {
      "criterion": "The verdict line appears in both apps' chats",
      "status": "PASS",
      "findings": [
        {
          "surface": "codex-desktop",
          "log": "logs/codex-desktop.jsonl",
          "session": "01a155d9-981c-7a20-a6bc-466975b4739d",
          "invocation": "020c5bbb2e72",
          "recording": {
            "sha256": "d0e7469aa20c7525035d5929ac505cb29badfdb3b8ff5826803ae4da57cc6c55",
            "bytes": 4680255,
            "type": "video/mp4"
          }
        },
        {
          "surface": "claude-desktop",
          "log": "logs/claude-desktop.jsonl",
          "session": "4efa4b70-98df-4d62-b0d5-98260935a841",
          "invocation": "de42ef7dad50",
          "transcript": "logs/claude-desktop-transcript.jsonl"
        }
      ],
      "decision": {
        "codexDesktop": "On Codex Desktop 0.160.0 only a send-back verdict shows in the chat, as the continuation bubble with Hook feedback. A passing stop's systemMessage, a stopReason with continue: false and a UserPromptSubmit systemMessage all stay out of the chat, so a PASS line goes to the next prompt and the DeepBuild app.",
        "claudeDesktop": "The Stop systemMessage verdict is saved as a hook_system_message the desktop chat shows, for PASS and FAIL alike.",
        "limit": "Codex Desktop 0.160.0 shows only a send-back verdict; a PASS line there goes to the next prompt and the DeepBuild app."
      }
    },
