         let instance_buffer_pool = self.instance_buffer_pool.clone();
         let instance_buffer = Cell::new(Some(writer.finish()));
-        let block = RcBlock::new(move |_: ptr::NonNull<AnyObject>| {
+        // Every caller commits the buffer it gets back, so the surfaces it
+        // samples are reported here, before its completed handler can run.
+        let reported_buffer = (!self.sampled_surfaces.is_empty()).then(|| {
+            let buffer = surface_reports::next_buffer();
+            surface_reports::report(surface_reports::Event::Committed {
+                buffer,
+                surfaces: mem::take(&mut self.sampled_surfaces),
+            });
+            buffer
+        });
+        let block = RcBlock::new(move |command_buffer: ptr::NonNull<AnyObject>| {
             if let Some(instance_buffer) = instance_buffer.take() {
                 instance_buffer_pool.lock().release(instance_buffer);
             }
+            if let Some(buffer) = reported_buffer {
+                // SAFETY: Metal hands a completed handler the command buffer it
+                // completed; `GPUStartTime` and `GPUEndTime` are its
+                // `CFTimeInterval` (seconds as f64) properties.
+                let (start, end): (f64, f64) = unsafe {
+                    (
+                        objc2::msg_send![command_buffer.as_ref(), GPUStartTime],
+                        objc2::msg_send![command_buffer.as_ref(), GPUEndTime],
+                    )
+                };
+                let gpu_ns = ((end - start).max(0.0) * 1e9).round() as u64;
+                surface_reports::report(surface_reports::Event::Completed { buffer, gpu_ns });
+            }
         });
         // SAFETY: Both pointee types are opaque views of the same Objective-C block pointer ABI.
         unsafe {
@@ -1298,6 +1375,8 @@ impl MetalRenderer {
