+
+    #[test]
+    fn report_the_surfaces_a_frame_samples() {
+        use surface_reports::Event;
+
+        let (sender, events) = std::sync::mpsc::channel();
+        surface_reports::set_hook(Some(Arc::new(move |event| {
+            sender.send(event).ok();
+        })));
+
+        let image_buffer = bgra_pixel_buffer(16, 16, |_, _| [0, 0, 0, 255]);
+        let address = ptr::from_ref(&*image_buffer) as usize as u64;
+        let scene = surface_scene(&image_buffer);
+        let mut renderer = MetalRenderer::new_headless(Arc::new(Mutex::new(Default::default())));
+        renderer
+            .render_scene_to_image(&scene, size(DevicePixels(16), DevicePixels(16)))
+            .unwrap();
+
+        // Other tests render surfaces of their own in parallel, so take the
+        // report for this pixel buffer and ignore the rest.
+        let timeout = std::time::Duration::from_secs(5);
+        let buffer = loop {
+            match events.recv_timeout(timeout).expect("a Committed event") {
+                Event::Committed { buffer, surfaces } if surfaces.contains(&address) => {
+                    assert_eq!(surfaces, vec![address]);
+                    break buffer;
+                }
+                _ => {}
+            }
+        };
+        loop {
+            match events.recv_timeout(timeout).expect("a Completed event") {
+                Event::Completed {
+                    buffer: completed, ..
+                } if completed == buffer => break,
+                _ => {}
+            }
+        }
+    }
 }
