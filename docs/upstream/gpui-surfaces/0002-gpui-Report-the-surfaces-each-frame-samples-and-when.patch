From ed0575d911da54bd9cda269299b23c3c94b3583f Mon Sep 17 00:00:00 2001
From: SophiaWJ <jingwangsophia@gmail.com>
Date: Sun, 25 Oct 2026 15:54:07 -0700
Subject: [PATCH 2/2] gpui: Report the surfaces each frame samples and when it
 completes

A renderer that hands `paint_surface` its pixel buffers, drawing into a
few of them in turn, needs to know when GPUI's frame command buffer has
finished reading one before it draws into it again or lets it go. Metal
retains the texture for the command buffer's lifetime, but nothing told
the producer which buffers a frame sampled, or when the frame was done.

Add `metal_renderer::surface_reports`: one process-wide hook that gets,
for every frame command buffer that samples at least one surface, a
`Committed` event naming the pixel buffers it samples (by address) as
`render_frame` returns it to its caller, which commits it, and a
`Completed` event from the buffer's completed handler, with the GPU time
the buffer took. Frames that sample no surface report nothing, so the
hook costs nothing where `paint_surface` isn't used.

The test installs the hook, renders a BGRA surface headlessly, and
checks a `Committed` event names that pixel buffer alone and a
`Completed` event follows for the same command buffer.
---
 crates/gpui_apple/src/metal_renderer.rs | 122 +++++++++++++++++++++++-
 1 file changed, 121 insertions(+), 1 deletion(-)

diff --git a/crates/gpui_apple/src/metal_renderer.rs b/crates/gpui_apple/src/metal_renderer.rs
index 0c51adc..45528fd 100644
--- a/crates/gpui_apple/src/metal_renderer.rs
+++ b/crates/gpui_apple/src/metal_renderer.rs
@@ -29,6 +29,56 @@ use std::{cell::Cell, ffi::c_void, mem, mem::MaybeUninit, ops::Range, ptr, slice
 // Exported to metal
 pub(crate) type PointF = gpui::Point<f32>;
 
+/// Reports, per frame command buffer, which `paint_surface` pixel buffers it
+/// samples and when it completes, so whoever produces those buffers can keep
+/// one alive, or refrain from drawing into it again, until the GPU is done
+/// reading it.
+///
+/// A frame that samples at least one surface reports `Committed` from
+/// `render_frame`, before its caller commits the command buffer, and
+/// `Completed` from the buffer's completed handler, on Metal's thread. Frames
+/// that sample no surface report nothing.
+pub mod surface_reports {
+    use std::sync::atomic::{AtomicU64, Ordering};
+    use std::sync::{Arc, RwLock};
+
+    /// One frame command buffer's report. `buffer` numbers the command buffer,
+    /// the same number in both events; each surface is its `CVPixelBuffer`'s
+    /// address.
+    #[derive(Clone, Debug, PartialEq, Eq)]
+    pub enum Event {
+        Committed {
+            buffer: u64,
+            surfaces: Vec<u64>,
+        },
+        /// The command buffer completed, having spent `gpu_ns` on the GPU.
+        Completed {
+            buffer: u64,
+            gpu_ns: u64,
+        },
+    }
+
+    pub type Hook = Arc<dyn Fn(Event) + Send + Sync>;
+
+    static HOOK: RwLock<Option<Hook>> = RwLock::new(None);
+    static NEXT_BUFFER: AtomicU64 = AtomicU64::new(1);
+
+    /// Installs the one process-wide hook, replacing any earlier one.
+    pub fn set_hook(hook: Option<Hook>) {
+        *HOOK.write().unwrap_or_else(|e| e.into_inner()) = hook;
+    }
+
+    pub(super) fn next_buffer() -> u64 {
+        NEXT_BUFFER.fetch_add(1, Ordering::Relaxed)
+    }
+
+    pub(super) fn report(event: Event) {
+        if let Some(hook) = HOOK.read().unwrap_or_else(|e| e.into_inner()).as_ref() {
+            hook(event);
+        }
+    }
+}
