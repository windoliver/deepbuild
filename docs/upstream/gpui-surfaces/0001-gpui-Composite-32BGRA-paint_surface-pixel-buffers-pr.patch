     fn render_core_video_surface() {
         let attributes = CFDictionary::from_slices(
diff --git a/crates/gpui_apple/src/shaders.metal b/crates/gpui_apple/src/shaders.metal
index 2b52bb9..851c64b 100644
--- a/crates/gpui_apple/src/shaders.metal
+++ b/crates/gpui_apple/src/shaders.metal
@@ -899,6 +899,17 @@ fragment float4 surface_fragment(SurfaceFragmentInput input [[stage_in]],
   return ycbcrToRGBTransform * ycbcr;
 }
 
+// A 32BGRA surface holds color premultiplied by alpha. It is read texel for
+// texel (its size is the surface's bounds in device pixels) and its pipeline
+// blends with source factor one, so a texel's light shows even where its alpha
+// is zero.
+fragment float4 bgra_surface_fragment(SurfaceFragmentInput input [[stage_in]],
+                                      texture2d<float> bgra_texture
+                                      [[texture(SurfaceInputIndex_YTexture)]]) {
+  constexpr sampler texture_sampler(mag_filter::nearest, min_filter::nearest);
+  return bgra_texture.sample(texture_sampler, input.texture_position);
+}
