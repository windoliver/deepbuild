@@ -1702,11 +1781,110 @@ mod tests {
     use super::*;
     use objc2_core_foundation::{CFDictionary, CFType};
     use objc2_core_video::{
-        CVPixelBufferCreate, CVPixelBufferGetBaseAddressOfPlane,
-        CVPixelBufferGetBytesPerRowOfPlane, CVPixelBufferLockBaseAddress, CVPixelBufferLockFlags,
-        CVPixelBufferUnlockBaseAddress, kCVPixelBufferIOSurfacePropertiesKey,
+        CVPixelBufferCreate, CVPixelBufferGetBaseAddress, CVPixelBufferGetBaseAddressOfPlane,
+        CVPixelBufferGetBytesPerRow, CVPixelBufferGetBytesPerRowOfPlane,
+        CVPixelBufferLockBaseAddress, CVPixelBufferLockFlags, CVPixelBufferUnlockBaseAddress,
+        kCVPixelBufferIOSurfacePropertiesKey,
     };
 
+    /// A 32BGRA, IOSurface-backed pixel buffer of `width` × `height`, filled
+    /// by `texel(x, y) -> [b, g, r, a]`.
+    fn bgra_pixel_buffer(
+        width: usize,
+        height: usize,
+        texel: impl Fn(usize, usize) -> [u8; 4],
+    ) -> CFRetained<objc2_core_video::CVPixelBuffer> {
+        let attributes = CFDictionary::from_slices(
+            &[unsafe { kCVPixelBufferIOSurfacePropertiesKey }],
+            &[&*CFDictionary::<CFType, CFType>::empty()],
+        );
+        let mut image_buffer = ptr::null_mut();
+        assert_eq!(
+            unsafe {
+                CVPixelBufferCreate(
+                    None,
+                    width,
+                    height,
+                    kCVPixelFormatType_32BGRA,
+                    Some(attributes.as_opaque()),
+                    ptr::NonNull::from(&mut image_buffer),
+                )
+            },
+            kCVReturnSuccess
+        );
+        let image_buffer =
+            unsafe { CFRetained::from_raw(ptr::NonNull::new(image_buffer).unwrap()) };
+        unsafe {
+            assert_eq!(
+                CVPixelBufferLockBaseAddress(&image_buffer, CVPixelBufferLockFlags::empty()),
+                kCVReturnSuccess
+            );
+            let bytes = CVPixelBufferGetBaseAddress(&image_buffer).cast::<u8>();
+            let stride = CVPixelBufferGetBytesPerRow(&image_buffer);
+            let rows = slice::from_raw_parts_mut(bytes, stride * height);
+            for y in 0..height {
+                for x in 0..width {
+                    rows[y * stride + x * 4..][..4].copy_from_slice(&texel(x, y));
+                }
+            }
+            assert_eq!(
+                CVPixelBufferUnlockBaseAddress(&image_buffer, CVPixelBufferLockFlags::empty()),
+                kCVReturnSuccess
+            );
+        }
+        image_buffer
+    }
+
+    fn surface_scene(image_buffer: &CFRetained<objc2_core_video::CVPixelBuffer>) -> Scene {
+        let bounds = Bounds {
+            origin: Point::default(),
+            size: size(ScaledPixels(16.0), ScaledPixels(16.0)),
+        };
+        let mut scene = Scene::default();
+        scene.insert_primitive(PaintSurface {
+            order: 0,
+            bounds,
+            content_mask: ContentMask { bounds },
+            image_buffer: image_buffer.clone(),
+        });
+        scene.finish();
+        scene
+    }
+
+    #[test]
+    fn render_bgra_surface_premultiplied() {
+        // Left half: red at half coverage, premultiplied. Right half: no
+        // coverage, but green light, as a glow beyond an object's edge would
+        // leave in a premultiplied buffer.
+        let image_buffer = bgra_pixel_buffer(16, 16, |x, _| {
+            if x < 8 {
+                [0, 0, 64, 128]
+            } else {
+                [0, 200, 0, 0]
+            }
+        });
+        let scene = surface_scene(&image_buffer);
+
+        let mut renderer = MetalRenderer::new_headless(Arc::new(Mutex::new(Default::default())));
+        let image = renderer
+            .render_scene_to_image(&scene, size(DevicePixels(16), DevicePixels(16)))
+            .unwrap();
+        // The headless target clears to opaque black, so with source factor
+        // one each texel's premultiplied color arrives unchanged: a straight
+        // alpha blend would halve the red, and a compositor that divides
+        // alpha out would lose the green where alpha is zero.
+        for (x, _, image::Rgba([red, green, blue, alpha])) in image.enumerate_pixels() {
+            if x < 8 {
+                assert!(red.abs_diff(64) <= 2, "red {red} at x {x}");
+                assert_eq!((*green, *blue), (0, 0), "at x {x}");
+            } else {
+                assert!(green.abs_diff(200) <= 2, "green {green} at x {x}");
+                assert_eq!((*red, *blue), (0, 0), "at x {x}");
+            }
+            assert_eq!(*alpha, 255);
+        }
+    }
+
