+/// Spike #3445, never shipped: one JSON line on stderr, `spike3445 {...}`, for each mark and each
+/// compile, with the nanoseconds since the first call here and the names in scope on this thread.
+#[cfg(not(target_arch = "wasm32"))]
+pub mod spike3445 {
+    use std::cell::RefCell;
+    use std::sync::atomic::{AtomicU64, Ordering};
+    use std::sync::OnceLock;
+    use std::time::Instant;
+
+    static START: OnceLock<Instant> = OnceLock::new();
+    /// The nanoseconds every counted compile took, whole (`Program::new`), and in `Module::new`.
+    pub static PROGRAM_NS: AtomicU64 = AtomicU64::new(0);
+    pub static MODULE_NS: AtomicU64 = AtomicU64::new(0);
+    thread_local!(static SCOPE: RefCell<Vec<(String, String)>> = const { RefCell::new(Vec::new()) });
+
+    pub fn ns() -> u64 {
+        START.get_or_init(Instant::now).elapsed().as_nanos() as u64
+    }
+
+    /// A name in scope until the guard drops.
+    pub struct Scope;
+    impl Drop for Scope {
+        fn drop(&mut self) {
+            SCOPE.with(|s| {
+                s.borrow_mut().pop();
+            });
+        }
+    }
+    pub fn scope(kind: &str, name: &str) -> Scope {
+        SCOPE.with(|s| s.borrow_mut().push((kind.to_string(), name.to_string())));
+        Scope
+    }
+
+    pub fn line(mut fields: serde_json::Value) {
+        let scope: Vec<serde_json::Value> = SCOPE.with(|s| {
+            s.borrow()
+                .iter()
+                .map(|(k, n)| serde_json::json!([k, n]))
+                .collect()
+        });
+        fields["at"] = serde_json::json!(ns());
+        fields["scope"] = serde_json::json!(scope);
+        fields["compiles"] = serde_json::json!(super::compiles());
+        fields["total_program_ns"] = serde_json::json!(PROGRAM_NS.load(Ordering::Relaxed));
+        fields["total_module_ns"] = serde_json::json!(MODULE_NS.load(Ordering::Relaxed));
+        eprintln!("spike3445 {fields}");
+    }
+
+    pub fn mark(what: &str) {
+        line(serde_json::json!({"mark": what}));
+    }
+}
