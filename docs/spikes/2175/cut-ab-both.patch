+//! Spike #2175, cut A: deep-hook's children started with posix_spawn directly instead of std's `Command`, so the
+//! binary no longer links std's fork-and-exec fallback (fork, execvp, setuid, setgid, setgroups, chroot, chdir,
+//! setsid, setpgid, signal, dlsym, _exit and the rest). A child's SIGPIPE is set back to the default, as `Command`
+//! does, since Rust's runtime ignores it in deep-hook, and its signal mask is empty. macOS only as written: sigset_t
+//! is a u32 there, and the environment comes from _NSGetEnviron.
+
+use std::ffi::{c_char, c_void, CString, OsStr};
+use std::fs::File;
+use std::io;
+use std::os::fd::FromRawFd;
+use std::os::unix::ffi::OsStrExt;
+use std::ptr;
+
+extern "C" {
+    fn posix_spawnp(
+        pid: *mut i32,
+        file: *const c_char,
+        actions: *const *mut c_void,
+        attr: *const *mut c_void,
+        argv: *const *const c_char,
+        envp: *const *const c_char,
+    ) -> i32;
+    fn posix_spawn_file_actions_init(actions: *mut *mut c_void) -> i32;
+    fn posix_spawn_file_actions_addopen(
+        actions: *mut *mut c_void,
+        fd: i32,
+        path: *const c_char,
+        oflag: i32,
+        mode: u16,
+    ) -> i32;
+    fn posix_spawn_file_actions_adddup2(actions: *mut *mut c_void, fd: i32, to: i32) -> i32;
+    fn posix_spawn_file_actions_destroy(actions: *mut *mut c_void) -> i32;
+    fn posix_spawnattr_init(attr: *mut *mut c_void) -> i32;
+    fn posix_spawnattr_setflags(attr: *mut *mut c_void, flags: i16) -> i32;
+    fn posix_spawnattr_setsigdefault(attr: *mut *mut c_void, set: *const u32) -> i32;
+    fn posix_spawnattr_setsigmask(attr: *mut *mut c_void, set: *const u32) -> i32;
+    fn posix_spawnattr_destroy(attr: *mut *mut c_void) -> i32;
+    fn waitpid(pid: i32, status: *mut i32, options: i32) -> i32;
+    fn pipe(fds: *mut i32) -> i32;
+    fn fcntl(fd: i32, cmd: i32, ...) -> i32;
+    fn close(fd: i32) -> i32;
+    fn _NSGetEnviron() -> *const *const *const c_char;
+}
+
+const POSIX_SPAWN_SETSIGDEF: i16 = 0x04;
+const POSIX_SPAWN_SETSIGMASK: i16 = 0x08;
+const SIGPIPE: u32 = 13;
+const O_RDWR: i32 = 2;
+const F_SETFD: i32 = 2;
+const FD_CLOEXEC: i32 = 1;
+const EINTR: i32 = 4;
+
+/// What one of a child's first three descriptors is.
+#[derive(Clone, Copy, PartialEq)]
+pub enum Io {
+    Null,
+    Pipe,
+    Inherit,
+}
+
+/// A started child: its PID, and this end of each piped descriptor.
+pub struct Child {
+    pub pid: i32,
+    pub stdin: Option<File>,
+    pub stdout: Option<File>,
+}
+
+fn check(code: i32) -> io::Result<()> {
+    if code == 0 {
+        Ok(())
+    } else {
+        Err(io::Error::from_raw_os_error(code))
+    }
+}
+
+fn c(s: &OsStr) -> io::Result<CString> {
+    CString::new(s.as_bytes()).map_err(|e| io::Error::new(io::ErrorKind::InvalidInput, e))
+}
+
+/// Starts `program` (searched on PATH when it has no slash) with `args`, this process's environment plus `env`.
+pub fn spawn(program: &OsStr, args: &[&OsStr], env: &[(&str, &str)], io: [Io; 3]) -> io::Result<Child> {
+    let file = c(program)?;
+    let mut argv_owned = vec![file.clone()];
+    for a in args {
+        argv_owned.push(c(a)?);
+    }
+    let mut argv: Vec<*const c_char> = argv_owned.iter().map(|a| a.as_ptr()).collect();
+    argv.push(ptr::null());
+    let env_owned: Vec<CString> = if env.is_empty() {
+        Vec::new()
+    } else {
+        let mut all: Vec<CString> = std::env::vars_os()
+            .filter(|(k, _)| !env.iter().any(|(e, _)| OsStr::new(e) == k))
+            .filter_map(|(k, v)| CString::new([k.as_bytes(), b"=", v.as_bytes()].concat()).ok())
+            .collect();
+        for (k, v) in env {
+            all.push(c(OsStr::new(&format!("{k}={v}")))?);
+        }
+        all
+    };
+    let mut envp: Vec<*const c_char> = env_owned.iter().map(|e| e.as_ptr()).collect();
+    envp.push(ptr::null());
+    // SAFETY: _NSGetEnviron returns the process's environ pointer, which lives as long as the process.
+    let envp_ptr = if env.is_empty() { unsafe { *_NSGetEnviron() } } else { envp.as_ptr() };
+
+    let null = CString::new("/dev/null").unwrap_or_default();
+    let mut pipes: [Option<(i32, i32)>; 3] = [None; 3];
+    let mut actions: *mut c_void = ptr::null_mut();
+    let mut attr: *mut c_void = ptr::null_mut();
+    // SAFETY: every pointer passed lives through the calls; the actions and attributes are destroyed below.
+    unsafe {
+        check(posix_spawn_file_actions_init(&mut actions))?;
+        check(posix_spawnattr_init(&mut attr))?;
+        let result = (|| {
+            for (fd, how) in io.iter().enumerate() {
+                let fd = fd as i32;
+                match how {
+                    Io::Inherit => {}
+                    Io::Null => check(posix_spawn_file_actions_addopen(&mut actions, fd, null.as_ptr(), O_RDWR, 0))?,
+                    Io::Pipe => {
+                        let mut ends = [0i32; 2];
+                        if pipe(ends.as_mut_ptr()) != 0 {
+                            return Err(io::Error::last_os_error());
+                        }
+                        fcntl(ends[0], F_SETFD, FD_CLOEXEC);
+                        fcntl(ends[1], F_SETFD, FD_CLOEXEC);
+                        // stdin reads the pipe's read end; stdout writes its write end.
+                        let (theirs, ours) = if fd == 0 { (ends[0], ends[1]) } else { (ends[1], ends[0]) };
+                        pipes[fd as usize] = Some((theirs, ours));
+                        check(posix_spawn_file_actions_adddup2(&mut actions, theirs, fd))?;
+                    }
+                }
+            }
+            let sigs: u32 = 1 << (SIGPIPE - 1);
+            check(posix_spawnattr_setsigdefault(&mut attr, &sigs))?;
+            // And an empty signal mask, as std's Command gives its children.
+            let none: u32 = 0;
+            check(posix_spawnattr_setsigmask(&mut attr, &none))?;
+            check(posix_spawnattr_setflags(&mut attr, POSIX_SPAWN_SETSIGDEF | POSIX_SPAWN_SETSIGMASK))?;
+            let mut pid = 0;
+            check(posix_spawnp(&mut pid, file.as_ptr(), &actions, &attr, argv.as_ptr(), envp_ptr))?;
+            Ok(pid)
+        })();
+        posix_spawn_file_actions_destroy(&mut actions);
+        posix_spawnattr_destroy(&mut attr);
+        for (theirs, ours) in pipes.iter().flatten() {
+            close(*theirs);
+            if result.is_err() {
+                close(*ours);
+            }
+        }
+        let pid = result?;
+        let take = |fd: usize| pipes[fd].map(|(_, ours)| File::from_raw_fd(ours));
+        Ok(Child { pid, stdin: take(0), stdout: take(1) })
+    }
+}
+
+/// Waits for `pid` to end: its exit code, or None when a signal ended it.
+pub fn wait(pid: i32) -> io::Result<Option<i32>> {
+    let mut status = 0;
+    loop {
+        // SAFETY: status is a valid out pointer.
+        if unsafe { waitpid(pid, &mut status, 0) } >= 0 {
+            break;
+        }
+        let e = io::Error::last_os_error();
+        if e.raw_os_error() != Some(EINTR) {
+            return Err(e);
+        }
+    }
+    Ok(if status & 0x7f == 0 { Some((status >> 8) & 0xff) } else { None })
+}
