+/// Spike #2175, cut B: a machine that joined a project (any ~/.deepbuild/hubs/*.json) runs its hook calls and spool
+/// sends in deep-hook-joined, the build with the network route, before the call's stdin is read.
+#[cfg(not(feature = "joined"))]
+fn hand_to_joined(args: &[String]) {
+    use std::os::unix::ffi::OsStrExt;
+    extern "C" {
+        fn execv(path: *const std::ffi::c_char, argv: *const *const std::ffi::c_char) -> i32;
+    }
+    // The forms main() reads as a hook call ([agent, event] and [agent, "waiter"]), and spool-send.
+    let hook_call = matches!(args, [agent, _] if !agent.starts_with('-') && agent != "statusline-send" && agent != "mcp")
+        || matches!(args, [arg, _] if arg == "spool-send");
+    let joins = fs::read_dir(home().join("hubs"))
+        .map(|d| d.flatten().any(|e| e.path().extension().is_some_and(|x| x == "json")))
+        .unwrap_or(false);
+    if hook_call && joins {
+        let Ok(me) = env::current_exe() else { return };
+        let Ok(path) = std::ffi::CString::new(me.with_file_name("deep-hook-joined").as_os_str().as_bytes()) else {
+            return;
+        };
+        let words: Vec<std::ffi::CString> = args.iter().filter_map(|a| std::ffi::CString::new(a.as_str()).ok()).collect();
+        let mut argv = vec![path.as_ptr()];
+        argv.extend(words.iter().map(|w| w.as_ptr()));
+        argv.push(std::ptr::null());
+        // SAFETY: path and argv are NUL-terminated and live through the call; execv returns only on failure.
+        unsafe { execv(path.as_ptr(), argv.as_ptr()) };
+        // This build has no route to a joined hub: carrying on would send a joined project's call to this machine's
+        // hub instead, so the call stops here, as a hook that can't reach its hub at all would.
+        eprintln!("deep-hook: this machine joined a project, and deep-hook-joined beside deep-hook can't start: {}", io::Error::last_os_error());
+        std::process::exit(1);
+    }
+}
+
