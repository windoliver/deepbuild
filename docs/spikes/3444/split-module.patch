@@ -0,0 +1,148 @@
+//! Spike #3444's split: a shader module's source with only the entry points one pipeline uses.
+//! wgpu-hal translates a module again for each stage of each pipeline, and naga's override step
+//! hands a module back untouched only when it holds no override and at most one entry point; a
+//! module that holds a pipeline's entry points alone gives it less to clone and compact.
+
+use std::ops::Range;
+
+/// The entry points `source` declares: each one's name and the bytes from its first attribute to
+/// the brace that closes its body.
+pub fn entry_points(source: &str) -> Vec<(&str, Range<usize>)> {
+    let bytes = source.as_bytes();
+    let word = |c: u8| c.is_ascii_alphanumeric() || c == b'_';
+    let (mut i, mut depth, mut parens) = (0, 0u32, 0u32);
+    // The attributes ahead of the declaration being read: where they start, and whether one of
+    // them makes it an entry point.
+    let (mut attrs, mut entry) = (None, false);
+    let mut function: Option<&str> = None;
+    let mut found = Vec::new();
+    while i < bytes.len() {
+        let c = bytes[i];
+        if bytes[i..].starts_with(b"//") {
+            i += source[i..].find('\n').unwrap_or(source.len() - i);
+        } else if bytes[i..].starts_with(b"/*") {
+            // Block comments nest.
+            let mut open = 1;
+            i += 2;
+            while i < bytes.len() && open > 0 {
+                if bytes[i..].starts_with(b"/*") {
+                    open += 1;
+                    i += 2;
+                } else if bytes[i..].starts_with(b"*/") {
+                    open -= 1;
+                    i += 2;
+                } else {
+                    i += 1;
+                }
+            }
+        } else if word(c) || c == b'@' {
+            let start = i;
+            i += 1;
+            while i < bytes.len() && word(bytes[i]) {
+                i += 1;
+            }
+            if depth > 0 || parens > 0 {
+                continue;
+            }
+            match &source[start..i] {
+                "@vertex" | "@fragment" | "@compute" => {
+                    attrs.get_or_insert(start);
+                    entry = true;
+                }
+                a if a.starts_with('@') => {
+                    attrs.get_or_insert(start);
+                }
+                "fn" => {
+                    let name = source[i..].trim_start();
+                    let end = name.bytes().position(|c| !word(c)).unwrap_or(name.len());
+                    function = Some(&name[..end]);
+                }
+                _ => {}
+            }
+        } else {
+            match c {
+                b'(' => parens += 1,
+                b')' => parens = parens.saturating_sub(1),
+                b'{' => depth += 1,
+                b'}' => {
+                    depth = depth.saturating_sub(1);
+                    if depth == 0 {
+                        if let (Some(name), Some(start), true) = (function.take(), attrs, entry) {
+                            found.push((name, start..i + 1));
+                        }
+                        (attrs, entry) = (None, false);
+                    }
+                }
+                b';' if depth == 0 && parens == 0 => {
+                    (attrs, entry, function) = (None, false, None);
+                }
+                _ => {}
+            }
+            i += 1;
+        }
+    }
+    found
+}
+
+/// `source` without the entry points `keep` doesn't name, or `None` when it holds no other.
+pub fn only(source: &str, keep: &[&str]) -> Option<String> {
+    let cut: Vec<Range<usize>> = entry_points(source)
+        .into_iter()
+        .filter(|(name, _)| !keep.contains(name))
+        .map(|(_, at)| at)
+        .collect();
+    if cut.is_empty() {
+        return None;
+    }
+    let mut out = String::with_capacity(source.len());
+    let mut from = 0;
+    for at in cut {
+        out.push_str(&source[from..at.start]);
+        from = at.end;
+    }
+    out.push_str(&source[from..]);
+    Some(out)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const SOURCE: &str = "\
+struct In { @location(0) at: vec3<f32>, }
+@group(0) @binding(0) var<uniform> frame: mat4x4<f32>;
+override LOBES: bool = true;
+// @vertex fn commented() {}
+/* @fragment fn also() { /* nested */ } */
+fn shared(p: vec3<f32>) -> vec4<f32> { return frame * vec4<f32>(p, 1.0); }
+@vertex
+fn vs_main(in: In) -> @builtin(position) vec4<f32> { return shared(in.at); }
+@fragment fn fs_main() -> @location(0) vec4<f32> { if LOBES { return vec4<f32>(1.0); } return vec4<f32>(0.0); }
+@compute @workgroup_size(8, 8)
+fn cull(@builtin(global_invocation_id) id: vec3<u32>) { }
+@fragment fn fs_other() -> @location(0) vec4<f32> { return vec4<f32>(0.5); }
+";
+
+    #[test]
+    fn names_every_entry_point_and_no_comment() {
+        let names: Vec<&str> = entry_points(SOURCE).into_iter().map(|(n, _)| n).collect();
+        assert_eq!(names, ["vs_main", "fs_main", "cull", "fs_other"]);
+    }
+
+    #[test]
+    fn keeps_a_pipelines_entry_points_and_everything_shared() {
+        let kept = only(SOURCE, &["vs_main", "fs_main"]).expect("two others to cut");
+        let names: Vec<&str> = entry_points(&kept).into_iter().map(|(n, _)| n).collect();
+        assert_eq!(names, ["vs_main", "fs_main"]);
+        for line in [
+            "struct In",
+            "var<uniform> frame",
+            "override LOBES",
+            "fn shared",
+        ] {
+            assert!(kept.contains(line), "{line} is kept");
+        }
+        assert!(!kept.contains("workgroup_size") && !kept.contains("fs_other"));
+        assert_eq!(only(&kept, &["vs_main", "fs_main"]), None);
+    }
+}
