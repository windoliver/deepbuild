@@ -0,0 +1,42 @@
+//! DeepBuild spike #3444's probe, the wgpu crate's half. Not part of wgpu.
+//!
+//! Opens a call around each `Device::create_shader_module`, `create_render_pipeline` and
+//! `create_compute_pipeline`, and writes its row when it returns: `kind`, `label` and `ns`, the
+//! time inside the call. The rows wgpu-core and wgpu-hal write between carry the call's number.
+//! With `DEEP_3444_PROBE` unset nothing is opened and nothing is written.
+
+use alloc::{format, string::String};
+
+pub(crate) struct Open {
+    started: u64,
+    kind: &'static str,
+    label: String,
+}
+
+pub(crate) fn begin(kind: &'static str, label: Option<&str>) -> Option<Open> {
+    if !crate::hal::probe::on() {
+        return None;
+    }
+    crate::hal::probe::begin();
+    Some(Open {
+        started: crate::hal::probe::now_ns(),
+        kind,
+        label: String::from(label.unwrap_or("")),
+    })
+}
+
+pub(crate) fn end(open: Option<Open>) {
+    if let Some(open) = open {
+        let ns = crate::hal::probe::now_ns() - open.started;
+        crate::hal::probe::emit(
+            "create",
+            &format!(
+                "\"kind\":{},\"label\":{},\"ns\":{}",
+                crate::hal::probe::quote(open.kind),
+                crate::hal::probe::quote(&open.label),
+                ns
+            ),
+        );
+        crate::hal::probe::end();
+    }
+}
