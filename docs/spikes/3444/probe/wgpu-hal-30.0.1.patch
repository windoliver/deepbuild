diff -ruN -x Cargo.lock -x target a/wgpu-hal-30.0.1/src/probe.rs b/wgpu-hal-30.0.1/src/probe.rs
--- a/wgpu-hal-30.0.1/src/probe.rs
+++ b/wgpu-hal-30.0.1/src/probe.rs
@@ -0,0 +1,134 @@
+//! DeepBuild spike #3444's probe. Not part of wgpu-hal.
+//!
+//! Rows of timing and counts, one JSON object a line, appended to the file the environment
+//! variable `DEEP_3444_PROBE` names. With the variable unset no row is made and nothing is
+//! written: every hook first asks [`on`].
+//!
+//! A row's `call` is the number of the `wgpu::Device::create_*` call it was made inside, on the
+//! same thread, or 0 outside any: the wgpu crate's hooks open and close a call, wgpu-core's and
+//! this crate's rows land between them. `t_ns` is nanoseconds since the probe's first use, on the
+//! monotonic clock, and `unix_ms` the wall clock.
+
+use alloc::string::String;
+use core::cell::Cell;
+use core::sync::atomic::{AtomicI64, AtomicU64, Ordering};
+use std::io::Write as _;
+use std::sync::{Mutex, OnceLock};
+use std::time::Instant;
+
+static SINK: OnceLock<Option<Mutex<std::fs::File>>> = OnceLock::new();
+static START: OnceLock<Instant> = OnceLock::new();
+static NEXT: AtomicU64 = AtomicU64::new(1);
+/// The command buffers committed so far: each one's place in the order they were committed.
+pub static COMMAND_BUFFERS: AtomicU64 = AtomicU64::new(0);
+/// The timestamp query sets alive, counted by the probe itself beside the device's own counter.
+pub static TIMESTAMP_SETS: AtomicI64 = AtomicI64::new(0);
+
+std::thread_local! {
+    static CURRENT: Cell<u64> = const { Cell::new(0) };
+}
+
+fn sink() -> Option<&'static Mutex<std::fs::File>> {
+    SINK.get_or_init(|| {
+        let path = std::env::var_os("DEEP_3444_PROBE")?;
+        let file = std::fs::OpenOptions::new()
+            .create(true)
+            .append(true)
+            .open(path)
+            .ok()?;
+        let _ = START.get_or_init(Instant::now);
+        Some(Mutex::new(file))
+    })
+    .as_ref()
+}
+
+/// Whether rows are being written.
+pub fn on() -> bool {
+    sink().is_some()
+}
+
+/// Nanoseconds since the probe's first row.
+pub fn now_ns() -> u64 {
+    START.get_or_init(Instant::now).elapsed().as_nanos() as u64
+}
+
+/// Opens a `create_*` call on this thread and returns its number.
+pub fn begin() -> u64 {
+    let id = NEXT.fetch_add(1, Ordering::Relaxed);
+    CURRENT.with(|c| c.set(id));
+    id
+}
+
+/// Closes this thread's call.
+pub fn end() {
+    CURRENT.with(|c| c.set(0));
+}
+
+/// A JSON string.
+pub fn quote(s: &str) -> String {
+    let mut out = String::with_capacity(s.len() + 2);
+    out.push('"');
+    for ch in s.chars() {
+        match ch {
+            '"' => out.push_str("\\\""),
+            '\\' => out.push_str("\\\\"),
+            c if (c as u32) < 0x20 => out.push_str(&format!("\\u{:04x}", c as u32)),
+            c => out.push(c),
+        }
+    }
+    out.push('"');
+    out
+}
+
+/// The indirect-call validation flag the environment asks for, read as wgpu's own
+/// `InstanceFlags::with_env` reads `WGPU_VALIDATION_INDIRECT_CALL`: unset leaves the flag as the
+/// instance's descriptor has it, `0` turns it off, anything else turns it on. The app's instance
+/// never calls `with_env`, so without this hook the variable does nothing.
+pub fn indirect_call_validation() -> Option<bool> {
+    std::env::var("WGPU_VALIDATION_INDIRECT_CALL")
+        .ok()
+        .map(|v| v != "0")
+}
+
+/// A line for the end of each Metal source, when `DEEP_3444_UNKEPT` names one. The system keeps
+/// what Metal compiled, by its source, for every later process of the user; a comment no earlier
+/// run wrote makes the source new to it, so the compile is made again, as on a machine that has
+/// never compiled these shaders. Unset, the source goes to Metal as naga wrote it.
+pub fn unkept() -> Option<&'static str> {
+    static LINE: OnceLock<Option<String>> = OnceLock::new();
+    LINE.get_or_init(|| std::env::var("DEEP_3444_UNKEPT").ok().filter(|v| !v.is_empty()))
+        .as_deref()
+}
+
+/// Keeps a Metal source as a file of its own in the folder `DEEP_3444_MSL_DIR` names, when it
+/// names one: `<n>-<stage>-<entry>.metal`, `n` counting the sources in the order they were written.
+pub fn keep_source(stage: &str, entry: &str, source: &str) {
+    static KEPT: AtomicU64 = AtomicU64::new(0);
+    if let Some(dir) = std::env::var_os("DEEP_3444_MSL_DIR") {
+        let n = KEPT.fetch_add(1, Ordering::Relaxed);
+        let file = std::path::Path::new(&dir).join(format!("{n:03}-{stage}-{entry}.metal"));
+        let _ = std::fs::write(file, source);
+    }
+}
+
+/// One row: `fields` is the inside of a JSON object, after the probe's own fields.
+pub fn emit(ev: &str, fields: &str) {
+    let Some(sink) = sink() else { return };
+    let thread = std::thread::current();
+    let unix_ms = std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .map_or(0, |d| d.as_millis());
+    let line = format!(
+        "{{\"ev\":{},\"t_ns\":{},\"unix_ms\":{},\"pid\":{},\"thread\":{},\"call\":{}{}{}}}\n",
+        quote(ev),
+        now_ns(),
+        unix_ms,
+        std::process::id(),
+        quote(thread.name().unwrap_or("")),
+        CURRENT.with(Cell::get),
+        if fields.is_empty() { "" } else { "," },
+        fields,
+    );
+    let mut file = sink.lock().unwrap_or_else(|e| e.into_inner());
+    let _ = file.write_all(line.as_bytes());
+}
