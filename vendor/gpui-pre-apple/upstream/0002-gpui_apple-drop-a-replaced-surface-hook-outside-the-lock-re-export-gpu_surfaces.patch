-        *HOOK.write().unwrap_or_else(|e| e.into_inner()) = hook;
+        let mut guard = HOOK.write();
+        let old = mem::replace(&mut *guard, hook);
+        drop(guard);
+        drop(old);
     }
 
     fn hook() -> Option<Hook> {
