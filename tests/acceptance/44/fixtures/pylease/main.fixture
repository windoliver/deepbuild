#!/usr/bin/env python3
# A JSON-RPC test package written in Python (#44), on #348's wire: JSON-RPC 2.0, one JSON object per line on stdio.
# When the host asks it to `load`, it calls `deep.registerCheck` for its check kind ext.pylease.report and answers
# `load`. When the host asks it to `run` that check, it calls the method `deep.lease` with the positional params
# [resource, mode] taken from the spec's `runner` (JSON), and answers with a check result whose one failure message
# is the JSON of what came back: {"result": ...} or {"error": "<the host's error message>"}.
# The test rewrites the first line to this machine's python3.
import json
import sys

KIND = "ext.pylease.report"
next_id = 0


def send(message):
    message["jsonrpc"] = "2.0"
    sys.stdout.write(json.dumps(message) + "\n")
    sys.stdout.flush()


def call(method, params):
    """A request to the host; returns its result, or raises with its error."""
    global next_id
    next_id += 1
    mine = next_id
    send({"id": mine, "method": method, "params": params})
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        message = json.loads(line)
        if "method" not in message and message.get("id") == mine:
            if "error" in message:
                raise RuntimeError(message["error"].get("message", "error"))
            return message.get("result")
        # Nothing else is expected while waiting for the host's answer.
    raise RuntimeError("stdin closed before the host answered " + method)


def report(seen):
    return {
        "outcome": "failed",
        "testsRun": 1,
        "failures": [{
            "test": "report",
            "file": "main",
            "line": 1,
            "stack": None,
            "assertion": False,
            "message": json.dumps(seen),
        }],
        "evidence": [],
        "read": [],
        "mask": None,
    }


def run(params):
    seen = {}
    try:
        request = json.loads(params.get("spec", {}).get("runner", "{}"))
        seen["result"] = call("deep.lease", [request.get("resource"), request.get("mode")])
    except Exception as error:
        seen["error"] = str(error)
    return report(seen)


def main():
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        message = json.loads(line)
        method = message.get("method")
        if method is None:
            continue
        try:
            if method == "load":
                call("deep.registerCheck", [KIND])
                result = None
            elif method == "run" and message.get("params", {}).get("type") == KIND:
                result = run(message.get("params", {}))
            else:
                send({"id": message.get("id"), "error": {"code": -32601, "message": "no method " + str(method)}})
                continue
            send({"id": message.get("id"), "result": result})
        except Exception as error:  # report it to the host as the request's error
            send({"id": message.get("id"), "error": {"code": -32000, "message": str(error)}})


main()
