  "inflection_between_rings": [31, 32],
  "twins": [
    { "planted": "sweep_frenet", "names": ["ring 32 "], "first_ring": 32, "wrong": "the sweep's frames are Frenet frames (normal along the curvature), turned once to match the first ring's rotation-minimizing frame; past the inflection the curvature changes side and the frame turns 180 degrees" }
