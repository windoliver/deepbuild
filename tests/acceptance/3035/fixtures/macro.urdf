<?xml version="1.0"?>
<!-- Issue #3035, criterion 5: a file that includes a macro. It is well formed, and it is no robot until its macro is expanded. -->
<robot name="macro_arm" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="segment.xacro"/>
  <link name="base">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="5"/>
      <inertia ixx="0.05" ixy="0" ixz="0" iyy="0.05" iyz="0" izz="0.05"/>
    </inertial>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.2 0.2 0.2"/>
      </geometry>
    </collision>
  </link>
</robot>
