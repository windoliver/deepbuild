{
  "id": "openrows.fence",
  "version": "1.0",
  "title": "Endless fence",
  "license": "MIT",
  "author": "the #420 acceptance suite",
  "description": "The rows fence with a repeat that has only an `as`: nothing fixes how many walls it makes.",
  "inputs": {
    "n": {
      "type": "integer",
      "default": 3,
      "min": 1,
      "max": 12,
      "about": "unused by the repeat"
    }
  },
  "steps": {
    "post": {
      "op": "builder",
      "kind": "arch.wall@1",
      "repeat": {
        "as": "i"
      },
      "params": {
        "a": ["2 * i", 0],
        "b": ["2 * i + 1.5", 0],
        "thickness": 0.1,
        "height": 1,
        "justify": "center",
        "outside": "none",
        "cut_height": 1
      }
    }
  },
  "outputs": {
    "parts": ["post"]
  }
}
