// A (#350 AC9), first-party, loaded from the release in the hub: it uses `ext.b.feed@1` (optional, so removing its
// provider asks nothing) and, when its report runs, reads it back to back for probe.json's `ms`, keeping each
// read's outcome: `ok` for B's value, `missing` once the use reads missing, or `error: <text>` for a read that
// failed any other way. Its manifest's `uses` entry, with the feed schema's digest, is written by the test.
import { readFileSync } from 'node:fs';

const probe: { ms: number } = JSON.parse(readFileSync(new URL('./probe.json', import.meta.url), 'utf8'));
const sleep = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));

export default function (deep: any): void {
  deep.use('ext.b.feed@1', { optional: true });
  deep.registerCheck('ext.a.report', async () => {
    const outcomes: string[] = [];
    const end = Date.now() + probe.ms;
    while (Date.now() < end) {
      try {
        const read = await deep.read('ext.b.feed@1');
        outcomes.push(read?.missing === true ? 'missing' : typeof read?.value?.n === 'number' ? 'ok' : `error: no value in ${JSON.stringify(read)}`);
      } catch (e) {
        outcomes.push(`error: ${String((e as Error)?.message ?? e)}`);
      }
      await sleep(1);
    }
    return {
      outcome: 'failed', testsRun: 1, evidence: [], read: [], mask: null,
      failures: [{ test: 'report', file: 'index.ts', line: 1, stack: null, assertion: false, message: JSON.stringify({ outcomes }) }],
    };
  });
}
