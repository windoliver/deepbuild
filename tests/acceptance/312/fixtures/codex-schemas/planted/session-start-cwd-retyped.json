{
  "name": "session-start with cwd retyped to an integer",
  "version": "0.160.0",
  "hook": "SessionStart",
  "field": "cwd",
  "schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "definitions": { "NullableString": { "type": ["string", "null"] } },
    "properties": {
      "cwd": { "type": "integer" },
      "hook_event_name": { "const": "SessionStart", "type": "string" },
      "model": { "type": "string" },
      "permission_mode": { "enum": ["default", "acceptEdits", "plan", "dontAsk", "bypassPermissions"], "type": "string" },
      "session_id": { "type": "string" },
      "source": { "enum": ["startup", "resume", "clear", "compact"], "type": "string" },
      "transcript_path": { "$ref": "#/definitions/NullableString" }
    },
    "required": ["cwd", "hook_event_name", "model", "permission_mode", "session_id", "source", "transcript_path"],
    "title": "session-start.command.input",
    "type": "object"
  }
}
