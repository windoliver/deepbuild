{
  "name": "user-prompt-submit with a new required field the facts never list",
  "version": "0.160.0",
  "hook": "UserPromptSubmit",
  "field": "prompt_source",
  "schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "definitions": { "NullableString": { "type": ["string", "null"] } },
    "properties": {
      "agent_id": { "type": "string" },
      "agent_type": { "type": "string" },
      "cwd": { "type": "string" },
      "hook_event_name": { "const": "UserPromptSubmit", "type": "string" },
      "model": { "type": "string" },
      "permission_mode": { "enum": ["default", "acceptEdits", "plan", "dontAsk", "bypassPermissions"], "type": "string" },
      "prompt": { "type": "string" },
      "prompt_source": { "type": "string" },
      "session_id": { "type": "string" },
      "transcript_path": { "$ref": "#/definitions/NullableString" },
      "turn_id": { "type": "string" }
    },
    "required": ["cwd", "hook_event_name", "model", "permission_mode", "prompt", "prompt_source", "session_id", "transcript_path", "turn_id"],
    "title": "user-prompt-submit.command.input",
    "type": "object"
  }
}
