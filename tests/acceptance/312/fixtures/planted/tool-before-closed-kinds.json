{
  "name": "planted.tool.before@1",
  "field": "/data/kind",
  "why": "a tool-call schema whose kind list has no unknown member: a call a third agent's adapter can't place has nowhere to go, so the schema refuses it and fails AC7",
  "schema": {
    "title": "planted.tool.before@1",
    "type": "object",
    "properties": {
      "v": { "const": 1 },
      "id": { "type": "string", "format": "ulid" },
      "kind": { "const": "tool.before" },
      "writer": { "type": "string", "pattern": "^(hook|app|cli|core|ext:[^\\s]+)$" },
      "actor": { "type": "string", "minLength": 1 },
      "scope": { "type": "string", "minLength": 1 },
      "ts": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
      "seq": { "type": "string", "format": "seq" },
      "data": {
        "type": "object",
        "properties": {
          "kind": { "type": "string", "enum": ["shell", "read", "edit", "write", "search", "fetch", "mcp"] },
          "paths": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 8192 } },
          "command": { "type": ["string", "null"], "maxLength": 8192 }
        },
        "required": ["kind", "paths", "command"],
        "additionalProperties": false
      }
    },
    "required": ["v", "id", "kind", "writer", "actor", "scope", "ts", "data"],
    "additionalProperties": false
  }
}
