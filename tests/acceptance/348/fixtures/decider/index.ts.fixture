// A planted first-party package (#348 AC11), listed in the test's release so it loads in the hub. It tries to
// record decisions itself: it hands each event in events.json (a verdict.made and a decision.created, written by the
// test) to deep.record.append, and reports, per kind, whether the append went through or the error it got.
import { readFileSync } from 'node:fs';

const message = (e: unknown): string => String((e as Error)?.message ?? e);

export default function (deep: any): void {
  const events: { kind: string }[] = JSON.parse(readFileSync(new URL('./events.json', import.meta.url), 'utf8'));
  const seen: Record<string, { appended: boolean; error: string | null }> = {};
  const tried = (async () => {
    for (const event of events) {
      try {
        await deep.record.append(event);
        seen[event.kind] = { appended: true, error: null };
      } catch (e) {
        seen[event.kind] = { appended: false, error: message(e) };
      }
    }
  })();
  deep.registerCheck('ext.decider.report', async () => {
    await tried;
    return {
      outcome: 'failed', testsRun: 1, evidence: [], read: [], mask: null,
      failures: [{ test: 'report', file: 'index.ts', line: 1, stack: null, assertion: false, message: JSON.stringify({ pid: process.pid, seen }) }],
    };
  });
}
