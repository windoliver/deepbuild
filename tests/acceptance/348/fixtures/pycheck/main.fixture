#!/usr/bin/env python3
# A JSON-RPC test package written in Python (#348). It speaks JSON-RPC 2.0 as JSON lines on stdio (README, The
# surface under test: the JSON-RPC wire): when the host asks it to `load`, it calls `deep.registerCheck` for its
# check kind, waits for the host's answer, then answers `load`; when the host asks it to `run` that check, it
# answers with a check result whose failure names the Python that ran it and the command it was given.
# The test rewrites the first line to this machine's python3.
import json
import sys

KIND = "ext.pycheck.lint"
next_id = 0


def send(message):
    message["jsonrpc"] = "2.0"
    sys.stdout.write(json.dumps(message) + "\n")
    sys.stdout.flush()


def call(method, params):
    """A request to the host; returns its result, or raises with its error."""
    global next_id
    next_id += 1
    mine = next_id
    send({"id": mine, "method": method, "params": params})
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        message = json.loads(line)
        if "method" not in message and message.get("id") == mine:
            if "error" in message:
                raise RuntimeError(message["error"].get("message", "error"))
            return message.get("result")
        # Nothing else is expected while registering.
    raise RuntimeError("stdin closed before the host answered " + method)


def run(params):
    spec = params.get("spec", {})
    version = "%d.%d" % (sys.version_info[0], sys.version_info[1])
    return {
        "outcome": "failed",
        "testsRun": 3,
        "failures": [{
            "test": "lint",
            "file": "main",
            "line": 1,
            "stack": None,
            "assertion": False,
            "message": "python %s saw %s" % (version, spec.get("runner", "")),
        }],
        "evidence": [],
        "read": [],
        "mask": None,
    }


def main():
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        message = json.loads(line)
        method = message.get("method")
        if method is None:
            continue
        try:
            if method == "load":
                call("deep.registerCheck", [KIND])
                result = None
            elif method == "run" and message.get("params", {}).get("type") == KIND:
                result = run(message.get("params", {}))
            else:
                send({"id": message.get("id"), "error": {"code": -32601, "message": "no method " + str(method)}})
                continue
            send({"id": message.get("id"), "result": result})
        except Exception as error:  # report it to the host as the request's error
            send({"id": message.get("id"), "error": {"code": -32000, "message": str(error)}})


main()
