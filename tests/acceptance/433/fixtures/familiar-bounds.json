{
  "about": "AC1's fixture: one case per familiar@1 recipe, each the reference library's geometry with these parameters (three.js's own names; angles in degrees, README: readings). The expected bounds are the reference library's, from reference.ts's port of each generator at the pinned commit; `three` names the call each case stands for. Non-default segments and partial sweeps are chosen so the bounds depend on the library's tessellation and orientation, not only on the radius.",
  "pin": {"repo": "mrdoob/three.js", "commit": "65c4864bb3bd4309257d41c6e54f4403dc57f255", "version": "0.186.0"},
  "tolerance_m": 1e-6,
  "cases": [
    {"id": "box", "recipe": "familiar.box@1", "params": {"width": 2, "height": 1, "depth": 0.5, "widthSegments": 2},
     "three": "new BoxGeometry(2, 1, 0.5, 2)"},
    {"id": "sphere", "recipe": "familiar.sphere@1", "params": {"radius": 1, "widthSegments": 6, "heightSegments": 5, "phiStart": 0, "phiLength": 90},
     "three": "new SphereGeometry(1, 6, 5, 0, Math.PI / 2)"},
    {"id": "cylinder", "recipe": "familiar.cylinder@1", "params": {"radiusTop": 0.5, "radiusBottom": 1, "height": 2, "radialSegments": 5, "thetaStart": 30},
     "three": "new CylinderGeometry(0.5, 1, 2, 5, 1, false, Math.PI / 6)"},
    {"id": "cone", "recipe": "familiar.cone@1", "params": {"radius": 1, "height": 2, "radialSegments": 3},
     "three": "new ConeGeometry(1, 2, 3)"},
    {"id": "torus", "recipe": "familiar.torus@1", "params": {"radius": 1, "tube": 0.25, "radialSegments": 5, "tubularSegments": 6, "arc": 180},
     "three": "new TorusGeometry(1, 0.25, 5, 6, Math.PI)"},
    {"id": "capsule", "recipe": "familiar.capsule@1", "params": {"radius": 0.5, "height": 1, "capSegments": 3, "radialSegments": 5},
     "three": "new CapsuleGeometry(0.5, 1, 3, 5)"},
    {"id": "plane", "recipe": "familiar.plane@1", "params": {"width": 2, "height": 1},
     "three": "new PlaneGeometry(2, 1)"},
    {"id": "circle", "recipe": "familiar.circle@1", "params": {"radius": 1, "segments": 3, "thetaStart": 45, "thetaLength": 180},
     "three": "new CircleGeometry(1, 3, Math.PI / 4, Math.PI)"},
    {"id": "ring", "recipe": "familiar.ring@1", "params": {"innerRadius": 0.5, "outerRadius": 1, "thetaSegments": 4, "thetaLength": 270},
     "three": "new RingGeometry(0.5, 1, 4, 1, 0, 3 * Math.PI / 2)"},
    {"id": "tetrahedron", "recipe": "familiar.tetrahedron@1", "params": {"radius": 1, "detail": 1},
     "three": "new TetrahedronGeometry(1, 1)"},
    {"id": "octahedron", "recipe": "familiar.octahedron@1", "params": {"radius": 2},
     "three": "new OctahedronGeometry(2)"},
    {"id": "icosahedron", "recipe": "familiar.icosahedron@1", "params": {"radius": 1},
     "three": "new IcosahedronGeometry(1)"},
    {"id": "dodecahedron", "recipe": "familiar.dodecahedron@1", "params": {"radius": 1},
     "three": "new DodecahedronGeometry(1)"},
    {"id": "tube", "recipe": "familiar.tube@1", "params": {"path": [[0, 0, 0], [0, 2, 0]], "tubularSegments": 4, "radius": 0.25, "radialSegments": 6},
     "three": "new TubeGeometry(new CatmullRomCurve3([new Vector3(0, 0, 0), new Vector3(0, 2, 0)]), 4, 0.25, 6)"},
    {"id": "lathe", "recipe": "familiar.lathe@1", "params": {"points": [[0.2, 0], [0.6, 0.5], [0.3, 1]], "segments": 3, "phiLength": 180},
     "three": "new LatheGeometry([new Vector2(0.2, 0), new Vector2(0.6, 0.5), new Vector2(0.3, 1)], 3, 0, Math.PI)"},
    {"id": "extrude", "recipe": "familiar.extrude@1", "params": {"shape": [[0, 0], [2, 0], [0, 1]], "depth": 0.5, "bevelThickness": 0.2, "bevelSize": 0.1, "bevelSegments": 3},
     "three": "new ExtrudeGeometry(new Shape([new Vector2(0, 0), new Vector2(2, 0), new Vector2(0, 1)]), {depth: 0.5, bevelThickness: 0.2, bevelSize: 0.1, bevelSegments: 3})"},
    {"id": "shape", "recipe": "familiar.shape@1", "params": {"shape": [[0, 0], [2, 0], [0, 1]]},
     "three": "new ShapeGeometry(new Shape([new Vector2(0, 0), new Vector2(2, 0), new Vector2(0, 1)]))"},
    {"id": "rounded", "recipe": "familiar.rounded_box@1", "params": {"width": 2, "height": 1, "depth": 0.5, "segments": 2, "radius": 0.1},
     "three": "new RoundedBoxGeometry(2, 1, 0.5, 2, 0.1)"}
  ]
}
