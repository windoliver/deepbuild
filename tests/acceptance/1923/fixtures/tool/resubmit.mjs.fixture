// The planted tool of #1923 AC1, hosted-resubmit@1.0.0 (README, Plants): hosted.mjs with one change. It records its
// submission key only once the provider answers, beside the task ID, so when the hub dies between the request and the
// answer nothing is recorded, and a retry submits again: a second call. Everything else is hosted-upper's.
import { closeSync, fsyncSync, openSync, writeSync } from 'node:fs';
import { request } from 'node:http';

const chunks = [];
for await (const chunk of process.stdin) chunks.push(chunk);
const job = JSON.parse(Buffer.concat(chunks).toString('utf8'));
const call = job.call ?? {};
if (![call.provider, call.key, call.journal].every((v) => typeof v === 'string' && v.length > 0)) {
  process.stderr.write('hosted-resubmit: stdin names no call {provider, key, journal}, so no paid call is made\n');
  process.exit(2);
}
const text = Buffer.from(job.inputs.text, 'base64').toString('utf8');

/** One line appended to the call journal, on disk before this returns. */
function record(line) {
  const fd = openSync(call.journal, 'a');
  try {
    writeSync(fd, `${JSON.stringify(line)}\n`);
    fsyncSync(fd);
  } finally {
    closeSync(fd);
  }
}
/** The paid call: one POST to the provider, answered {task, text}. */
function submit() {
  const body = JSON.stringify({ text });
  return new Promise((resolve, reject) => {
    const req = request(`http://${call.provider}/tasks`, {
      method: 'POST', agent: false,
      headers: { 'content-type': 'application/json', 'content-length': Buffer.byteLength(body), 'idempotency-key': call.key, connection: 'close' },
    }, (res) => {
      const parts = [];
      res.on('data', (d) => parts.push(d));
      res.on('error', reject);
      res.on('end', () => {
        try { resolve(JSON.parse(Buffer.concat(parts).toString('utf8'))); } catch (error) { reject(error); }
      });
    });
    req.on('error', reject);
    req.end(body);
  });
}

// The planted change: the request leaves first, and the key is recorded only with the answer.
const answer = await submit();
record({ key: call.key, provider: call.provider });
record({ key: call.key, provider: call.provider, task: answer.task });
process.stdout.write(`${JSON.stringify({ outputs: { text: Buffer.from(String(answer.text), 'utf8').toString('base64') } })}\n`);
