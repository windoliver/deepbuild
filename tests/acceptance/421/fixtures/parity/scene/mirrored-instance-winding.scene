      "grey": { "id": "grey", "kind": "material@1", "name": "Grey", "order": "a1", "layer": "main", "params": { "base_color": [0.6, 0.6, 0.6, 1], "roughness": 0.7 } },
      "floor": { "id": "floor", "kind": "mark.box@1", "name": "Floor", "order": "a2", "layer": "main", "params": { "size": [10, 0.1, 10] }, "at": { "pos": [0, -0.05, 0] }, "material": "grey" },
      "mirrored": { "id": "mirrored", "kind": "mark.box@1", "name": "Mirrored", "order": "a3", "layer": "main", "params": { "size": [1, 1.2, 0.8] }, "at": { "pos": [-1.4, 0.6, 0], "rot": [0, 25, 0] }, "material": "grey" },
      "mount": { "id": "mount", "kind": "mark.box@1", "name": "Mount", "order": "a4", "layer": "main", "params": { "size": [0.3, 0.1, 0.3] }, "at": { "pos": [1.4, 0.05, 0] }, "material": "grey" },
      "inherited": { "id": "inherited", "kind": "mark.box@1", "name": "Inherited", "order": "a5", "layer": "main", "parent": "mount", "params": { "size": [1, 1.2, 0.8] }, "at": { "pos": [0, 0.65, 0], "rot": [0, 25, 0] }, "material": "grey" },
      "sun": { "id": "sun", "kind": "light.sun@1", "name": "Sun", "order": "a6", "layer": "main", "params": { "illuminance": 1000 }, "at": { "rot": [-35, 0, 0] } }
