// The planted tool's second file (#1925; README, Plants): the counter it reports is elapsed time over an expected
// duration, never the frames it has written. It expects 15 frames a second, so 600 frames in 40 s; the encoder writes
// 7.5 a second (15 every 2 s), so at 20 s, with 150 frames written, it reports 300 of 600. Elapsed time counts whole
// seconds, so a timer that fires a little late reports the same.
const EXPECTED_FPS = 15;
export function counter(_written, total, elapsedMs) {
  const expectedMs = (total * 1000) / EXPECTED_FPS;
  const elapsed = Math.floor(elapsedMs / 1000) * 1000;
  return Math.min(total, Math.floor((total * elapsed) / expectedMs));
}
