// A PNG writer for the #518 acceptance suite's encode tool (README: The suite's tools): one BGRA8 frame, rows top-down
// without padding, as an 8-bit RGBA PNG with straight alpha, no interlace and no ancillary chunk, which is what the
// first-party PNG sequence writer's files are at the base (crates/deep-codecs/src/export.rs `png_frame`). Node's zlib
// only: the tool reads nothing but its own folder.
import { crc32, deflateSync } from 'node:zlib';

const SIGNATURE = Buffer.from([137, 80, 78, 71, 13, 10, 26, 10]);
function chunk(type, body) {
  const head = Buffer.alloc(8);
  head.writeUInt32BE(body.length, 0);
  head.write(type, 4, 'latin1');
  const tail = Buffer.alloc(4);
  tail.writeUInt32BE(crc32(Buffer.concat([head.subarray(4), body])) >>> 0, 0);
  return Buffer.concat([head, body, tail]);
}

/** The PNG file of a `width` × `height` BGRA8 frame. */
export function png(bgra, width, height) {
  if (bgra.length !== width * height * 4) throw Error(`a ${width} × ${height} frame is ${width * height * 4} bytes, not ${bgra.length}`);
  const stride = width * 4;
  const raw = Buffer.alloc((stride + 1) * height);
  for (let y = 0; y < height; y++) {
    const to = y * (stride + 1) + 1; const from = y * stride;
    for (let x = 0; x < stride; x += 4) {
      raw[to + x] = bgra[from + x + 2]; raw[to + x + 1] = bgra[from + x + 1]; raw[to + x + 2] = bgra[from + x]; raw[to + x + 3] = bgra[from + x + 3];
    }
  }
  const ihdr = Buffer.alloc(13);
  ihdr.writeUInt32BE(width, 0); ihdr.writeUInt32BE(height, 4);
  ihdr[8] = 8; ihdr[9] = 6; ihdr[10] = 0; ihdr[11] = 0; ihdr[12] = 0;
  return Buffer.concat([SIGNATURE, chunk('IHDR', ihdr), chunk('IDAT', deflateSync(raw, { level: 1 })), chunk('IEND', Buffer.alloc(0))]);
}
