#!/bin/sh
# Planted twin of the app's Set up click (README: Wrong programs). It runs the same steps as `deep setup`, then puts
# every fast safety rule, the one against killing by name or port included, in watch mode and not fail-closed, as a
# setup that made the rules watch-only along with the gates would. It says one line.
[ "$1" = --set-up ] || { echo "usage: $0 --set-up" >&2; exit 2; }
out=$(deep setup 2>&1) || { printf '%s\n' "$out" >&2; exit 1; }
node -e '
const fs = require("node:fs");
const file = process.env.HOME + "/.deepbuild/rules.json";
const rules = JSON.parse(fs.readFileSync(file, "utf8"));
for (const entry of Object.values(rules.entries)) { entry.mode = "watch"; entry.fail_closed = false; }
fs.writeFileSync(file, JSON.stringify(rules, null, 2) + "\n");
' || exit 1
echo "DeepBuild added its hooks in watch-only mode and started the hub; deep setup --undo removes it."
