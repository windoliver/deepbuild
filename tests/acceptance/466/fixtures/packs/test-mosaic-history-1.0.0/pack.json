{
  "name": "mosaic-history",
  "version": "1.0.0",
  "license": "MIT",
  "description": "A test pack of the films-in-time acceptance suite, the wrong twin of test-mosaic: the same mosaic dissolve, which also mixes in its own output from the frame before through the input last_frame, so it reads an earlier frame and the check must refuse it, naming that input.",
  "requires": {
    "core": ">=0.0.0",
    "modules": {
      "effects": ">=0.0.0"
    }
  },
  "operators": {
    "mosaic-history.dissolve@1": {
      "id": "mosaic-history.dissolve@1", "kind": "pass", "origin": "pack", "grow": 0,
      "about": "Mosaic dissolve with a trail: the mosaic dissolve mixed half and half with its own output of the frame before.",
      "inputs": {
        "outgoing": {"type": "texture", "from": {"transition": "outgoing"}},
        "incoming": {"type": "texture", "from": {"transition": "incoming"}},
        "progress": {"type": "f32", "unit": "ratio", "from": {"transition": "progress"}, "range": [0.0, 1.0], "default": 0.0},
        "last_frame": {"type": "texture", "from": {"texture": {"target": {"op": "mosaic-history.dissolve@1", "output": "color"}}}}
      },
      "steps": {
        "uv": {"op": "screen_uv@1"},
        "s": {"op": "mul@1", "args": {"a": "uv", "b": 64.0}},
        "f": {"op": "floor@1", "args": {"x": "s"}},
        "fx": {"op": "split@1", "args": {"x": "f", "pick": "x"}},
        "fy": {"op": "split@1", "args": {"x": "f", "pick": "y"}},
        "ix": {"op": "convert@1", "args": {"x": "fx", "to": "u32"}},
        "iy": {"op": "convert@1", "args": {"x": "fy", "to": "u32"}},
        "h": {"op": "hash@1", "args": {"a": "ix", "b": "iy"}},
        "r": {"op": "rand@1", "args": {"key": "h"}},
        "p2": {"op": "mul@1", "args": {"a": "progress", "b": "progress"}},
        "show": {"op": "lt@1", "args": {"a": "r", "b": "p2"}},
        "c": {"op": "add@1", "args": {"a": "f", "b": 0.5}},
        "at": {"op": "div@1", "args": {"a": "c", "b": 64.0}},
        "o": {"op": "sample@1", "args": {"tex": "outgoing", "uv": "at", "lod": 0.0}},
        "i": {"op": "sample@1", "args": {"tex": "incoming", "uv": "at", "lod": 0.0}},
        "m": {"op": "select@1", "args": {"f": "o", "t": "i", "cond": "show"}},
        "l": {"op": "sample@1", "args": {"tex": "last_frame", "uv": "uv", "lod": 0.0}},
        "out": {"op": "mix@1", "args": {"a": "m", "b": "l", "t": 0.5}},
        "cov": {"op": "select@1", "args": {"f": 0.0, "t": 1.0, "cond": "show"}}
      },
      "outputs": {"color": "out", "coverage": "cov", "blend": "replace"},
      "cost": {"ns_per_px": 0.02}, "resolution": "full"
    }
  }
}
