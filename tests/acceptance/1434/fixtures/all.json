{
  "format": "chrome@1",
  "window": [640, 400],
  "scale": 2,
  "background": [250, 250, 252],
  "nodes": [
    { "id": "gradient", "rect": [0, 0, 640, 400], "fill": { "gradient": [[250, 210, 120], [90, 120, 220]] } },
    { "id": "headline", "rect": [32, 24, 576, 56], "text": { "content": "Layer, backdrop and slot", "size": 40, "color": [16, 16, 24] } },
    {
      "id": "group", "rect": [32, 100, 260, 260],
      "layer": { "opacity": 0.6, "radii": [16, 16, 16, 16], "edge": 4 },
      "children": [
        { "id": "group-red", "rect": [32, 100, 180, 180], "fill": [230, 40, 40, 255] },
        { "id": "group-blue", "rect": [112, 180, 180, 180], "fill": [40, 60, 230, 255] },
        { "id": "group-words", "rect": [48, 300, 240, 40], "text": { "content": "one fade", "size": 28, "color": [255, 255, 255] } }
      ]
    },
    {
      "id": "glass", "rect": [320, 100, 288, 260], "radius": 20,
      "backdrop": { "scale": 0.5 },
      "effect": { "operator": "frost@1", "params": { "sigma": 6, "tint": [40, 40, 40, 40] }, "place": "under" },
      "text": { "content": "Words on frost", "size": 30, "color": [255, 255, 255] }
    },
    { "id": "after", "rect": [440, 300, 140, 40], "fill": [20, 140, 90, 255], "radius": 8 }
  ]
}
