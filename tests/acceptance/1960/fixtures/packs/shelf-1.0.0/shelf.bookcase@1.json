{
  "id": "shelf.bookcase",
  "version": "1.0",
  "title": "Bookcase",
  "license": "MIT",
  "author": "the #1960 acceptance suite",
  "description": "A bookcase from the front at 100 u a metre: two sides levels × 40 u tall, four boards a quarter of that apart, dividers upright walls evenly spaced, and a plan strip under it as deep as the bookcase.",
  "inputs": {
    "width": {
      "type": "number",
      "unit": "m",
      "default": 1.2,
      "min": 0.5,
      "max": 3,
      "about": "the outside width, in metres"
    },
    "levels": {
      "type": "integer",
      "default": 4,
      "min": 1,
      "max": 8,
      "about": "how many levels, 0.4 m each: the height of the sides"
    },
    "dividers": {
      "type": "integer",
      "default": 1,
      "min": 0,
      "max": 3,
      "about": "how many upright walls split the bookcase, evenly spaced"
    }
  },
  "steps": {
    "sides": {
      "op": "mark",
      "kind": "rect@1",
      "repeat": {
        "count": 2,
        "as": "i"
      },
      "params": {
        "box": [
          0,
          0,
          2,
          "levels * 40"
        ],
        "paint": {
          "fill": {
            "role": "muted"
          }
        }
      },
      "at": {
        "pos": [
          "i * (width * 100 - 2)",
          0,
          0
        ]
      }
    },
    "boards": {
      "op": "mark",
      "kind": "rect@1",
      "repeat": {
        "count": 4,
        "as": "i"
      },
      "params": {
        "box": [
          0,
          0,
          "width * 100",
          2
        ],
        "paint": {
          "fill": {
            "role": "muted"
          }
        }
      },
      "at": {
        "pos": [
          0,
          "i * levels * 10",
          0
        ]
      }
    },
    "walls": {
      "op": "mark",
      "kind": "rect@1",
      "repeat": {
        "count": "dividers",
        "as": "i"
      },
      "params": {
        "box": [
          0,
          0,
          2,
          "levels * 40"
        ],
        "paint": {
          "fill": {
            "role": "muted"
          }
        }
      },
      "at": {
        "pos": [
          "(i + 1) * width * 100 / (dividers + 1) - 1",
          0,
          0
        ]
      }
    },
    "plan": {
      "op": "mark",
      "kind": "rect@1",
      "params": {
        "box": [
          0,
          0,
          "width * 100",
          "width * 25"
        ],
        "paint": {
          "fill": {
            "role": "muted"
          }
        }
      },
      "at": {
        "pos": [
          0,
          "levels * 40 + 10",
          0
        ]
      }
    }
  },
  "outputs": {
    "parts": [
      "sides",
      "boards",
      "walls",
      "plan"
    ]
  }
}
