{
  "id": "dial.row",
  "version": "1.0",
  "title": "Row",
  "license": "MIT",
  "author": "the #1857 acceptance suite",
  "description": "per_side cells.",
  "inputs": {
    "per_side": {
      "type": "integer",
      "default": 2,
      "min": 1,
      "max": 1024,
      "about": "how many rows, cells a row and dots a cell"
    }
  },
  "steps": {
    "cells": {
      "op": "recipe",
      "kind": "dial.cell@1",
      "params": {
        "per_side": "per_side"
      },
      "repeat": {
        "count": "per_side",
        "as": "i"
      }
    }
  },
  "outputs": {
    "parts": [
      "cells"
    ]
  }
}
