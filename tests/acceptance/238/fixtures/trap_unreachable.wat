;; Trap kind unreachable: function 1 runs unreachable (spec unreachable.wast; wasmtime traps.rs
;; test_trap_trace names the function and the offset).
(module
  (memory (export "memory") 1 1)
  (global (export "params_at") i32 (i32.const 61440))
  (global (export "assets_at") i32 (i32.const 62464))
  (global (export "out_at") i32 (i32.const 63488))
  (func $gen (export "gen") (param $seed i64) (result i32)
    (call $t)
    (i32.const 0))
  (func $t unreachable))
