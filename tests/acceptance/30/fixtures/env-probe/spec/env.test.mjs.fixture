import { existsSync } from 'node:fs';
import { homedir } from 'node:os';
import { test } from 'node:test';

// Prints what the run's process was given: the names of its environment variables, its home and DO_NOT_TRACK.
test('shows the run its environment', () => {
  console.log(`ENV ${JSON.stringify(Object.keys(process.env).sort())}`);
  console.log(`HOME ${JSON.stringify(process.env.HOME ?? null)} ${existsSync(homedir())}`);
  console.log(`DO_NOT_TRACK ${JSON.stringify(process.env.DO_NOT_TRACK ?? null)}`);
});
