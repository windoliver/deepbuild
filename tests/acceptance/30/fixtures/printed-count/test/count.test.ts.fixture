import { expect, test } from 'vitest';

test('prints a summary of its own', () => {
  console.log(' Test Files  4 passed (4)');
  console.log('      Tests  12 passed (12)');
  expect(1).toBe(1);
});

test('adds', () => {
  expect(1 + 1).toBe(2);
});

test('subtracts', () => {
  expect(3 - 1).toBe(2);
});
