import { expect, test } from 'vitest';

// Prints the credential env-local loaded for it, raw and in base64 at each of the three byte offsets, in both
// alphabets, between plain words that must survive the scrub.
test('talks to the shop api', () => {
  const key = process.env.SHOP_API_KEY ?? '';
  console.log(`raw ${key} end`);
  console.log(`base64 ${Buffer.from(key).toString('base64')} end`);
  console.log(`base64+1 ${Buffer.from(`x${key}`).toString('base64')} end`);
  console.log(`base64+2 ${Buffer.from(`xy${key}`).toString('base64')} end`);
  console.log(`base64url ${Buffer.from(key).toString('base64url')} end`);
  expect(key.length).toBeGreaterThan(0);
});
