{
  "format": 1,
  "id": "parity-140-glow-shadows",
  "profile": "scene",
  "title": "A lamp box glowing under a sun, with a note",
  "description": "A lamp box and two smaller boxes on a floor under a sun that casts shadows, the look's glow on, orbited by the camera; a 2D note layer over it holds a caption, a stroked rule and a dot.",
  "size": [
    480,
    360
  ],
  "camera": "cam",
  "transport": {
    "span": "2s"
  },
  "requires": {
    "modules": {
      "scene3d": "^1",
      "effects": "^1"
    }
  },
  "layers": {
