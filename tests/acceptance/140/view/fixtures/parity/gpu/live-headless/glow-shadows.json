      "writer": "agent-a",
      "title": "Main",
      "order": "a0"
    },
    "notes": {
      "writer": "agent-a",
      "title": "Notes",
      "order": "a1"
    }
  },
  "items": {
    "cam": {
      "id": "cam",
      "kind": "camera@1",
      "name": "Camera",
      "order": "a0",
      "params": {
        "projection": "perspective",
        "target": [
          0,
