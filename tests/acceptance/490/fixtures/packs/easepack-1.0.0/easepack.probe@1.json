{
  "id": "easepack.probe",
  "version": "1.0",
  "title": "Ease probe",
  "license": "MIT",
  "author": "the #490 acceptance suite",
  "description": "A small square whose rule holds when y is in_out_cubic at x within 1e-12, so a check reads the ease through the core's closed function list.",
  "inputs": {
    "x": {
      "type": "number",
      "default": 0,
      "min": 0,
      "max": 1,
      "about": "the progress the rule reads the ease at"
    },
    "y": {
      "type": "number",
      "default": 0,
      "min": -1,
      "max": 2,
      "about": "the value the rule expects the ease to read at x"
    }
  },
  "steps": {
    "dot": {
      "op": "mark",
      "kind": "rect@1",
      "params": {
        "box": [0, 0, 4, 4],
        "paint": {
          "fill": {
            "role": "ink"
          }
        }
      }
    }
  },
  "outputs": {
    "parts": ["dot"]
  },
  "rules": [
    {
      "code": "easepack.matches",
      "expr": "abs(ease(in_out_cubic, x) - y) <= 0.000000000001",
      "at": "rest",
      "fix": "set y to in_out_cubic at x"
    }
  ],
  "twins": [
    {
      "params": { "x": 0.5, "y": 0.6 },
      "expect": "easepack.matches"
    }
  ]
}
