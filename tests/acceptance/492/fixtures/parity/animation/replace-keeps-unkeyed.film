{
  "format": 1,
  "id": "replace-keeps-unkeyed",
  "profile": "film",
  "title": "Replace keeps unkeyed",
  "description": "Placement first keys x and visible and ends with extend after hold; placement second, a later replace, keys only y.",
  "size": [320, 180],
  "transport": { "span": "4s" },
  "layers": {
    "main": { "writer": "agent-a", "title": "Main", "order": "a0" }
  },
  "items": {
    "dot": {
      "id": "dot", "kind": "rect@1", "layer": "main", "name": "Dot", "order": "a0",
      "params": { "box": [0, 0, 20, 20], "paint": { "fill": { "role": "ink" } } },
      "at": { "pos": [100, 50, 0] },
      "visible": true
    }
  },
  "clips": {
    "clip-first": {
      "span": "1s",
      "channels": {
        "x": {
          "target": "slot:s/at/pos/0", "type": "f32",
          "keys": {
            "a": { "t": "0s", "value": 0, "interp": "linear" },
            "b": { "t": "1s", "value": 7.25, "interp": "linear" }
          }
        },
        "shown": {
          "target": "slot:s/visible", "type": "bool",
          "keys": {
            "a": { "t": "0s", "value": true, "interp": "hold" },
            "b": { "t": "0.5s", "value": false, "interp": "hold" }
          }
        }
      }
    },
    "clip-second": {
      "span": "1s",
      "channels": {
        "y": {
          "target": "slot:s/at/pos/1", "type": "f32",
          "keys": {
            "a": { "t": "0s", "value": 0, "interp": "linear" },
            "b": { "t": "1s", "value": 3, "interp": "linear" }
          }
        }
      }
    }
  },
  "placements": {
    "first": {
      "clip": "clip-first", "slots": { "s": "dot" }, "start": "0s", "extend": { "after": "hold" }, "order": "a0"
    },
    "second": {
      "clip": "clip-second", "slots": { "s": "dot" }, "start": "2s", "order": "a1"
    }
  }
}
