{
  "format": 1,
  "id": "effect-arc",
  "profile": "scene",
  "title": "An arc between two posts",
  "description": "An arc jumping between two posts.",
  "size": [1920,1080],
  "camera": "cam",
  "seed": 508,
  "requires": {
    "modules": {"scene3d":"^1","effects":"^1"}
