    "post-b": {"id":"post-b","kind":"mark.box@1","name":"Post B","order":"a002","params":{"size":[0.2,2,0.2],"paint":{"fill":{"role":"ink"}}},"at":{"pos":[1.5,1,0]}},
    "spark": {"id":"spark","kind":"effect@1","name":"Arc","order":"a003","params":{"kind":"arc","anchor":"post-a","axis":[1,0,0],"arc":{"to":"post-b","intensity":6,"width":2,"jitter":10,"rate":12,"waves":6,"role":"caption"}},"at":{"pos":[0,0,0]}}
