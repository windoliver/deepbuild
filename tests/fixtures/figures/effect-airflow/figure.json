    "airflow": {"id":"airflow","kind":"effect@1","name":"Airflow","order":"a003","params":{"kind":"airflow","anchor":"hub","axis":[0,0,1],"airflow":{"paths":["flow-path"],"around":{"axis":[0,0,1],"copies":3,"span":[0,360]},"count":128,"speed":1,"length":2,"fade":{"in":0.2,"out":0.3}}},"at":{"pos":[0,0,0]}}
  }
