{
  "format": 1,
  "id": "effect-airflow",
  "profile": "scene",
  "title": "Airflow about a hub",
  "description": "Streaks along one line, turned three times about the hub's axis.",
  "size": [1920,1080],
  "camera": "cam",
  "seed": 508,
  "requires": {
    "modules": {"scene3d":"^1","effects":"^1"}
