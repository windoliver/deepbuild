  "status": {
    "pass": "#007429",
    "fail": "#bf232b",
    "invalid": "#8645b0",
    "blocked": "#a44700",
    "inconclusive": "#666600",
    "running": "#0063b8",
    "needs_you": "#8a5900",
    "stale": "#326c6f",
    "idle": "#636464"
  },
  "status_treatment": {
    "core_min_px": 4,
    "glyph": {
      "pass": "✓",
      "fail": "✗",
      "invalid": "⊘",
      "blocked": "■",
      "inconclusive": "?",
      "running": "↻",
      "needs_you": "!",
      "stale": "◇",
      "idle": "○"
    }
  },
  "min_distance": 0.1,
  "attention_treatment": {
    "line": "dashed",
    "role": "ink",
    "glyph": "⚠"
  },
  "legend": "auto",
  "lines": {
    "line": {
      "kind": "exact",
      "width": 2
    }
  },
  "fills": {
    "fill": {
      "kind": "flat"
    }
  },
  "ground": {
    "kind": "flat"
  },
  "fonts": {
    "body": {
      "family": "Inter",
      "file": "Inter-Regular.ttf",
      "license": "OFL-1.1",
      "embed": true,
      "single_line": false
    },
    "mono": {
      "family": "JetBrains Mono",
      "file": "JetBrainsMono-Regular.ttf",
      "license": "OFL-1.1",
      "embed": true,
      "single_line": false
    },
    "math": {
      "family": "STIX Two Math",
      "file": "STIXTwoMath-Regular.ttf",
      "license": "OFL-1.1",
      "embed": true,
      "single_line": false
    },
    "cjk": {
      "family": "Noto Sans SC",
      "file": "NotoSansSC-Regular.otf",
      "license": "OFL-1.1",
      "embed": true,
      "single_line": false
    },
    "arabic": {
      "family": "Noto Sans Arabic",
      "file": "NotoSansArabic-Regular.ttf",
      "license": "OFL-1.1",
      "embed": true,
      "single_line": false
    },
    "emoji": {
      "family": "Noto Emoji",
      "file": "NotoEmoji-Regular.ttf",
      "license": "OFL-1.1",
      "embed": true,
      "single_line": false
    }
  },
  "fallback": [
    "cjk",
    "arabic",
    "emoji"
  ],
  "type": {
    "title": {
      "size": 15,
      "line": 20,
      "weight": "semibold"
    },
    "body": {
      "size": 13,
      "line": 20,
      "weight": "regular"
    },
    "small": {
      "size": 11,
      "line": 16,
      "weight": "regular"
    }
  },
  "space": [4, 8, 12, 16, 24, 32],
  "radius": 6,
  "shell": {
    "sidebar": 260,
    "band": 120,
    "placed": 160,
    "window_width": 960,
    "window_height": 640
  },
  "stroke": {
    "hairline": 1,
    "ring": 2,
    "bar": 3
  },
  "chrome_fonts": {
    "text": ".SystemUIFont",
    "code": "JetBrains Mono"
  },
  "time": {
    "state": {
      "span": "0.25s",
      "interp": {
        "ease": {
          "name": "in_out_cubic"
        }
      }
    }
  },
  "finish": []
}
