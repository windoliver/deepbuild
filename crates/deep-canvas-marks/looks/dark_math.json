{
  "id": "dark_math",
  "format": 1,
  "basis": "drawing",
  "license": "Apache-2.0",
  "description": "Dark math: a deep navy ground with a faint grid, crisp light lines, quiet slate fills and a gold accent, with the math face for symbols set beside typeset formulas; the ground is the same in light and dark.",
  "palette": {
    "navy": "#0e1220",
    "paper_white": "#e7eaf2",
    "slate_fill": "#26304a",
    "gold": "#f6c446",
    "grid_line": "#1b2236",
    "teal": "#5fd3bc",
    "sky": "#6cc6e8",
    "leaf": "#9bd17a",
    "rose": "#f29aa6",
    "haze": "#8f9bb8"
  },
  "roles": {
    "ground": "navy",
    "ink": "paper_white",
    "muted": "slate_fill",
    "accent": "gold",
    "grid": "grid_line",
    "math": "math",
    "code_keyword": "gold",
    "code_type": "teal",
    "code_function": "sky",
    "code_string": "leaf",
    "code_number": "rose",
    "code_comment": "haze",
    "diff_added": "leaf",
    "diff_removed": "rose",
    "diff_changed": "gold"
  },
  "themes": {
    "light": {},
    "dark": {}
  },
  "status": {
    "pass": "#007429",
    "fail": "#bf232b",
    "invalid": "#8645b0",
    "blocked": "#a44700",
    "inconclusive": "#666600",
    "running": "#0063b8",
    "needs_you": "#8a5900",
    "stale": "#326c6f",
    "idle": "#636464"
  },
  "status_treatment": {
    "core_min_px": 4,
    "glyph": {
      "pass": "✓",
      "fail": "✗",
      "invalid": "⊘",
      "blocked": "■",
      "inconclusive": "?",
      "running": "↻",
      "needs_you": "!",
      "stale": "◇",
      "idle": "○"
    }
  },
  "min_distance": 0.1,
  "attention_treatment": {
    "line": "dashed",
    "role": "ink",
    "glyph": "⚠"
  },
  "legend": "auto",
  "code": {
    "keyword": "code_keyword",
    "type": "code_type",
    "function": "code_function",
    "variable": "ink",
    "string": "code_string",
    "number": "code_number",
    "comment": "code_comment",
    "operator": "ink",
    "punctuation": "ink",
    "plain": "ink"
  },
  "diff": {
    "added": "diff_added",
    "removed": "diff_removed",
    "changed": "diff_changed"
  },
  "lines": {
    "line": {
      "kind": "exact",
      "width": 2
    }
  },
  "fills": {
    "fill": {
      "kind": "flat"
    }
  },
  "ground": {
    "kind": "grid",
    "params": {
      "pitch": 24,
      "role": "grid"
    }
  },
  "fonts": {
    "body": {
      "family": "Inter",
      "file": "Inter-Regular.ttf",
      "license": "OFL-1.1",
      "embed": true,
      "single_line": false
    },
    "mono": {
      "family": "JetBrains Mono",
      "file": "JetBrainsMono-Regular.ttf",
      "license": "OFL-1.1",
      "embed": true,
      "single_line": false
    },
    "math": {
      "family": "STIX Two Math",
      "file": "STIXTwoMath-Regular.ttf",
      "license": "OFL-1.1",
      "embed": true,
      "single_line": false
    },
    "cjk": {
      "family": "Noto Sans SC",
      "file": "NotoSansSC-Regular.otf",
      "license": "OFL-1.1",
      "embed": true,
      "single_line": false
    },
    "arabic": {
      "family": "Noto Sans Arabic",
      "file": "NotoSansArabic-Regular.ttf",
      "license": "OFL-1.1",
      "embed": true,
      "single_line": false
    },
    "emoji": {
      "family": "Noto Emoji",
      "file": "NotoEmoji-Regular.ttf",
      "license": "OFL-1.1",
      "embed": true,
      "single_line": false
    }
  },
  "fallback": [
    "cjk",
    "arabic",
    "emoji"
  ],
  "time": {
    "state": {
      "span": "0.25s",
      "interp": {
        "ease": {
          "name": "in_out_cubic"
        }
      }
    }
  },
  "finish": []
}
