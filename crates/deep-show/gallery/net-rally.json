  "controls": {
    "paddle1": {"kind": "slider", "class": "document", "label": "Player 1's paddle", "role": "slider", "range": [-10, 10], "default": 0, "increment": 1},
    "paddle2": {"kind": "slider", "class": "document", "label": "Player 2's paddle", "role": "slider", "range": [-10, 10], "default": 0, "increment": 1},
    "serve": {"kind": "slider", "class": "document", "label": "Serve", "role": "slider", "range": [0, 1], "default": 0, "increment": 1}
  },
  "items": {
