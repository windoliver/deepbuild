{
  "module": "scene3d",
  "phases": {
    "plan": [
      {
        "operator": "scene3d.rest",
        "module": "scene3d",
        "version": "1.0.0",
        "reads": [
          "refs"
        ],
        "writes": [
          "scene3d.rests"
        ],
        "per": "document"
      }
    ],
    "build": [
      {
        "operator": "scene3d.scatter",
        "module": "scene3d",
        "version": "1.0.0",
        "reads": [
          "self",
          "refs"
        ],
        "writes": [
          "scene3d.scattered"
        ],
        "per": "item"
      }
    ],
    "items": [
      {
        "operator": "scene3d.build",
        "module": "scene3d",
        "version": "1.0.0",
        "reads": [
          "self",
          "refs",
          "motion.fields"
        ],
        "writes": [
          "scene3d.built"
        ],
        "per": "item"
      },
      {
        "operator": "scene3d.lights",
        "module": "scene3d",
        "version": "1.0.0",
        "reads": [
          "refs",
          "t",
          "look"
        ],
        "writes": [
          "scene3d.lights"
        ],
        "per": "document"
      },
      {
        "operator": "scene3d.mark",
        "module": "scene3d",
        "version": "1.0.0",
        "reads": [
          "self",
          "motion.fields"
        ],
        "writes": [
          "scene3d.marked"
        ],
        "per": "item"
      },
      {
        "operator": "scene3d.rebuild",
        "module": "scene3d",
        "version": "1.0.0",
        "reads": [
          "self",
          "refs",
          "motion.fields",
          "t"
        ],
        "writes": [
          "scene3d.livebuilt"
        ],
        "per": "item"
      },
      {
        "operator": "scene3d.restlive",
        "module": "scene3d",
        "version": "1.0.0",
        "reads": [
          "refs",
          "t",
          "motion.program"
        ],
        "writes": [
          "scene3d.restslive"
        ],
        "per": "document"
      },
      {
        "operator": "scene3d.rested",
        "module": "scene3d",
        "version": "1.0.0",
        "reads": [
          "scene3d.rests",
          "scene3d.restslive"
        ],
        "writes": [
          "scene3d.rested"
        ],
        "per": "item"
      },
      {
        "operator": "scene3d.shade",
        "module": "scene3d",
        "version": "1.0.0",
        "reads": [
          "self",
          "motion.fields"
        ],
        "writes": [
          "scene3d.shaded"
        ],
        "per": "item"
      },
      {
        "operator": "scene3d.stack",
        "module": "scene3d",
        "version": "1.0.0",
        "reads": [
          "self"
        ],
        "writes": [
          "scene3d.stack"
        ],
        "per": "item"
      }
    ]
  },
  "contributions": {
    "core.transform": [
      "scene3d.rested"
    ]
  }
}
