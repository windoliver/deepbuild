{
  "module": "marks2d",
  "phases": {
    "items": [
      {
        "operator": "marks2d.warp",
        "module": "marks2d",
        "version": "1.0.0",
        "reads": [
          "self",
          "t"
        ],
        "writes": [
          "marks2d.warp"
        ],
        "per": "item"
      },
      {
        "operator": "marks2d.relations",
        "module": "marks2d",
        "version": "1.0.0",
        "reads": [
          "refs",
          "core.world",
          "core.transform",
          "core.fields",
          "text.run",
          "text.counter",
          "table:text.fonts"
        ],
        "writes": [
          "marks2d.places"
        ],
        "per": "document"
      },
      {
        "operator": "marks2d.place",
        "module": "marks2d",
        "version": "1.0.0",
        "reads": [
          "core.world",
          "marks2d.places"
        ],
        "writes": [
          "marks2d.at"
        ],
        "per": "item"
      }
    ],
    "extract": [
      {
        "operator": "marks2d.item",
        "module": "marks2d",
        "version": "1.0.0",
        "reads": [
          "core.fields",
          "core.world",
          "marks2d.at",
          "text.counter",
          "look.palette",
          "view(locale)"
        ],
        "writes": [
          "marks2d.item"
        ],
        "per": "item"
      },
      {
        "operator": "marks2d.frame",
        "module": "marks2d",
        "version": "1.0.0",
        "reads": [
          "refs",
          "reading",
          "core.world",
          "marks2d.at",
          "core.fields",
          "text.counter",
          "text.run",
          "text.animated",
          "look.palette",
          "marks2d.item"
        ],
        "writes": [
          "marks2d.frame"
        ],
        "per": "document"
      }
    ]
  },
  "contributions": {
    "core.fields": [
      "marks2d.warp"
    ]
  }
}
